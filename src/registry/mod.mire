module registry

load mire::vec
load kioto::strings
load kioto::fs
load kioto::proc
load! /src/util
load! /src/trust
load! /src/cache
load! /src/cfg
load! /src/crypto

/! MOR (Master Official Registry) - preconfigured, non-removable.
   Contents:
     kioto@2.5.0, kioto@3.0.0, kioto@3.1.0
     mire@1.3.0
     sdl@1.3.1
     owl@latest
!/

pub fn home: () :str {
    return use! util::owl_home_registries()
}

pub fn mor_name: () :str { return "mor" }

pub fn mor_url: () :str { return "https://github.com/mire-lang/libs/raw/main/reg" }

/! Helper: concat two strings !/
fn sc: (a :&str, b :&str) :str {
    return strings::concat(a b)
}

/! Helper: concat three strings (as two arguments) !/
fn sc3: (a :&str, b :&str) :str {
    return strings::concat(a b)
}

pub fn sync_all: () {
    use! registry::sync([])
}

/! `owl reg [sync|list|add <name> <url>|remove <name>]`, defaulting to sync. !/
pub fn run: (args :&vec[str]) {
    set sub = "" :str mut
    if vec::len(args) >= 3 { set sub = strings::copy(vec::get::str(args 2)) }
    if sub == "list" { use! registry::list() return }
    if sub == "add" { use! registry::add(args) return }
    if sub == "remove" { use! registry::remove(args) return }
    use! registry::sync(args)
}

pub fn sync: (args :&vec[str]) {
    use! util::mkdir_p(use! util::cfg::home())
    set reg_dir = use! registry::home()
    use! util::mkdir_p(reg_dir)

    /! Ensure MOR exists !/
    set mor_path = sc(sc(strings::copy(reg_dir) "/") use! registry::mor_name())
    if !fs::exists(mor_path) {
        use dasu("  [MOR] initializing Master Official Registry...")
        use! util::mkdir_p(mor_path)
        set proto = "1"
        use fs::write(sc(mor_path "/protocol") proto)
        set url = use! registry::mor_url()
        use fs::write(sc(mor_path "/source_url") url)
        set initial_index = "[[packages]]\nname = \"mire\"\nversion = \"2.1.0-beta\"\nmethod = \"clone\"\nrepo = \"mire-lang/mire-lib\"\nref = \"main\"\n\n[[packages]]\nname = \"kioto\"\nversion = \"3.1.0\"\nmethod = \"clone\"\nrepo = \"mire-lang/Kioto\"\nref = \"main\"\n\n[[packages]]\nname = \"sdl\"\nversion = \"1.0.1\"\nmethod = \"clone\"\nrepo = \"mire-lang/SDL\"\nref = \"master\"\n\n[[packages]]\nname = \"sqlite\"\nversion = \"0.1.0\"\nmethod = \"clone\"\nrepo = \"mire-lang/sqlite\"\nref = \"master\"\n\n[[packages]]\nname = \"wasm\"\nversion = \"0.2.0\"\nmethod = \"clone\"\nrepo = \"mire-lang/wasm\"\nref = \"main\"\n\n[[packages]]\nname = \"ilogical\"\nversion = \"0.1.0\"\nmethod = \"clone\"\nrepo = \"mire-lang/ilogical\"\nref = \"v0.1.0\"\n"
        use fs::write(sc(mor_path "/index.toml") initial_index)
        use dasu("  [MOR] initialized with base packages")
    }

    /! Sync each configured registry !/
    set entries_str = use! util::list_text(use! registry::home())
    set entries = strings::split(entries_str "\n")
    set i = 0 :i64 mut
    while i < vec::len(entries) {
        set name = use! util::trim(entries at i)
            if len(name) > 0 {
            use! registry::sync_one(name)
        }
        set i += 1
    }
}

pub fn sync_one: (name :&str) {
    set home = use! registry::home()
    set reg_dir = sc(sc(strings::copy(home) "/") name)
    if !fs::exists(reg_dir) { return }

    set url = use! util::trim_value(fs::read(sc(reg_dir "/source_url")))
    if len(url) == 0 { return }

    set tmp = use! crypto::tempdir("owl-reg") :str mut
    set content = "" :str mut
    set used_url = "" :str mut

    set attempt = 0 :i64 mut
    while attempt < 4 {
        set try_url = "" :str mut
        if attempt == 0 { set try_url = sc(url "/index.toml") }
        if attempt == 1 { set try_url = sc(url "/raw/main/index.toml") }
        if attempt == 2 { set try_url = sc(url "/raw/master/index.toml") }
        if attempt == 3 {
            set try_url = sc(strings::replace::all(url "https://github.com/" "https://api.github.com/repos/") "/contents/index.toml")
        }

        if try_url != "" {
            use! registry::fetch(try_url sc(tmp "/index.toml"))
            set index_content = fs::read(sc(tmp "/index.toml"))
            set test_content = use! util::trim_value(index_content)
            if test_content != "" {
                set content = test_content
                set used_url = try_url
                use dasu(sc(sc(sc("  [OK]    fetched " name) " from ") used_url))
            }
        }

        if content != "" { break }
        set attempt += 1
    }

    if content == "" {
        use dasu(sc(sc("  [WARN]  could not sync " name) " (offline?)"))
        return
    }

    /! Verify the detached signature before the index may replace the stored
       one. Registries without a published signature (or without the raw key)
       are accepted with a warning so an offline/local registry still works. !/
    set sig_url = sc(url "/index.toml.sig")
    set meta_url = sc(url "/registry.json")
    use! registry::fetch(sig_url sc(tmp "/index.toml.sig"))
    use! registry::fetch(meta_url sc(tmp "/registry.json"))

    set have_sig = fs::exists(sc(tmp "/index.toml.sig"))
    set have_meta = fs::exists(sc(tmp "/registry.json"))
    set raw_key = "" :str mut
    if have_meta { set raw_key = use! registry::json_field(sc(tmp "/registry.json") "public-key-raw") }

    if have_sig && raw_key != "" {
        if !use! crypto::verify::sigfile(raw_key sc(tmp "/index.toml") sc(tmp "/index.toml.sig")) {
            use dasu(sc(sc("  [FAIL]  " name) " index.toml signature is invalid; keeping the previous index"))
            return
        }
        use dasu(sc(sc("  [OK]    " name) " index.toml signature verified"))
    } else {
        use dasu(sc(sc("  [WARN]  " name) " index.toml is unsigned (no signature or public key)"))
    }

    use fs::write(sc(reg_dir "/index.toml") content)
    set msg1 = sc("  [OK]    " name) :str mut
    set msg2 = sc(msg1 " synced (") :str mut
    set msg3 = sc(msg2 used_url) :str mut
    set msg4 = sc(msg3 ")") :str mut
    use dasu(msg4)
    use! util::rm_RF(tmp)
}

/! curl a URL into a file, silently failing. Returns true when a non-empty
   file was written. !/
pub fn fetch: (url :&str, out :&str) :bool {
    use! util::rm_RF(out)
    set curl_args = [] :vec[str] mut
    set curl_args = vec::push::str(curl_args "-sL")
    set curl_args = vec::push::str(curl_args "--fail")
    set curl_args = vec::push::str(curl_args "-H")
    set curl_args = vec::push::str(curl_args "Accept: application/vnd.github.raw")
    set curl_args = vec::push::str(curl_args "-o")
    set curl_args = vec::push::str(curl_args strings::copy(out))
    set curl_args = vec::push::str(curl_args strings::copy(url))
    use proc::run::output("curl" curl_args)
    if !fs::exists(out) { return false }
    return use! util::file_size(out) > 0
}

/! Read a quoted scalar field from a flat JSON document (one key per line is
   enough for registry.json, and avoids adding a JSON parser here). !/
pub fn json_field: (path :&str, key :&str) :str {
    set text = fs::read(path)
    set lines = strings::split(text "\n")
    set n = vec::len(lines)
    set needle = strings::concat(strings::concat("\"" key) "\"")
    set i = 0 :i64 mut
    while i < n {
        set line = use! util::trim(use! util::list_get(lines i))
        if use! util::startswith(line needle) {
            set colon = strings::index(line ":")
            if colon >= 0 {
                set rest = use! util::trim(strings::substr(line colon + 1 9999))
                if use! util::startswith(rest "\"") && strings::len(rest) >= 2 {
                    set body = strings::substr(rest 1 strings::len(rest) - 1)
                    set close = strings::index(body "\"")
                    if close >= 0 { return strings::substr(body 0 close) }
                }
            }
        }
        set i += 1
    }
    return ""
}

pub fn list: () {
    set reg_dir = use! registry::home()
    set entries_str = use! util::list_text(reg_dir)
    set entries = strings::split(entries_str "\n")
    if vec::len(entries) == 0 {
        use dasu("  no registries configured")
        return
    }
    use dasu("  configured registries:")
    set i = 0 :i64 mut
    while i < vec::len(entries) {
        set name = use! util::trim(entries at i)
        if len(name) > 0 {
            set is_mor = name == use! registry::mor_name()
            set mark = "" :str mut
            if is_mor { set mark = " (MOR, built-in)" }
            use dasu(sc("  " name) mark)
        }
        set i += 1
    }
}

pub fn add: (args :&vec[str]) {
    if vec::len(args) < 3 {
        use dasu("Usage: owl reg add <name> <url>")
        return
    }
    set name = vec::get::str(args 2)
    set url = vec::get::str(args 3)

    if name == use! registry::mor_name() {
        use dasu(sc(sc("  [FAIL]  '" use! registry::mor_name()) "' is reserved for the built-in MOR"))
        return
    }

    set home = use! registry::home()
    set reg_dir = sc(sc(strings::copy(home) "/") name)
    if fs::exists(reg_dir) {
        use dasu(sc(sc("  [FAIL]  registry '" name) "' already exists"))
        return
    }

    use! util::mkdir_p(reg_dir)
    use fs::write(sc(reg_dir "/protocol") "1")
    use fs::write(sc(reg_dir "/source_url") url)

    use! registry::sync_one(name)
    use dasu(sc(sc("  [OK]    registry '" name) "' added and synced"))
}

pub fn remove: (args :&vec[str]) {
    if vec::len(args) < 3 {
        use dasu("Usage: owl reg remove <name>")
        return
    }
    set name = vec::get::str(args 2)

    if name == use! registry::mor_name() {
        use dasu("  [FAIL]  cannot remove MOR (built-in, non-removable)")
        return
    }

    set home = use! registry::home()
    set reg_dir = sc(sc(strings::copy(home) "/") name)
    if !fs::exists(reg_dir) {
        use dasu(sc(sc("  [FAIL]  registry '" name) "' does not exist"))
        return
    }

    set rm_args = [] :vec[str] mut
    set rm_args = vec::push::str(rm_args "-rf")
    set rm_args = vec::push::str(rm_args sc(reg_dir ""))
    use! util::rm_RF(reg_dir)
    use dasu(sc(sc("  [OK]    registry '" name) "' removed"))
}

pub fn find_package: (name :&str version :&str) :str {
    set entries_str = use! util::list_text(use! registry::home())
    set entries = strings::split(entries_str "\n")
    set i = 0 :i64 mut
    while i < vec::len(entries) {
        set reg = use! util::trim(entries at i)
        if len(reg) > 0 {
            set idx = sc(sc(strings::copy(use! registry::home()) "/") reg) "/index.toml"
            if fs::exists(idx) {
                set content = fs::read(idx)
                set search = sc(sc("name = \"" name) "\"")
                if strings::contains(content search) {
                    set ver_search = sc(sc("version = \"" version) "\"")
                    if strings::contains(content ver_search) {
                        return content
                    }
                }
            }
        }
        set i += 1
    }
    return ""
}

pub fn resolve_latest: (name :&str) :str {
    set best = "" :str mut
    set entries_str = use! util::list_text(use! registry::home())
    set entries = strings::split(entries_str "\n")
    set i = 0 :i64 mut
    while i < vec::len(entries) {
        set reg = use! util::trim(entries at i)
        if len(reg) > 0 {
            set idx = sc(sc(strings::copy(use! registry::home()) "/") reg) "/index.toml"
            if fs::exists(idx) {
                set content = fs::read(idx)
                set lines = use! semver::count_lines(content)
                set in_pkg = false :bool mut
                set cur_name = "" :str mut
                set cur_ver = "" :str mut
                set j = 0 :i64 mut
                while j < lines {
                    set line = use! util::trim(use! semver::nth_line(content j))
                    if line == "[[packages]]" {
                        if in_pkg && len(cur_name) > 0 && cur_name == name {
                            if (use! semver::compare_versions(cur_ver best) > 0) { set best = cur_ver :str mut }
                        }
                        set in_pkg = true
                        set cur_name = ""
                        set cur_ver = ""
                    } else {
                        if in_pkg {
                            if use! util::startswith(line "name =") { set cur_name = use! semver::extract_str_val(line) }
                            if use! util::startswith(line "version =") { set cur_ver = use! semver::extract_str_val(line) }
                        }
                    }
                    set j += 1
                }
                if in_pkg && len(cur_name) > 0 && cur_name == name {
                    if (use! semver::compare_versions(cur_ver best) > 0) { set best = cur_ver :str mut }
                }
            }
        }
        set i += 1
    }
    return best
}
