load! /code/util
load! /code/deps
load! /code/lockfile

/! Regenerate owl.toml with defaults for specified fields !/
pub fn regenerate_owl_toml: (fields :str) {
    if !use! util::has_project() {
        use dasu("No owl.toml found in the current directory")
    } else {
        set n = use! util::toml_get("owl.toml" "project" "name") :str mut
        if n == "" && use! util::contains(fields "name") { set n = "myproject" }
        set v = use! util::toml_get("owl.toml" "project" "version") :str mut
        if v == "" && use! util::contains(fields "version") { set v = "0.1.0" }
        set d = use! util::toml_get("owl.toml" "project" "description") :str mut
        if d == "" && use! util::contains(fields "description") { set d = "" }
        set e = use! util::toml_get("owl.toml" "project" "entry") :str mut
        if e == "" && use! util::contains(fields "entry") { set e = "code/main.mire" }
        set comp = use! util::toml_get("owl.toml" "build" "compiler") :str mut
        if comp == "" && use! util::contains(fields "compiler") { set comp = "mire" }
        set p = use! util::toml_get("owl.toml" "build" "profile") :str mut
        if p == "" && use! util::contains(fields "profile") { set p = "debug" }
        set o = use! util::toml_get("owl.toml" "build" "opt-level") :str mut
        if o == "" && use! util::contains(fields "opt-level") { set o = "0" }
        set src = use! util::toml_get("owl.toml" "paths" "sources") :str mut
        if src == "" && use! util::contains(fields "sources") { set src = "code" }
        set t = use! util::toml_get("owl.toml" "paths" "tests") :str mut
        if t == "" && use! util::contains(fields "tests") { set t = "tests" }
        set out = use! util::toml_get("owl.toml" "paths" "output") :str mut
        if out == "" && use! util::contains(fields "output") { set out = "bin" }
        set cache = use! util::toml_get("owl.toml" "paths" "cache") :str mut
        if cache == "" && use! util::contains(fields "cache") { set cache = "bin/.cache" }

        use fs::write("owl.toml" "[project]\nname = \"" + n + "\"\nversion = \"" + v + "\"\ndescription = \"" + d + "\"\nentry = \"" + e + "\"\n\n[build]\ncompiler = \"" + comp + "\"\nprofile = \"" + p + "\"\nopt-level = " + o + "\n\n[paths]\nsources = \"" + src + "\"\ntests = \"" + t + "\"\noutput = \"" + out + "\"\ncache = \"" + cache + "\"\n\n[dependencies]\n")
        use dasu("  [FIX]  owl.toml: regenerated with defaults for: " + fields)
    }
}

/! Print checkup help !/
pub fn cmd_checkup_help: () {
    use dasu("Usage: owl checkup [--fix <field> ...] [--cache] [--deps] [--loads]")
    use dasu("")
    use dasu("Run project diagnostics and repair.")
    use dasu("")
    use dasu("Diagnostic flags:")
    use dasu("  --cache        validate build cache integrity")
    use dasu("  --deps         validate dependencies can be loaded")
    use dasu("  --loads        validate load statements resolve")
    use dasu("  -h, --help     show this help")
    use dasu("")
    use dasu("Repair flags:")
    use dasu("  --fix <field>  repair project fields:")
    use dasu("                 name, version, description, entry, profile,")
    use dasu("                 opt-level, compiler, output, cache, sources, tests,")
    use dasu("                 loads, deps")
    use dasu("")
    use dasu("Without diagnostic flags, runs all checks.")
    use dasu("")
    use dasu("Examples:")
    use dasu("  owl checkup                    full project diagnostic")
    use dasu("  owl checkup --cache            check cache only")
    use dasu("  owl checkup --deps             check dependencies only")
    use dasu("  owl checkup --fix loads        scan sources and inject missing deps")
    use dasu("  owl checkup --fix deps         resolve missing dependency paths")
    use dasu("  owl checkup --fix cache        clean build cache")
}

/! Main checkup command !/
pub fn cmd_checkup: (args :&vec[str]) {
    set n = rt_vec_len(args)

    set i = 1 :i64 mut
    while i < n {
        set a = rt_vec_get_str(args i)
        if a == "--help" || a == "-h" {
            use! check::cmd_checkup_help()
            return
        }
        set i += 1
    }

    set do_fix = false :bool mut
    set fix_fields = "" :str mut
    set check_cache = false :bool mut
    set check_deps = false :bool mut
    set check_loads = false :bool mut
    set check_all = true :bool mut

    set i = 2 :i64 mut
    while i < n {
        set a = rt_vec_get_str(args i)
        if a == "--fix" {
            set do_fix = true
        } else {
            if a == "--cache" {
                set check_cache = true
                set check_all = false
            } else {
                if a == "--deps" {
                    set check_deps = true
                    set check_all = false
                } else {
                    if a == "--loads" {
                        set check_loads = true
                        set check_all = false
                    } else {
                        if do_fix {
                            if fix_fields == "" {
                                set fix_fields = a
                            } else {
                                set fix_fields = fix_fields + " " + a
                            }
                        }
                    }
                }
            }
        }
        set i += 1
    }

    if do_fix && fix_fields == "" {
        use dasu("")
        use dasu("  [HINT] usage: owl checkup --fix <field> [<field> ...]")
        use dasu("         fields: name, version, description, entry, profile,")
        use dasu("                 opt-level, compiler, output, cache, sources, tests,")
        use dasu("                 loads, deps")
        use dasu("         example: owl checkup --fix name version entry profile")
        set do_fix = false
    }

    if check_all {
        set check_cache = true
        set check_deps = true
        set check_loads = true
    }

    set all_ok = true :bool mut

    use dasu("")
    if !use! check::checkup_compiler() { set all_ok = false }

    if use! util::has_project() {
        use dasu("")
        if !use! check::checkup_toml() { set all_ok = false }

        if check_deps {
            use dasu("")
            if !use! check::checkup_deps() { set all_ok = false }
        }

        if check_loads {
            use dasu("")
            if !use! check::checkup_loads() { set all_ok = false }
        }

        if check_deps {
            use dasu("")
            if !use! lockfile::lockfile_validate() { set all_ok = false }
        }

        if check_cache {
            use dasu("")
            if !use! check::checkup_cache() { set all_ok = false }
        }

        if do_fix {
            use dasu("")
            if use! util::contains(fix_fields "loads") {
                use! check::fix_loads()
            } else {
                if use! util::contains(fix_fields "deps") {
                    use! check::checkup_fix_deps()
                } else {
                    if use! util::contains(fix_fields "cache") {
                        use! check::checkup_fix_cache()
                    } else {
                        use! check::regenerate_owl_toml(fix_fields)
                    }
                }
            }
        }
    } else {
        use dasu("")
        use dasu("  [FAIL] project: no owl.toml found")
        set all_ok = false
    }

    use dasu("")
    if all_ok {
        use dasu("  [OK]   all checks passed")
    } else {
        if !do_fix {
            use dasu("  [HINT] run 'owl checkup --fix <field>' to repair")
            use dasu("         see 'owl checkup --help' for available options")
        }
    }
}

/! Check compiler installation !/
fn checkup_compiler: () :bool {
    set ok = true :bool mut
    set compiler_out = use! util::trim(proc::run::output("mire" ["--version"]))
    if compiler_out == "" {
        use dasu("  [FAIL] compiler: mire not found")
        use dasu("         install mire (Avenys) to compile projects")
        set ok = false
    } else {
        set lines = use! util::split(compiler_out "\n")
        set first = use! util::list_get(lines 0)
        use dasu("  [OK]   compiler: " + first)
    }
    return ok
}

/! Validate owl.toml fields !/
fn checkup_toml: () :bool {
    set ok = true :bool mut

    set name = use! util::toml_get("owl.toml" "project" "name")
    if name == "" {
        use dasu("  [FAIL] [project].name: missing")
        set ok = false
    } else {
        use dasu("  [OK]   [project].name: " + name)
    }

    set ver = use! util::toml_get("owl.toml" "project" "version")
    if ver == "" {
        use dasu("  [FAIL] [project].version: missing")
        set ok = false
    } else {
        use dasu("  [OK]   [project].version: " + ver)
    }

    set desc = use! util::toml_get("owl.toml" "project" "description")
    if desc == "" {
        use dasu("  [WARN] [project].description: missing")
    } else {
        use dasu("  [OK]   [project].description: " + desc)
    }

    set entry = use! util::toml_get("owl.toml" "project" "entry")
    if entry == "" {
        use dasu("  [FAIL] [project].entry: missing")
        set ok = false
    } else {
        if fs::exists(entry) {
            use dasu("  [OK]   [project].entry: " + entry)
        } else {
            use dasu("  [FAIL] [project].entry: " + entry + " (not found)")
            set ok = false
        }
    }

    set profile = use! util::toml_get("owl.toml" "build" "profile")
    if profile == "" {
        use dasu("  [FAIL] [build].profile: missing")
        set ok = false
    } else {
        use dasu("  [OK]   [build].profile: " + profile)
    }

    set opt = use! util::toml_get("owl.toml" "build" "opt-level")
    if opt == "" {
        use dasu("  [FAIL] [build].opt-level: missing")
        set ok = false
    } else {
        use dasu("  [OK]   [build].opt-level: " + opt)
    }

    set compiler = use! util::toml_get("owl.toml" "build" "compiler")
    if compiler == "" {
        use dasu("  [WARN] [build].compiler: missing (defaults to 'mire')")
    } else {
        use dasu("  [OK]   [build].compiler: " + compiler)
    }

    set out_dir = use! util::toml_get("owl.toml" "paths" "output")
    if out_dir == "" {
        use dasu("  [FAIL] [paths].output: missing")
        set ok = false
    } else {
        use dasu("  [OK]   [paths].output: " + out_dir)
    }

    set cache_dir = use! util::toml_get("owl.toml" "paths" "cache")
    if cache_dir == "" {
        use dasu("  [FAIL] [paths].cache: missing")
        set ok = false
    } else {
        use dasu("  [OK]   [paths].cache: " + cache_dir)
    }

    set sources = use! util::toml_get("owl.toml" "paths" "sources")
    if sources == "" {
        use dasu("  [FAIL] [paths].sources: missing")
        set ok = false
    } else {
        if fs::exists(sources) {
            use dasu("  [OK]   [paths].sources: " + sources)
        } else {
            use dasu("  [WARN] [paths].sources: " + sources + " (not found)")
        }
    }

    set tests = use! util::toml_get("owl.toml" "paths" "tests")
    if tests == "" {
        use dasu("  [FAIL] [paths].tests: missing")
        set ok = false
    } else {
        if fs::exists(tests) {
            use dasu("  [OK]   [paths].tests: " + tests)
        } else {
            use dasu("  [WARN] [paths].tests: " + tests + " (not found)")
        }
    }

    return ok
}

/! Validate dependencies can be loaded !/
fn checkup_deps: () :bool {
    set ok = true :bool mut
    set dep_count = use! deps::count_deps()

    if dep_count == 0 {
        use dasu("  [WARN] deps: no dependencies configured")
        return true
    }

    use dasu("  deps: checking " + use! util::i64_to_string(dep_count) + " packages ...")

    set names = use! deps::get_dep_names()
    set names_len = len(names)
    set pos = 0 :i64 mut
    set checked = 0 :i64 mut
    set loadable = 0 :i64 mut

    while pos < names_len {
        set rem = strings::substr(names pos names_len - pos)
        set nl = strings::index(rem "\n")
        set end = 0 :i64 mut
        if nl < 0 { set end = names_len } else { set end = pos + nl }
        set line = strings::substr(names pos end - pos)
        set pkg = use! util::trim(line)
        set pos = end + 1

        if pkg != "" {
            set checked += 1
            set pkg2 = pkg
            set dep_path = use! deps::get_dep_field(pkg2 "path")
            if dep_path == "" {
                use dasu("  [FAIL] deps/" + pkg + ": no path configured")
                set ok = false
            } else {
                set dp_check = dep_path :str
                set dp_msg = dep_path :str
                set dp_find = dep_path :str
                if !fs::exists(dp_check) {
                    use dasu("  [FAIL] deps/" + pkg + ": path not found (" + dp_msg + ")")
                    set ok = false
                } else {
                    set toml_check = dep_path + "/owl.toml"
                    set toml_msg = toml_check :str
                    set toml_name = toml_check :str
                    set toml_ver = toml_check :str
                    if !fs::exists(toml_check) {
                        use dasu("  [FAIL] deps/" + pkg + ": no owl.toml at " + dp_msg)
                        set ok = false
                    } else {
                        set pkg_name = use! util::toml_get(toml_name "project" "name")
                        if pkg_name == "" {
                            use dasu("  [FAIL] deps/" + pkg + ": owl.toml has no [project].name")
                            set ok = false
                        } else {
                            set find_args = [] :vec[str] mut
                            set find_args = vec::push::str(find_args strings::copy(dp_find))
                            set find_args = vec::push::str(find_args "-maxdepth")
                            set find_args = vec::push::str(find_args "1")
                            set find_args = vec::push::str(find_args "-name")
                            set find_args = vec::push::str(find_args "*.mire")
                            set mire_files = use! util::trim(proc::run::output("find" find_args))
                            set mire_count = len(use! util::split(mire_files "\n"))
                            if mire_count == 0 {
                                use dasu("  [FAIL] deps/" + pkg + ": no .mire files (cannot be loaded)")
                                set ok = false
                            } else {
                                set dep_ver = use! util::toml_get(toml_ver "project" "version")
                                use dasu("  [OK]   deps/" + pkg + " v" + dep_ver + " -> " + dp_msg)
                                set loadable += 1
                            }
                        }
                    }
                }
            }
        }
    }

    if loadable == checked {
        use dasu("  [OK]   deps: " + use! util::i64_to_string(loadable) + "/" + use! util::i64_to_string(checked) + " packages loadable")
    } else {
        use dasu("  [FAIL] deps: " + use! util::i64_to_string(loadable) + "/" + use! util::i64_to_string(checked) + " packages loadable")
        set ok = false
    }

    return ok
}

/! Validate load statements resolve !/
fn checkup_loads: () :bool {
    set ok = true :bool mut
    set scanned = use! util::scan_load_packages()

    if scanned == "" {
        use dasu("  [OK]   loads: no load statements found in source files")
        return true
    }

    set lib_dir = use! util::owl_home_libs()
    set scanned_len = len(scanned)
    set pos = 0 :i64 mut
    set total = 0 :i64 mut
    set resolved = 0 :i64 mut

    while pos < scanned_len {
        set rem = strings::substr(scanned pos scanned_len - pos)
        set nl = strings::index(rem "\n")
        set end = 0 :i64 mut
        if nl < 0 { set end = scanned_len } else { set end = pos + nl }
        set line = strings::substr(scanned pos end - pos)
        set pkg = use! util::trim(line)
        set pos = end + 1

        if pkg != "" {
            set total += 1
            set pkg_dir = lib_dir + "/" + pkg
            if fs::exists(pkg_dir) {
                set toml_path = pkg_dir + "/owl.toml"
                if fs::exists(toml_path) {
                    use dasu("  [OK]   loads/" + pkg + " -> " + pkg_dir)
                    set resolved += 1
                } else {
                    use dasu("  [WARN] loads/" + pkg + ": directory exists but no owl.toml")
                    set ok = false
                }
            } else {
                use dasu("  [FAIL] loads/" + pkg + ": not found in " + use! util::owl_home_libs_display())
                set ok = false
            }
        }
    }

    if resolved == total {
        use dasu("  [OK]   loads: " + use! util::i64_to_string(resolved) + "/" + use! util::i64_to_string(total) + " statements resolve")
    } else {
        use dasu("  [FAIL] loads: " + use! util::i64_to_string(resolved) + "/" + use! util::i64_to_string(total) + " statements resolve")
        set ok = false
    }

    return ok
}

/! Validate build cache !/
fn checkup_cache: () :bool {
    set ok = true :bool mut
    set cache_dir = use! util::toml_get("owl.toml" "paths" "cache") :str mut
    if cache_dir == "" { set cache_dir = "bin/.cache" }

    if !fs::exists(cache_dir) {
        use dasu("  [WARN] cache: " + cache_dir + " not found (will be created on first build)")
        return true
    }

    set find_args1 = [] :vec[str] mut
    set find_args1 = vec::push::str(find_args1 strings::copy(cache_dir))
    set find_args1 = vec::push::str(find_args1 "-type")
    set find_args1 = vec::push::str(find_args1 "f")
    set file_count = len(use! util::split(use! util::trim(proc::run::output("find" find_args1)) "\n"))

    if file_count == 0 {
        use dasu("  [WARN] cache: " + cache_dir + " is empty")
        return true
    }

    set find_args2 = [] :vec[str] mut
    set find_args2 = vec::push::str(find_args2 strings::copy(cache_dir))
    set find_args2 = vec::push::str(find_args2 "-type")
    set find_args2 = vec::push::str(find_args2 "f")
    set find_args2 = vec::push::str(find_args2 "-empty")
    set empty_count = len(use! util::split(use! util::trim(proc::run::output("find" find_args2)) "\n"))

    if empty_count != 0 {
        use dasu("  [FAIL] cache: " + use! util::i64_to_string(empty_count) + " empty/corrupt files found")
        set ok = false
    }

    set sources_dir = use! util::toml_get("owl.toml" "paths" "sources") :str mut
    if sources_dir == "" { set sources_dir = "code" }

    if fs::exists(sources_dir) {
        set find_args3 = [] :vec[str] mut
        set find_args3 = vec::push::str(find_args3 strings::copy(sources_dir))
        set find_args3 = vec::push::str(find_args3 "-name")
        set find_args3 = vec::push::str(find_args3 "*.mire")
        set find_args3 = vec::push::str(find_args3 "-newer")
        set find_args3 = vec::push::str(find_args3 strings::copy(cache_dir))
        set stale_count = len(use! util::split(use! util::trim(proc::run::output("find" find_args3)) "\n"))

        if stale_count != 0 {
            use dasu("  [WARN] cache: stale (" + use! util::i64_to_string(stale_count) + " source files modified after cache)")
            set ok = false
        } else {
            set du_args = [] :vec[str] mut
            set du_args = vec::push::str(du_args "-sh")
            set du_args = vec::push::str(du_args strings::copy(cache_dir))
            set size_out = use! util::trim(proc::run::output("du" du_args)) :str mut
            if size_out == "" { set size_out = "?" }
            set size_val = use! util::split(size_out "\t")
            set size_display = use! util::list_get(size_val 0) :str mut
            if size_display == "" { set size_display = "?" }
            use dasu("  [OK]   cache: " + use! util::i64_to_string(file_count) + " files (" + size_display + "), up to date")
        }
    } else {
        use dasu("  [OK]   cache: " + use! util::i64_to_string(file_count) + " files")
    }

    return ok
}

/! Fix missing dependencies by resolving from libs !/
fn checkup_fix_deps: () {
    if !use! util::has_project() {
        use dasu("  [FAIL] no owl.toml found")
        return
    }

    set lib_dir = use! util::owl_home_libs()
    set lib_display = use! util::owl_home_libs_display()
    set dep_count = use! deps::count_deps()

    if dep_count == 0 {
        use dasu("  [OK]   no dependencies to fix")
        return
    }

    set names = use! deps::get_dep_names()
    set names_len = len(names)
    set pos = 0 :i64 mut
    set fixed = 0 :i64 mut

    while pos < names_len {
        set rem = strings::substr(names pos names_len - pos)
        set nl = strings::index(rem "\n")
        set end = 0 :i64 mut
        if nl < 0 { set end = names_len } else { set end = pos + nl }
        set line = strings::substr(names pos end - pos)
        set pkg = use! util::trim(line)
        set pos = end + 1

        if pkg != "" {
            set pkg2 = pkg
            set dep_path = use! deps::get_dep_field(pkg2 "path")
            if dep_path == "" || !fs::exists(dep_path) {
                set lib_path = lib_dir + "/" + pkg
                if fs::exists(lib_path) {
                    set toml_path = lib_path + "/owl.toml"
                    if fs::exists(toml_path) {
                        set c = fs::read("owl.toml")
                        set dep_search = pkg + " = {"
                        set dep_pos = strings::index(c dep_search)
                        if dep_pos >= 0 {
                            set after_dep = strings::substr(c dep_pos 9999)
                            set line_end = strings::index(after_dep "\n") :i64 mut
                            if line_end < 0 { set line_end = len(after_dep) }
                            set full_line = strings::substr(after_dep 0 line_end)

                            set path_search = "path = \""
                            set path_idx = strings::index(full_line path_search)
                            if path_idx >= 0 {
                                set path_start = path_idx + len(path_search)
                                set after_path = strings::substr(full_line path_start 9999)
                                set path_end = strings::index(after_path "\"")
                                if path_end >= 0 {
                                    set old_path = strings::substr(after_path 0 path_end)
                                    set new_path = lib_display + "/" + pkg
                                    set before_path = strings::substr(full_line 0 path_start)
                                    set after_path_part = strings::substr(full_line path_start + path_end 9999)
                                    set new_line = before_path + new_path + after_path_part

                                    set before = strings::substr(c 0 dep_pos)
                                    set after = strings::substr(c dep_pos + line_end 9999)
                                    set new_c = before + new_line + after
                                    use fs::write("owl.toml" new_c)
                                    use dasu("  [FIX]  deps/" + pkg + ": path " + old_path + " -> " + new_path)
                                    set fixed += 1
                                }
                            }
                        }
                    }
                } else {
                    use dasu("  [SKIP] deps/" + pkg + ": not found in " + lib_display)
                }
            }
        }
    }

    if fixed > 0 {
        use dasu("")
        use dasu("  regenerating lockfile ...")
        use! lockfile::generate_lockfile()
    } else {
        use dasu("  [OK]   all dependency paths are valid")
    }
}

/! Clean build cache !/
fn checkup_fix_cache: () {
    set cache_dir = use! util::toml_get("owl.toml" "paths" "cache") :str mut
    if cache_dir == "" { set cache_dir = "bin/.cache" }

    if fs::exists(cache_dir) {
        use dasu("  [FIX]  cleaning cache: " + cache_dir)
        use! util::rm_RF(cache_dir)
        use dasu("  [OK]   cache cleaned")
    } else {
        use dasu("  [OK]   no cache to clean")
    }
}

/! Dependency validation command (owl check) !/
pub fn cmd_check: (args :&vec[str]) {
    if !use! util::has_project() {
        use dasu("  [FAIL]  no owl.toml found")
    } else {
        use dasu("  checking dependencies ...")
        use dasu("")

        set names = use! deps::get_dep_names()
        set found_any = names != "" :bool mut
        set nlen = len(names)
        set pos = 0 :i64 mut
        while pos < nlen {
            set nl = strings::index(strings::substr(names pos nlen - pos) "\n")
            set key = "" :str mut
            if nl < 0 {
                set key = use! util::trim(strings::substr(names pos nlen - pos))
                set pos = nlen
            } else {
                set key = use! util::trim(strings::substr(names pos nl))
                set pos = pos + nl + 1
            }
            if key != "" {
                set key_path = key
                set key_ver = key
                set key_display = key
                set path_val = use! deps::get_dep_field(key_path "path")
                set ver_val = use! deps::get_dep_field(key_ver "version")
                if path_val == "" {
                    use dasu("  [FAIL]  " + key_display + ": no path specified")
                } else {
                    if fs::exists(path_val) {
                        set msg = "  [OK]    " + key_display :str mut
                        if ver_val != "" {
                            set msg = msg + "  ->  " + path_val + "  (v" + ver_val + ")"
                        } else {
                            set msg = msg + "  ->  " + path_val
                        }
                        use dasu(msg)
                    } else {
                        use dasu("  [FAIL]  " + key + "  ->  " + path_val + "  (not found)")
                    }
                }
            }
        }

        if !found_any {
            use dasu("  no dependencies configured")
        }

        use dasu("")

        if found_any {
            use dasu("  ABI compatibility ---")
            set pos2 = 0 :i64 mut
            set nlen2 = len(names)
            while pos2 < nlen2 {
                set nl2 = strings::index(strings::substr(names pos2 nlen2 - pos2) "\n")
                set key2 = "" :str mut
                if nl2 < 0 {
                    set key2 = use! util::trim(strings::substr(names pos2 nlen2 - pos2))
                    set pos2 = nlen2
                } else {
                    set key2 = use! util::trim(strings::substr(names pos2 nl2))
                    set pos2 = pos2 + nl2 + 1
                }
                if key2 != "" {
                    set k_disp = key2 :str
                    set pv = use! deps::get_dep_field(key2 "path")
                    if pv != "" && fs::exists(pv) {
                        set mt = pv + "/meta.toml"
                        if fs::exists(mt) {
                            set mt_c = mt :str
                            set mt_a = mt :str
                            set mt_l = mt :str
                            set mc = use! util::toml_get(mt_c "package" "compiler")
                            set ma = use! util::toml_get(mt_a "package" "abi")
                            set ml = use! util::toml_get(mt_l "package" "language")
                            set abi_msg = "    " + k_disp + ": " :str mut
                            if mc != "" { set abi_msg = abi_msg + "compiler=" + mc }
                            if ma != "" {
                                if mc != "" { set abi_msg = abi_msg + ", " }
                                set abi_msg = abi_msg + "abi=" + ma
                            }
                            if ml != "" {
                                if mc != "" || ma != "" { set abi_msg = abi_msg + ", " }
                                set abi_msg = abi_msg + "lang=" + ml
                            }
                            use dasu(abi_msg)
                        }
                    }
                }
            }
        }
    }
}

/! Scans .mire files for `load` statements, resolves each from
   ~/.owl/libs, and injects missing entries into owl.toml.
   Then regenerates the lockfile.
!/
pub fn fix_loads: () {
    if !use! util::has_project() {
        use dasu("  [FAIL] no owl.toml found")
        return
    }

    set lib_dir = use! util::owl_home_libs()
    set lib_display = use! util::owl_home_libs_display()
    set scanned = use! util::scan_load_packages()
    if scanned == "" {
        use dasu("  [OK]   no load statements found in source files")
        return
    }

    set c = fs::read("owl.toml")
    set marker = "[dependencies]"
    set sec_pos = strings::index(c marker)
    if sec_pos < 0 {
        use dasu("  [FAIL] [dependencies] section not found in owl.toml")
        return
    }

    set injected = 0 :i64 mut
    set scanned_len = len(scanned)
    set pos = 0 :i64 mut
    while pos < scanned_len {
        set rem = strings::substr(scanned pos scanned_len - pos)
        set nl = strings::index(rem "\n")
        set end = 0 :i64 mut
        if nl < 0 { set end = scanned_len } else { set end = pos + nl }
        set line = strings::substr(scanned pos end - pos)
        set pkg = use! util::trim(line)
        set pos = end + 1
        if pkg != "" {
            set pkg2 = pkg
            if !use! deps::dep_exists(pkg2) {
                set toml_path = lib_dir + "/" + pkg + "/owl.toml"
                if fs::exists(toml_path) {
                    set ver = use! util::toml_get(toml_path "project" "version") :str mut
                    if ver == "" { set ver = "0.1.0" }
                    set dep_line = pkg + " = { path = \"" + lib_display + "/" + pkg + "\", version = \"" + ver + "\" }"

                    set c2 = fs::read("owl.toml")
                    set marker2 = "[dependencies]"
                    set sec_pos2 = strings::index(c2 marker2)
                    set insert_pos = sec_pos2 + len(marker2)
                    set before = strings::substr(c2 0 insert_pos)
                    set rem2 = len(c2) - insert_pos
                    set after = strings::substr(c2 insert_pos rem2)
                    set new_c = before + "\n" + dep_line + after
                    use fs::write("owl.toml" new_c)
                    use dasu("  [FIX]  injected '" + pkg + "' v" + ver + " into owl.toml")
                    set injected += 1
                } else {
                    use dasu("  [SKIP] '" + pkg + "' not found in " + lib_display)
                }
            }
        }
    }

    if injected > 0 {
        use dasu("")
        use dasu("  regenerating lockfile ...")
        use! lockfile::generate_lockfile()
    }
}
