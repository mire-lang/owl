module new

load mire::vec
load! /code/util

// Minimal valid project manifest. Matches codebase convention: code/ + .mire.
pub fn minimal_owl_toml: (name :str) :str {
    set toml = "[project]\n" :str mut
    set toml = toml + "name = \"" + name + "\"\n"
    set toml = toml + "version = \"0.1.0\"\n"
    set toml = toml + "description = \"\"\n\n"
    set toml = toml + "entry = \"code/main.mire\"\n\n"
    set toml = toml + "[build]\n"
    set toml = toml + "compiler = \"mire\"\n"
    set toml = toml + "profile = \"debug\"\n"
    set toml = toml + "opt-level = \"0\"\n"
    set toml = toml + "artifact = \"bin\"\n"
    set toml = toml + "runtime = \"minimal\"\n\n"
    set toml = toml + "[paths]\n"
    set toml = toml + "sources = \"code\"\n"
    set toml = toml + "tests = \"tests\"\n"
    set toml = toml + "output = \"bin\"\n"
    set toml = toml + "cache = \"bin/.cache\"\n"
    return toml
}

// Minimal main.mire source file. Matches codebase convention: pub fn main: ()
pub fn minimal_main: (name :str) :str {
    return "pub fn main: () {\n  use dasu(\"Hello from " + name + "\")\n}\n"
}

pub fn run: (args :&vec[str]) :i64 {
    set n = vec::len(args)
    if n < 3 {
        use dasu("Usage: owl new <project-name>")
        return 1
    }
    set proj = use! vec::get::str(args 2)
    if proj == "" {
        use dasu("Error: project name cannot be empty")
        return 1
    }
    if fs::exists(proj) {
        use dasu("Error: directory '" + proj + "' already exists")
        return 1
    }

    set code_dir = proj + "/code"
    set bin_dir = proj + "/bin"
    use! util::mkdir_p(code_dir)
    use! util::mkdir_p(bin_dir)

    set owl_toml = proj + "/owl.toml"
    set toml_content = use! new::minimal_owl_toml(proj)
    use! fs::write(owl_toml toml_content)
    if !fs::exists(owl_toml) {
        use dasu("Error: failed to write owl.toml")
        return 1
    }

    set main_mire = proj + "/code/main.mire"
    set main_content = use! new::minimal_main(proj)
    use! fs::write(main_mire main_content)
    if !fs::exists(main_mire) {
        use dasu("Error: failed to write code/main.mire")
        return 1
    }

    use dasu("Created project '" + proj + "':")
    use dasu("  " + proj + "/")
    use dasu("  ├── owl.toml")
    use dasu("  ├── bin/")
    use dasu("  └── code/")
    use dasu("      └── main.mire")
    use dasu("")
    use dasu("Run 'cd " + proj + " && owl build' to build")
    use dasu("Run 'cd " + proj + " && owl run' to execute")
    return 0
}
