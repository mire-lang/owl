module new

load mire::vec
load! /code/util

/! Minimal owl.toml template for new projects (owl v1.2.0+) !/
pub fn minimal_owl_toml: (name :str) :str {
    set toml = "" :str mut
    set toml = toml + "[project]\n"
    set toml = toml + "name = \"" + name + "\"\n"
    set toml = toml + "version = \"0.1.0\"\n"
    set toml = toml + "description = \"\"\n\n"
    set toml = toml + "[build]\n"
    set toml = toml + "main = \"./src/main.mire\"\n"
    set toml = toml + "bin = \"" + name + "\"\n\n"
    set toml = toml + "[build.profile]\n"
    set toml = toml + "opt-level = 0\n"
    set toml = toml + "profile = \"debug\"\n"
    set toml = toml + "artifact = \"bin\"\n"
    set toml = toml + "runtime = \"minimal\"\n"
    set toml = toml + "target = \"SystemAuto\"\n"
    set toml = toml + "incremental = true\n"
    set toml = toml + "debug-info = true\n"
    set toml = toml + "panic = \"abort\"\n\n"
    set toml = toml + "[paths]\n"
    set toml = toml + "source = \"./src/\"\n"
    set toml = toml + "target = \"./bin/\"\n"
    set toml = toml + "cache = \"./bin/.cache\"\n\n"
    set toml = toml + "[cfg]\n"
    set toml = toml + "deps = \"~/.owl/libs\"\n"
    set toml = toml + "lockfile = 3\n\n"
    set toml = toml + "[owl.deps]\n"
    return toml
}

/! Minimal main.mire stub !/
pub fn minimal_main: (name :str) :str {
    return "pub fn main: () :i64 {\n  use dasu(\"Hello from " + name + "\")\n  return 0\n}\n"
}

pub fn run: (args :&vec[str]) :i64 {
    set n = vec::len(args)
    if n == 0 {
        use dasu("Usage: owl new <project-name>")
        return 1
    }
    /! Get project name fresh for each use to avoid ownership issues !/
    if vec::get::str(args 0) == "" {
        use dasu("Error: project name cannot be empty")
        return 1
    }
    if fs::exists(vec::get::str(args 0)) {
        use dasu(strings::concat("Error: directory '" vec::get::str(args 0) "' already exists"))
        return 1
    }

    /! Create project structure !/
    set bin_dir = strings::concat(vec::get::str(args 0) "/bin")
    use! util::mkdir_p(strings::concat(vec::get::str(args 0) "/src"))
    use! util::mkdir_p(bin_dir)

    /! Write owl.toml !/
    set owl_toml = strings::concat(vec::get::str(args 0) "/owl.toml")
    set toml_content = use! new::minimal_owl_toml(vec::get::str(args 0))
    if !fs::write(owl_toml toml_content) {
        use dasu("Error: failed to write owl.toml")
        return 1
    }

    /! Write src/main.mire !/
    set main_mire = strings::concat(vec::get::str(args 0) "/src/main.mire")
    set main_content = use! new::minimal_main(vec::get::str(args 0))
    if !fs::write(main_mire main_content) {
        use dasu("Error: failed to write src/main.mire")
        return 1
    }

    use dasu(strings::concat("Created project '" vec::get::str(args 0) "':"))
    use dasu(strings::concat("  " vec::get::str(args 0) "/"))
    use dasu("  ├── owl.toml")
    use dasu("  ├── bin/")
    use dasu("  └── src/")
    use dasu("      └── main.mire")
    use dasu("")
    use dasu("Run 'cd " + vec::get::str(args 0) + " && owl build' to build")
    use dasu("Run 'cd " + vec::get::str(args 0) + " && owl run' to execute")
    return 0
}