module new

load mire::vec
load! /code/util

/! Minimal valid project manifest. Full configuration is documented in
   docs/Configuration/owl-toml.md. !/
pub fn minimal_owl_toml: (name :str) :str {
    set toml = "" :str mut
    set toml = toml + "[project]\n"
    set toml = toml + "name = \"" + name + "\"\n"
    set toml = toml + "version = \"0.1.0\"\n"
    set toml = toml + "description = \"\"\n\n"
    set toml = toml + "entry = \"src/main.mr\"\n\n"
    set toml = toml + "[build]\n"
    set toml = toml + "compiler = \"mire\"\n"
    set toml = toml + "profile = \"debug\"\n"
    set toml = toml + "opt-level = \"0\"\n"
    set toml = toml + "artifact = \"bin\"\n"
    set toml = toml + "runtime = \"minimal\"\n\n"
    set toml = toml + "[paths]\n"
    set toml = toml + "sources = \"src\"\n"
    set toml = toml + "tests = \"tests\"\n"
    set toml = toml + "output = \"bin\"\n"
    set toml = toml + "cache = \"bin/.cache\"\n"
    return toml
}

/! Minimal main.mr source file. !/
pub fn minimal_main: (name :str) :str {
    return "pub fn main: () :i64 {\n  use dasu(\"Hello from " + name + "\")\n  return 0\n}\n"
}

pub fn run: (args :&vec[str]) :i64 {
    set n = vec::len(args)
    if n < 3 {
        use dasu("Usage: owl new <project-name>")
        return 1
    }
    /! Get project name fresh for each use to avoid ownership issues !/
    if vec::get::str(args 2) == "" {
        use dasu("Error: project name cannot be empty")
        return 1
    }
    if fs::exists(vec::get::str(args 2)) {
        use dasu(strings::concat("Error: directory '" vec::get::str(args 2) "' already exists"))
        return 1
    }

    /! Create project structure !/
    set bin_dir = strings::concat(vec::get::str(args 2) "/bin")
    use! util::mkdir_p(strings::concat(vec::get::str(args 2) "/src"))
    use! util::mkdir_p(bin_dir)

    /! Write owl.toml !/
    set owl_toml = strings::concat(vec::get::str(args 2) "/owl.toml")
    set toml_content = use! new::minimal_owl_toml(vec::get::str(args 2))
    use! fs::write(owl_toml toml_content)
    if !fs::exists(owl_toml) {
        use dasu("Error: failed to write owl.toml")
        return 1
    }

    /! Write src/main.mr !/
    set main_mire = strings::concat(vec::get::str(args 2) "/src/main.mr")
    set main_content = use! new::minimal_main(vec::get::str(args 2))
    use! fs::write(main_mire main_content)
    if !fs::exists(main_mire) {
        use dasu("Error: failed to write src/main.mr")
        return 1
    }

    use dasu(strings::concat("Created project '" vec::get::str(args 2) "':"))
    use dasu(strings::concat("  " vec::get::str(args 2) "/"))
    use dasu("  ├── owl.toml")
    use dasu("  ├── bin/")
    use dasu("  └── src/")
    use dasu("      └── main.mr")
    use dasu("")
    use dasu("Run 'cd " + vec::get::str(args 2) + " && owl build' to build")
    use dasu("Run 'cd " + vec::get::str(args 2) + " && owl run' to execute")
    return 0
}
