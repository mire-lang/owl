/! Validate the project environment before compilation. A missing or stale
   lockfile is a dependency-management state, not a compiler error: Owl asks
   once whether it may resolve/install through its normal installer. !/
fn ensure_project_dependencies: () :bool {
    if use! lockfile::exists() && use! lockfile::in_sync() {
        return true
    }

    if use! lockfile::exists() {
        use dasu("  owl.lock is out of sync with owl.toml")
    } else {
        use dasu("  owl.lock was not found")
    }
    use dasu("  resolve and install dependencies now? (Y/n)")
    set answer = use! util::read_line_trim()
    if answer == "n" || answer == "N" {
        use dasu("  cancelled; run 'owl install' when ready")
        return false
    }

    set install_status = use! install::run(false false false false "" true "" "" false) :u8
    if install_status != 0 {
        use dasu("  dependency resolution failed; compilation was not started")
        return false
    }
    return use! lockfile::exists() && use! lockfile::in_sync()
}

/! Generate the explicit compiler configuration used by `owl test`. Tests
   must receive the same dependency roots and runtime policy as builds; relying
   on Avenys to rediscover owl.toml would quietly reintroduce the old project
   manager boundary. !/
pub fn test_config: (args :&vec[str]) :str {
    if !use! build::ensure_project_dependencies() {
        use! util::error_line("OWL0003" "dependencies are unresolved")
        exit(1)
    }

    set profile = use! util::config_required("build" "profile") :str mut
    set opt = use! util::config_required("build" "opt-level") :str mut
    if use! args::flag::has(args "--release") || use! args::flag::has(args "-r") {
        set profile = "release"
        set opt = "3"
    }
    if use! args::flag::has(args "--debug") || use! args::flag::has(args "-d") {
        set profile = "debug"
        set opt = "0"
    }
    set requested_opt = use! util::arg_value(args "--opt-level")
    if requested_opt != "" { set opt = requested_opt }

    set entry = use! util::config_required("project" "entry")
// ----- owl resolves, it does not decide. A test needs an executable, and what
// ----- a project publishes is irrelevant to that, so the artifact the
// ----- manifest declares is not consulted here. Forwarding it was how a
// ----- library declaring artifact = "shared" ended up building a shared
// ----- object with no test entry point: every test file was reported ok having
// ----- run no assertion, across all five library packages in the tree. The
// ----- compiler enforces the same rule for anyone who drives it directly; this
// ----- keeps owl from handing it a manifest to override.
    set artifact = "bin"
// ----- owl writes a normalized mire config per artifact; the tier and target
// ----- must still honor the project's owl.toml so full-tier projects (e.g.
// ----- the avenys test suite) don't silently regress to "minimal".
set runtime = use! util::arg_value(args "--runtime") :str mut
if runtime == "" {
    set runtime = use! util::config_default("build" "runtime" "minimal")
// ----- A test needs the runtime to run on, so a manifest declaring
// ----- runtime = "none" is lifted to "minimal" here. An explicit --runtime is
// ----- left alone: the caller asked for that tier by name.
    if runtime == "none" { set runtime = "minimal" }
}

    set target = use! util::arg_value(args "--target") :str mut
    if target == "" { set target = "x86_64-unknown-linux-gnu" }
    set output = use! util::config_required("paths" "output")
    set cache = use! util::config_required("paths" "cache")
    set config = cache + "/mire-test-config.toml"
    use! util::mkdir_p(strings::copy(cache))
    set compiler_output = output + "/" + profile
    if !use! util::write_mire_config(strings::copy(config) strings::copy(entry) strings::copy(profile) strings::copy(opt) strings::copy(artifact) strings::copy(runtime) strings::copy(target) strings::copy(compiler_output) strings::copy(cache) use! deps::compiler_lib_dirs()) {
        use! util::error_line("OWL0005" "could not write normalized Mire test configuration")
        exit(1)
    }
    return config
}

pub fn compile: (args :&vec[str] is_run :bool) {
    set is_proj = use! util::has_project() :bool mut

    set n = vec::len(args) :i64 mut
    set file_idx = 1 :i64 mut
    set fi = 1 :i64 mut
    while fi < n {
        set fa = vec::get::str(args fi)
        if !use! util::startswith(fa "-") {
            set file_idx = fi
            set fi = n
        }
        set fi += 1
    }

    set i = 1 :i64 mut
    set cli_file = "" :str mut
    set cli_profile = "" :str mut
    set cli_opt = "" :str mut
    set extra_flags = "" :str mut
    set run_args = [] :vec[str] mut
    set seen_ddash = false :bool mut
    while i < n {
        set a = vec::get::str(args i)
        if a == "--" {
            set seen_ddash = true
        } else {
            if seen_ddash {
                set run_args = vec::push::str(run_args strings::copy(a))
            } else {
                if a == "--debug" || a == "-d" {
                    set cli_profile = "debug"
                    set cli_opt = "0"
                } else {
                    if a == "--release" || a == "-r" {
                        set cli_profile = "release"
                        set cli_opt = "3"
                    } else {
                        if a == "-O" || a == "--opt-level" {
                            set i += 1
                            if i < n { set cli_opt = vec::get::str(args i) }
                        } else {
                            if use! util::startswith(a "-O") && len(a) > 2 {
                                set cli_opt = use! util::replace(a "-O" "")
                            } else {
                                if !use! util::startswith(a "-") && cli_file == "" {
                                    set cli_file = a
                                } else {
                                    if use! util::startswith(a "-") {
                                        set extra_flags = extra_flags + " " + a
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        set i += 1
    }

    if !is_proj {
        if cli_file == "" {
            if file_idx > 0 && file_idx < n { set cli_file = vec::get::str(args file_idx) }
        }
        if cli_file == "" {
            use! util::error_line("OWL0002" "no file specified and no owl.toml found")
            exit(1)
        } else {
            set argv = [] :vec[str] mut
            if is_run { set argv = vec::push::str(argv "run") } else { set argv = vec::push::str(argv "build") }
            set argv = vec::push::str(argv cli_file)
            if cli_profile == "release" { set argv = vec::push::str(argv "--release") } else { set argv = vec::push::str(argv "--debug") }
            if cli_opt != "" {
                set argv = vec::push::str(argv "-O")
                set argv = vec::push::str(argv cli_opt)
            }
            set argv = vec::push::str(argv "--lib-dir")
            set argv = vec::push::str(argv use! deps::compiler_lib_dirs())
            if extra_flags != "" {
                set toks = strings::split(extra_flags " ")
                set ti = 0 :i64 mut
                while ti < len(toks) {
                    set tk = use! util::list_get(toks ti)
                    if tk != "" { set argv = vec::push::str(argv tk) }
                    set ti += 1
                }
            }
            set out = use! util::run_compiler(argv)
            use dasu(out)
        }
    } else {
        if !use! build::ensure_project_dependencies() {
            use! util::error_line("OWL0003" "dependencies are unresolved")
            exit(1)
        } else {
            set entry = use! util::config_required("project" "entry")
            set file = entry :str mut
            if cli_file != "" && fs::exists(cli_file) { set file = cli_file }

            set profile = use! util::config_required("build" "profile") :str mut
            set opt = use! util::config_required("build" "opt-level") :str mut
            if cli_profile != "" { set profile = cli_profile }
            if cli_opt != "" { set opt = cli_opt }

            set out_dir = use! util::config_required("paths" "output") :str mut
            set cache_dir = use! util::config_required("paths" "cache") :str mut

set artifact = use! util::arg_value(args "--artifact") :str mut
    if artifact == "" { 
        set artifact = use! util::config_default("build" "artifact" "bin") 
    }
            set runtime = use! util::arg_value(args "--runtime") :str mut
            if runtime == "" {
                set runtime = use! util::config_default("build" "runtime" "minimal")
            }
            set target = use! util::arg_value(args "--target") :str mut
            if target == "" { set target = "x86_64-unknown-linux-gnu" }

            if !fs::exists(file) {
                use! util::error_line("OWL0002" "input not found: " + file)
                exit(1)
            } else {
                set cache = cache_dir
                set output = out_dir
                use! util::mkdir_p(strings::copy(cache))
                use! util::mkdir_p(strings::copy(output))

                set out_dir2 = use! util::config_required("paths" "output")
                set compiler_output = output + "/" + profile
                set mire_config = cache + "/mire-config.toml"
                if !use! util::write_mire_config(strings::copy(mire_config) strings::copy(file) strings::copy(profile) strings::copy(opt) strings::copy(artifact) strings::copy(runtime) strings::copy(target) strings::copy(compiler_output) strings::copy(cache) use! deps::compiler_lib_dirs()) {
                    use! util::error_line("OWL0005" "could not write normalized Mire configuration")
                    exit(1)
                }

                set argv = [] :vec[str] mut
                set argv = vec::push::str(argv "build")
                set argv = vec::push::str(argv strings::copy(file))
                set argv = vec::push::str(argv "--config")
                set argv = vec::push::str(argv strings::copy(mire_config))
                if profile == "release" { set argv = vec::push::str(argv "--release") } else { set argv = vec::push::str(argv "--debug") }
                set argv = vec::push::str(argv "-O")
                set argv = vec::push::str(argv strings::copy(opt))
                set argv = vec::push::str(argv "--lib-dir")
                set argv = vec::push::str(argv use! deps::compiler_lib_dirs())
                if extra_flags != "" {
                    set toks = strings::split(extra_flags " ")
                    set ti = 0 :i64 mut
                    while ti < len(toks) {
                        set tk = use! util::list_get(toks ti)
                        if tk != "" { set argv = vec::push::str(argv strings::copy(tk)) }
                        set ti += 1
                    }
                }
                use dasu("  [" + profile + " -O" + opt + "]")

                if is_run {
                    set build_out = use! util::run_compiler(argv)
                    use dasu(build_out)
                    if use proc::run::last_exit() == 0 { 
                        use! util::record_build() 
                        set name = entry :str mut
                        if cli_file != "" && (fs::exists(cli_file) || use! util::endswith(cli_file ".mire")) { set name = cli_file }
                        if use! util::endswith(name ".mire") {
                            set name = use! util::replace(name ".mire" "")
                        }
                        set parts = use! util::split(name "/")
                        set name = use! util::list_get(parts len(parts) - 1)

                        set bin = "./" + out_dir2 + "/" + profile + "/" + name :str mut

                        use dasu("")
                        use dasu("  running " + bin + " ...")
                        use proc::run::spawn(bin run_args)
                    }
                } else {
                    set out = use! util::run_compiler(argv)
                    use dasu(out)
                    if use proc::run::last_exit() == 0 { use! util::record_build() }
                }
            }
        }
    }
}

pub fn debug: (args :&vec[str]) {
    set is_proj = use! util::has_project() :bool mut
    set n = vec::len(args) :i64 mut

    set file_idx = 1 :i64 mut
    set fi = 1 :i64 mut
    while fi < n {
        set fa = vec::get::str(args fi)
        if !use! util::startswith(fa "-") {
            set file_idx = fi
            set fi = n
        }
        set fi += 1
    }

    set extra_flags = "" :str mut
    set i = 1 :i64 mut
    while i < n {
        set a = vec::get::str(args i) :str mut
        if a == "--tokens" || a == "-t" {
            set extra_flags = extra_flags + " --tokens"
        } else {
            if a == "--ast" || a == "-p" {
                set extra_flags = extra_flags + " --ast"
            } else {
                if a == "--ir" {
                    set extra_flags = extra_flags + " --ir"
                } else {
                    if a == "--run" || a == "-r" {
                        set extra_flags = extra_flags + " --run"
                    } else {
                        if !use! util::startswith(a "-") && (use! util::path_exists(a) || use! util::endswith(a ".mire")) {
                            set file_idx = i
                        } else {
                            if use! util::startswith(a "-") {
                                set extra_flags = extra_flags + " " + a
                            }
                        }
                    }
                }
            }
        }
        set i += 1
    }

    set cli_file = "" :str mut
    if file_idx > 0 && file_idx < n { set cli_file = vec::get::str(args file_idx) }

    if !is_proj {
        if cli_file == "" {
            use! util::error_line("OWL0002" "no file specified and no owl.toml found")
            exit(1)
            return
        }
        set argv = [] :vec[str] mut
        set argv = vec::push::str(argv "debug")
        set argv = vec::push::str(argv strings::copy(cli_file))
        set argv = vec::push::str(argv "--lib-dir")
        set lib_dirs = use! deps::compiler_lib_dirs()
        set argv = vec::push::str(argv lib_dirs)
        if extra_flags != "" {
            set toks = strings::split(extra_flags " ")
            set ti = 0 :i64 mut
            while ti < len(toks) {
                set tk = use! util::list_get(toks ti)
                if tk != "" { set argv = vec::push::str(argv strings::copy(tk)) }
                set ti += 1
            }
        }
        set out = use! util::run_compiler(argv)
        use dasu(out)
        return
    }

    if !use! build::ensure_project_dependencies() {
        use! util::error_line("OWL0003" "dependencies are unresolved")
        exit(1)
        return
    }
    set entry = use! util::config_required("project" "entry")
    set file = entry :str mut
    if cli_file != "" && fs::exists(cli_file) { set file = cli_file }
    if !fs::exists(file) {
        use! util::error_line("OWL0002" "input not found: " + file)
        exit(1)
        return
    }
    set argv = [] :vec[str] mut
    set argv = vec::push::str(argv "debug")
    set argv = vec::push::str(argv strings::copy(file))
    set argv = vec::push::str(argv "--lib-dir")
    set lib_dirs = use! deps::compiler_lib_dirs()
    set argv = vec::push::str(argv lib_dirs)
    if extra_flags != "" {
        set toks = strings::split(extra_flags " ")
        set ti = 0 :i64 mut
        while ti < len(toks) {
            set tk = use! util::list_get(toks ti)
            if tk != "" { set argv = vec::push::str(argv strings::copy(tk)) }
            set ti += 1
        }
    }
    set out = use! util::run_compiler(argv)
    use dasu(out)
}

pub fn new: (name :str) {
    if fs::exists(name) {
        use dasu("Error: directory already exists")
    } else {
        set dirs = use! util::split(name "/")
        set base = use! util::list_get(dirs len(dirs) - 1)
        set n = base
        use! util::mkdir_p(name + "/code")
        use! util::mkdir_p(name + "/bin")
        use! util::mkdir_p(name + "/tests")
        use! util::mkdir_p(name + "/docs")

        set mire_path = use! util::owl_home_libs_display() + "/mire"
        set auto = use! deps::gather_latest_libs()
        set deps_section = "[dependencies]\nmire = { path = \"" + mire_path + "\", version = \"0.1.0\" }\n"
        set auto_section = "" :str mut
        if auto != "" {
            set auto_section = "\n[tool.owl.auto-deps]\n" + auto + "\n"
        }
        set toml = "[project]\nname = \"" + n + "\"\nversion = \"0.1.0\"\ndescription = \"A Mire project\"\nentry = \"code/main.mire\"\n\n[build]\ncompiler = \"mire\"\nprofile = \"debug\"\nopt-level = \"0\"\n\n[paths]\nsources = \"code\"\ntests = \"tests\"\noutput = \"bin\"\ncache = \"bin/.cache\"\n\n" + deps_section + auto_section
        use fs::write(name + "/owl.toml" toml)
        use fs::write(name + "/code/main.mire" "pub fn main: () {\n    use dasu(\"ok\")\n}\n")
        use fs::write(name + "/tests/smoke.mire" "@[test]\npub fn test_smoke: () :bool {\n    return true\n}\n")
        use dasu("Project created: " + name)
    }
}
