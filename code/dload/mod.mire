load! /code/util
load! /code/registry
load! /code/deps
load! /code/args

pub fn cmd_load_url: (args :&vec[str]) {
    set url = use! args::get_flag_value(args "--url") :str mut
    if url == "" {
        set url = use! args::get_flag_value(args "-u")
    }
    if url == "" {
        set url = use! args::get_positional(args 0)
    }
    if url == "" {
        use dasu("usage: owl load --url <url>")
        use dasu("       owl -Lu <url>")
    } else {
        use! registry::cmd_registry_add(url)
    }
    return
}

pub fn cmd_load_dep: (args :&vec[str]) {
    set n = rt_vec_len(args)
    set proceed = true :bool mut
    if n < 3 {
        use dasu("usage: owl load <name> [--path <path>]")
        use dasu("       owl -L <name> [--path <path>]")
        set proceed = false
    }

    if proceed {
        set i = 2 :i64 mut
        set name_arg = "" :str mut
        set has_path = false :bool mut
        set path_val = "" :str mut
        while i < n {
            set arg = rt_vec_get_str(args i)
            if arg == "--path" || arg == "-p" {
                set has_path = true
                set i2 = i + 1
                if i2 < n { set path_val = rt_vec_get_str(args i2) }
            } else {
                if name_arg == "" { set name_arg = arg }
            }
            set i = i + 1
        }

        if name_arg == "" {
            use dasu("error: package name required")
            set proceed = false
        }

        if proceed && !use! util::has_project() {
            use dasu("error: must be run from a project directory (no owl.toml found)")
            set proceed = false
        }

        if proceed {
            set name_copy = name_arg :str
            if use! deps::dep_exists(name_copy) {
                use dasu("error: dependency '" + name_arg + "' already in owl.toml")
                set proceed = false
            }
        }

        if proceed {
            set c = fs::read("owl.toml")
            if c == "" {
                use dasu("error: owl.toml is empty or missing")
                set proceed = false
            }

            if proceed {
                set marker = "[dependencies]"
                set sec_pos = strings::index(c marker)
                if sec_pos < 0 {
                    use dasu("error: [dependencies] section not found in owl.toml")
                    set proceed = false
                }

                if proceed {
                    set backup_name = "owl.toml.backup"
                    use fs_write(backup_name c)

                    set insert_pos = sec_pos + len(marker)
                    set before = strings::substr(c 0 insert_pos)
                    set rem = len(c) - insert_pos
                    set after = strings::substr(c insert_pos rem)

                    if has_path {
                        if path_val == "" {
                            use dasu("error: --path requires a value")
                            set proceed = false
                        }

                        if proceed {
                            set dep_line = name_arg + " = { path = \"" + path_val + "\" }"
                            set new_c = before + "\n" + dep_line + after
                            use fs_write("owl.toml" new_c)
                            set ok_msg = "loaded '" + name_arg + "' from " + path_val
                            use dasu(ok_msg)
                        }
                    } else {
                        set owl_home = use! util::owl_home()
                        set owl_libs = use! util::owl_home_libs_display()
                        set mp = owl_home + "/libs/" + name_arg + "/owl.toml"
                        if !fs_exists(mp) {
                            set err_msg = "error: '" + name_arg + "' not found in " + owl_libs + "/"
                            use dasu(err_msg)
                            use dasu("  has the package been installed?")
                            set proceed = false
                        }

                        if proceed {
                            set version = use! util::toml_get(mp "project" "version") :str mut
                            if version == "" { set version = "0.1.0" }
                            set real_path = owl_libs + "/" + name_arg
                            set dep_line = name_arg + " = { path = \"" + real_path + "\", version = \"" + version + "\" }"
                            set new_c = before + "\n" + dep_line + after
                            use fs_write("owl.toml" new_c)
                            set ok_msg = "loaded '" + name_arg + "' v" + version + " from cache"
                            use dasu(ok_msg)
                        }
                    }
                }
            }
        }
    }
    return
}

pub fn cmd_load_remove_registry: (args :&vec[str]) {
    set name = use! args::get_positional(args 0) :str mut
    if name == "" {
        set name = use! args::get_flag_value(args "-r")
    }
    if name == "" {
        set name = use! args::get_flag_value(args "--remove")
    }
    if name == "" {
        use dasu("usage: owl load -r|--remove <name>")
    } else {
        use! registry::cmd_registry_remove(name)
    }
    return
}

pub fn cmd_load: (args :&vec[str]) {
    set is_url = use! args::has_flag(args "-u") || use! args::has_flag(args "--url")
    set is_list = use! args::has_flag(args "-l") || use! args::has_flag(args "--list")
    set is_sync = use! args::has_flag(args "-s") || use! args::has_flag(args "--sync")
    set is_rm = use! args::has_flag(args "-r") || use! args::has_flag(args "--remove")
    if is_url { use! dload::cmd_load_url(args) } else {
        if is_list { use! registry::cmd_registry_list() } else {
            if is_sync { use! registry::cmd_registry_sync() } else {
                if is_rm { use! dload::cmd_load_remove_registry(args) } else {
                    use! dload::cmd_load_dep(args)
                }
            }
        }
    }
}
