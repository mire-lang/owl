module install

load mire::std
load mire::vec
load kioto::strings
load! /code/util
load kioto::proc
load! /code/semver
load kioto::proc
load! /code/lockfile
load kioto::proc
load! /code/dep_resolver
load kioto::proc
load! /code/_externs
load! /code/crypto

pub fn run: (has_l :bool has_t :bool no_verify :bool force :bool target_val :str yes :bool name :str ver :str has_lock :bool) :u8 {
    set ec = 0 :u8 mut
    use! util::mkdir_p(use! util::cfg::home())
    if has_lock {
        if use! lockfile::in_sync() {
            /! use! lockfile::all() !/
        } else {
            use dasu("  owl.lock does not match owl.toml")
            use dasu("  run 'owl install' to resolve dependencies, then retry with --lock")
            set ec = 1 :u8
        }
        return ec
    }
    if has_l {
        use! install::list()
    } else {
        set is_empty = len(name) == 0
        if is_empty {
            if has_t { use dasu("Usage: owl install -t <name>") } else {
                use dasu("  resolving dependencies from owl.toml ...")
                set plan = use! dep_resolver::resolve()
                set ok = use! dep_resolver::execute_plan(plan)
                if ok {
                    use dasu("  [OK]   dependencies resolved and locked")
                } else {
                    use dasu("  [FAIL] could not resolve dependencies")
                    set ec = 1 :u8
                }
            }
        } else {
            set version = ver :str mut
            if len(version) == 0 || version == "*" { set version = "latest" }
            set ec = use! install::package(name version no_verify force)
        }
    }
    return ec
}

pub fn list: () {
    set reg_dir = use! util::owl_home_registries()
    set reg_arg = use! strings::copy(reg_dir)
    set reg_list = use! util::list_text(reg_arg)
    if len(reg_list) == 0 {
        use dasu("  no registries configured -- run: owl reg add <registry-url>")
    } else {
        use dasu("  available packages:")
        set entries = use! util::split(reg_list "\n")
        set ni = len(entries)
        set i_reg = 0 :i64 mut
        while i_reg < ni {
            set reg_name = use! util::trim(use! util::list_get(entries i_reg))
            if len(reg_name) > 0 {
                set idx_path = use! strings::concat(use! strings::concat(reg_dir "/") reg_name) "/index.toml"
                set content = use! fs::read(idx_path)
                if len(content) > 0 {
                    set lines = use! semver::count_lines(content)
                    set in_pkg = false :bool mut
                    set cur_name = "" :str mut
                    set cur_ver = "" :str mut
                    set i = 0 :i64 mut
                    while i < lines {
                        set line = use! util::trim(use! semver::nth_line(content i))
                        if line == "[[packages]]" {
                            if in_pkg && len(cur_name) > 0 {
                                use dasu(use! strings::concat(use! strings::concat("  " reg_name) " / ") + use! strings::concat(cur_name " v") + cur_ver)
                            }
                            set in_pkg = true
                            set cur_name = ""
                            set cur_ver = ""
                        } else {
                            if in_pkg {
                                if use! util::startswith(line "name =") { set cur_name = use! semver::extract_str_val(line) }
                                if use! util::startswith(line "version =") { set cur_ver = use! semver::extract_str_val(line) }
                            }
                        }
                        set i += 1
                    }
                    if in_pkg && len(cur_name) > 0 {
                        use dasu(use! strings::concat(use! strings::concat("  " reg_name) " / ") + use! strings::concat(cur_name " v") + cur_ver)
                    }
                }
            }
            set i_reg += 1
        }
    }
}

/! ── Registry lookup and installation ─────────────────────────────────────────
   `owl install <name>` reads the configured registries under ~/.owl/reg,
   resolves the requested package/version, and then:
     * method = "clone"   → git clone --depth 1 --branch <ref>, verify the
                            pinned commit, install under ~/.owl/libs.
     * method = "release" → download the release asset, verify SHA-256/SHA-512
                            (and the detached signature when the registry
                            publishes a public key), then extract.
   Nothing is installed without a verifiable pin or checksum. !/

fn field_val: (line :&str) :str {
    set eq = strings::index(line "=")
    if eq < 0 { return "" }
    set v = use! util::trim(strings::substr(line eq + 1 9999)) mut
    if use! util::startswith(v "\"") && use! util::endswith(v "\"") {
        if strings::len(v) >= 2 { set v = strings::substr(v 1 strings::len(v) - 2) }
    } else {
        if use! util::startswith(v "\"") { set v = strings::substr(v 1 9999) }
    }
    return v
}

/! Search every configured registry for a package block. Returns a flat
   '|'-separated record or "" when nothing matches:
     name|version|registry|method|repo|ref|commit|tag|asset|tarball|sha256|sha512 !/
fn index_lookup: (name :str want :str) :str {
    // Ensure owl home directory exists for registry access
    // (fs::exists and fs::read work on absolute paths in current kioto)
    use! util::owl_home()
    set reg_root = use! util::owl_home_registries()
    set regs = use! util::list_dir(reg_root)
    if vec::len(regs) == 0 { return "" }
    set nr = vec::len(regs)
    set ri = 0 :i64 mut
    while ri < nr {
        set reg = use! util::trim(use! util::list_get(regs ri))
        if len(reg) > 0 && reg != "index.toml" && reg != "protocol" && reg != "source_url" {
            set reg_path = use! strings::concat(strings::concat(reg_root "/") reg)
            set idx = use! strings::concat(reg_path "/index.toml")
            if fs::exists(idx) {
                set content = fs::read(idx)
                set lines = strings::split(content "\n")
                set nl = vec::len(lines)
                // Parse all packages into a flat list of records first, to avoid
                // loop-variable corruption of outer-scope variables (compiler bug).
                // Each record: name|version|method|repo|ref|commit|tag|asset|tarball|sha256|sha512
                set packages = [] :vec[str] mut
                set li = 0 :i64 mut
                set in_pkg = false :bool mut
                set cur_name = "" :str mut
                set cur_ver = "" :str mut
                set cur_method = "" :str mut
                set cur_repo = "" :str mut
                set cur_ref = "" :str mut
                set cur_commit = "" :str mut
                set cur_tag = "" :str mut
                set cur_asset = "" :str mut
                set cur_tarball = "" :str mut
                set cur_sha256 = "" :str mut
                set cur_sha512 = "" :str mut
                while li < nl {
                    set line = use! util::trim(use! util::list_get(lines li))
                    if line == "[[packages]]" {
                        if in_pkg {
                            // Save the completed package
                            set rec = cur_name + "|" + cur_ver + "|" + cur_method + "|" + cur_repo + "|" + cur_ref + "|" + cur_commit + "|" + cur_tag + "|" + cur_asset + "|" + cur_tarball + "|" + cur_sha256 + "|" + cur_sha512
                            /! vec::push::str stores the reference, so copy: `rec` is reused
                               for the next package and later for lookups. !/
                            set packages = vec::push::str(packages strings::copy(rec))
                        }
                        // Start new package
                        set in_pkg = true
                        set cur_name = ""
                        set cur_ver = ""
                        set cur_method = ""
                        set cur_repo = ""
                        set cur_ref = ""
                        set cur_commit = ""
                        set cur_tag = ""
                        set cur_asset = ""
                        set cur_tarball = ""
                        set cur_sha256 = ""
                        set cur_sha512 = ""
                    } else {
                        if in_pkg {
                            set val = use! install::field_val(line)
                            if use! util::startswith(line "name = ") { set cur_name = strings::copy(val) }
                            if use! util::startswith(line "version = ") { set cur_ver = strings::copy(val) }
                            if use! util::startswith(line "method = ") { set cur_method = strings::copy(val) }
                            if use! util::startswith(line "repo = ") { set cur_repo = strings::copy(val) }
                            if use! util::startswith(line "ref = ") { set cur_ref = strings::copy(val) }
                            if use! util::startswith(line "commit = ") { set cur_commit = strings::copy(val) }
                            if use! util::startswith(line "tag = ") { set cur_tag = strings::copy(val) }
                            if use! util::startswith(line "asset = ") { set cur_asset = strings::copy(val) }
                            if use! util::startswith(line "tarball = ") { set cur_tarball = strings::copy(val) }
                            if use! util::startswith(line "sha256 = ") { set cur_sha256 = strings::copy(val) }
                            if use! util::startswith(line "sha512 = ") { set cur_sha512 = strings::copy(val) }
                        }
                    }
                    set li += 1
                }
                // Save the last package
                if in_pkg {
                    set rec = cur_name + "|" + cur_ver + "|" + cur_method + "|" + cur_repo + "|" + cur_ref + "|" + cur_commit + "|" + cur_tag + "|" + cur_asset + "|" + cur_tarball + "|" + cur_sha256 + "|" + cur_sha512
                    set packages = vec::push::str(packages strings::copy(rec))
                }
                // Search for matching package. A "latest" request has to pick
                // the highest version, not the first block in the file: the
                // index intentionally lists older releases first.
                set np = vec::len(packages)
                set pi = 0 :i64 mut
                set best_rec = "" :str mut
                set best_ver = "" :str mut
                while pi < np {
                    set rec = use! util::list_get(packages pi)
                    set fields = strings::split(rec "|")
                    set pkg_name = use! util::list_get(fields 0)
                    set pkg_ver = use! util::list_get(fields 1)
                    if pkg_name == name {
                        if want == "" || want == "latest" || want == "*" {
                            if best_rec == "" || use! semver::compare_versions(pkg_ver best_ver) > 0 {
                                set best_rec = strings::copy(rec)
                                set best_ver = strings::copy(pkg_ver)
                            }
                        } else {
                            if want == pkg_ver {
                                /! name|version|registry|method|repo|ref|commit|tag|asset|tarball|sha256|sha512 !/
                                return pkg_name + "|" + pkg_ver + "|" + reg + "|" + use! util::list_get(fields 2) + "|" + use! util::list_get(fields 3) + "|" + use! util::list_get(fields 4) + "|" + use! util::list_get(fields 5) + "|" + use! util::list_get(fields 6) + "|" + use! util::list_get(fields 7) + "|" + use! util::list_get(fields 8) + "|" + use! util::list_get(fields 9) + "|" + use! util::list_get(fields 10)
                            }
                        }
                    }
                    set pi += 1
                }
                if best_rec != "" {
                    set bf = strings::split(best_rec "|")
                    return use! util::list_get(bf 0) + "|" + use! util::list_get(bf 1) + "|" + reg + "|" + use! util::list_get(bf 2) + "|" + use! util::list_get(bf 3) + "|" + use! util::list_get(bf 4) + "|" + use! util::list_get(bf 5) + "|" + use! util::list_get(bf 6) + "|" + use! util::list_get(bf 7) + "|" + use! util::list_get(bf 8) + "|" + use! util::list_get(bf 9) + "|" + use! util::list_get(bf 10)
                }
            }
        }
        set ri += 1
    }
    return ""
}

pub fn package: (name :str version :str no_verify :bool force :bool) :u8 {
    set info = use! install::index_lookup(name version)
    if info == "" {
        use dasu("  error: could not find package \"" + name + "\" in any configured registry")
        return 1 :u8
    }
    set f = strings::split(info "|")
    set p_name = strings::copy(use! util::list_get(f 0))
    set p_ver = strings::copy(use! util::list_get(f 1))
    set p_reg = strings::copy(use! util::list_get(f 2))
    set p_method = strings::copy(use! util::list_get(f 3))
    set p_repo = strings::copy(use! util::list_get(f 4))
    set p_ref = strings::copy(use! util::list_get(f 5))
    set p_commit = strings::copy(use! util::list_get(f 6))
    set p_tag = strings::copy(use! util::list_get(f 7))
    set p_asset = strings::copy(use! util::list_get(f 8))
    set p_tarball = strings::copy(use! util::list_get(f 9))
    set p_sha256 = strings::copy(use! util::list_get(f 10))
    set p_sha512 = strings::copy(use! util::list_get(f 11))

    set ver_dir = use! util::owl_home_lib_versioned(p_name p_ver)
    if fs::exists(ver_dir) && !force {
        use dasu("  already installed " + p_name + " v" + p_ver + " (use --force to reinstall)")
        return 0 :u8
    }

    if p_method == "clone" || p_repo != "" {
        return use! install::clone(p_name p_ver p_repo p_ref p_commit)
    }

    if p_sha256 == "" && p_sha512 == "" {
        use dasu("  error: registry entry for \"" + p_name + "\" has no SHA-256 or SHA-512 - refusing to install unverified package")
        return 1 :u8
    }

    set url = "" :str mut
    if p_repo != "" && p_tag != "" && p_asset != "" {
        if use! util::startswith(p_repo "http") {
            set url = p_repo + "/releases/download/" + p_tag + "/" + p_asset
        } else {
            set url = "https://github.com/" + p_repo + "/releases/download/" + p_tag + "/" + p_asset
        }
    } else {
        if p_tarball == "" {
            use dasu("  error: registry entry for \"" + p_name + "\" has no downloadable tarball")
            return 1 :u8
        }
        set reg_src_path = use! util::owl_home_registries() + "/" + p_reg + "/source_url"
        if !fs::exists(reg_src_path) {
            use dasu("  error: registry \"" + p_reg + "\" has no source_url")
            return 1 :u8
        }
        set src = use! util::trim(fs::read(reg_src_path))
        if src == "" {
            use dasu("  error: registry \"" + p_reg + "\" has an empty source_url")
            return 1 :u8
        }
        set url = src + "/" + p_tarball
    }

    use dasu("  downloading " + url + " ...")
    set cache_dir = use! util::owl_home_cache_tarballs()
    use! util::mkdir_p(cache_dir)
    set tarball_file = cache_dir + "/" + p_name + "-" + p_ver + ".tar.zst"
    use! util::rm_RF(tarball_file)
    set curl_args = [] :vec[str] mut
    set curl_args = vec::push::str(curl_args "-sL")
    set curl_args = vec::push::str(curl_args "--fail")
    set curl_args = vec::push::str(curl_args "-o")
    set curl_args = vec::push::str(curl_args strings::copy(tarball_file))
    set curl_args = vec::push::str(curl_args strings::copy(url))
    use proc::run::output("curl" curl_args)
    if !fs::exists(tarball_file) || use! util::file_size(tarball_file) == 0 {
        use dasu("  error: download failed")
        use! util::rm_RF(tarball_file)
        return 1 :u8
    }

    if p_sha256 != "" {
        set actual256 = use! util::sha256sum_hex(tarball_file)
        if actual256 != p_sha256 {
            use dasu("  error: SHA-256 mismatch (expected " + p_sha256 + ", got " + actual256 + ")")
            use! util::rm_RF(tarball_file)
            return 1 :u8
        }
        use dasu("  SHA-256 OK")
    }
    if p_sha512 != "" {
        set actual512 = use! util::sha512sum_hex(tarball_file)
        if actual512 != p_sha512 {
            use dasu("  error: SHA-512 mismatch")
            use! util::rm_RF(tarball_file)
            return 1 :u8
        }
        use dasu("  SHA-512 OK")
    }

    set sig_file = tarball_file + ".sig"
    set sig_url = url + ".sig"
    set sig_args = [] :vec[str] mut
    set sig_args = vec::push::str(sig_args "-sL")
    set sig_args = vec::push::str(sig_args "--fail")
    set sig_args = vec::push::str(sig_args "-o")
    set sig_args = vec::push::str(sig_args strings::copy(sig_file))
    set sig_args = vec::push::str(sig_args strings::copy(sig_url))
    use proc::run::output("curl" sig_args)

    set reg_json = use! util::owl_home_registries() + "/" + p_reg + "/registry.json"
    set pubkey = "" :str mut
    if fs::exists(reg_json) {
        set reg_content = fs::read(reg_json)
        set pubkey = use! util::json_get_str(reg_content "public-key")
    }
    if fs::exists(sig_file) {
        if pubkey != "" {
            if !use! crypto::verify::sigfile(strings::copy(pubkey) strings::copy(tarball_file) strings::copy(sig_file)) {
                use dasu("  error: Ed25519 signature verification failed")
                use! util::rm_RF(tarball_file)
                use! util::rm_RF(sig_file)
                return 1 :u8
            }
            use dasu("  Ed25519 signature OK")
        }
        use! util::rm_RF(sig_file)
    } else {
        if !no_verify && pubkey != "" {
            use dasu("  error: package signature missing - refusing unverified package")
            use! util::rm_RF(tarball_file)
            return 1 :u8
        }
    }

    use! util::mkdir_p(ver_dir)
    use dasu("  extracting...")
    if use! util::extract_archive(strings::copy(tarball_file) strings::copy(ver_dir)) != 0 {
        use dasu("  error: archive extraction failed")
        use! util::rm_RF(tarball_file)
        return 1 :u8
    }

    set meta_path = ver_dir + "/meta.toml"
    if !fs::exists(meta_path) {
        set meta = "[package]\n" :str mut
        set meta = meta + "name = \"" + p_name + "\"\n"
        set meta = meta + "version = \"" + p_ver + "\"\n"
        set meta = meta + "compiler = \"" + use! util::compiler_cmd() + "\"\n"
        set meta = meta + "abi = " + use! util::abi_version() + "\n"
        set meta = meta + "language = \"" + use! util::language_version() + "\"\n"
        use fs::write(meta_path meta)
    }

    use! util::fs_make_readonly(ver_dir)
    set active_link = use! util::owl_home_lib_active(p_name)
    if fs::exists(active_link) { fs::remove(active_link) }
    set ln_args = [] :vec[str] mut
    set ln_args = vec::push::str(ln_args "-sf")
    set ln_args = vec::push::str(ln_args p_name + "@" + p_ver)
    set ln_args = vec::push::str(ln_args strings::copy(active_link))
    use proc::run::output("ln" ln_args)
    use! util::rm_RF(tarball_file)
    use dasu("  installed " + p_name + " v" + p_ver)
    return 0 :u8
}

pub fn clone: (name :str version :str repo :str ref_val :str commit_val :str) :u8 {
    set ver_dir = use! util::owl_home_lib_versioned(name version)
    set ver_dir_copy = strings::copy(ver_dir)
    use! util::rm_RF(ver_dir_copy)
    use! util::mkdir_p(use! util::owl_home_libs())

    set clone_url = repo :str mut
    set abs_url = false :bool mut
    if use! util::startswith(repo "http") { set abs_url = true }
    if use! util::startswith(repo "file://") { set abs_url = true }
    if use! util::startswith(repo "/") { set abs_url = true }
    if !abs_url { set clone_url = "https://github.com/" + repo }

    /! Clone straight into the versioned directory. Git creates it itself (the
       parent exists), so there is no temp clone to move and no `.git` juggling. !/
    use dasu("  cloning " + clone_url + " ...")
    set git_args = [] :vec[str] mut
    set git_args = vec::push::str(git_args "clone")
    set git_args = vec::push::str(git_args "--depth")
    set git_args = vec::push::str(git_args "1")
    if ref_val != "" {
        set git_args = vec::push::str(git_args "--branch")
        set git_args = vec::push::str(git_args strings::copy(ref_val))
    }
    set git_args = vec::push::str(git_args strings::copy(clone_url))
    set git_args = vec::push::str(git_args strings::copy(ver_dir_copy))
    use proc::run::output("git" git_args)
    if use proc::run::last_exit() != 0 {
        use! util::rm_RF(ver_dir_copy)
        use dasu("  error: git clone failed")
        return 1 :u8
    }

    if commit_val != "" {
        set rev_args = [] :vec[str] mut
        set rev_args = vec::push::str(rev_args "-C")
        set rev_args = vec::push::str(rev_args strings::copy(ver_dir_copy))
        set rev_args = vec::push::str(rev_args "rev-parse")
        set rev_args = vec::push::str(rev_args "HEAD")
        set head = use! util::extract_git_head(rev_args ver_dir_copy)
        if head != commit_val {
            use! util::rm_RF(ver_dir_copy)
            use dasu("  error: cloned commit " + head + " does not match pinned commit " + commit_val)
            return 1 :u8
        }
        use dasu("  commit " + head + " verified")
    }

    set meta_path = ver_dir_copy + "/meta.toml"
    if !fs::exists(meta_path) {
        set meta = "[package]\n" :str mut
        set meta = meta + "name = \"" + name + "\"\n"
        set meta = meta + "version = \"" + version + "\"\n"
        set meta = meta + "compiler = \"" + use! util::compiler_cmd() + "\"\n"
        set meta = meta + "abi = " + use! util::abi_version() + "\n"
        set meta = meta + "language = \"" + use! util::language_version() + "\"\n"
        use fs::write(meta_path meta)
    }

    use! util::fs_make_readonly(ver_dir_copy)
    set active_link = use! util::owl_home_lib_active(name)
    if fs::exists(active_link) { fs::remove(active_link) }
    set link_target = name + "@" + version
    set ln_args = [] :vec[str] mut
    set ln_args = vec::push::str(ln_args "-sf")
    set ln_args = vec::push::str(ln_args link_target)
    set ln_args = vec::push::str(ln_args strings::copy(active_link))
    use proc::run::output("ln" ln_args)
    use dasu("  installed " + name + " v" + version + " (clone from " + repo + ")")
    return 0 :u8
}

pub fn target: (target_val :str named :str) {
    if len(named) > 0 {
        if !use! fs::exists(named) {
            use dasu(use! strings::concat("  error: binary not found at " named))
        } else {
            set cp_args = [] :vec[str] mut
            set cp_args = vec::push::str(cp_args use! strings::copy(named))
            set cp_args = vec::push::str(cp_args use! strings::copy(use! util::owl_home() + "/bin"))
            use proc::run::output("cp" cp_args)
            set chmod_args = [] :vec[str] mut
            set chmod_args = vec::push::str(chmod_args "+x")
            set chmod_args = vec::push::str(chmod_args use! strings::copy(named))
            use proc::run::output("chmod" chmod_args)
            use dasu("  installed to owl cache")
        }
    } else {
        if !use! util::has_project() {
            use dasu("  usage: owl install --target=d|r [bin-path]")
        } else {
            set profile = "debug" :str mut
            if target_val == "r" { set profile = "release" }
            set out_dir = use! util::toml_get("owl.toml" "paths" "output") :str mut
            if len(out_dir) == 0 { set out_dir = "bin" }
            set bin_path = use! strings::concat(out_dir "/") + profile
            if !use! fs::exists(bin_path) {
                use dasu(use! strings::concat(use! strings::concat("  error: no build output at " bin_path) " -- run owl build first"))
            } else {
                set dest_bin = use! util::owl_home() + "/bin"
                set ls_args = [] :vec[str] mut
                set ls_args = vec::push::str(ls_args "-1")
                set ls_args = vec::push::str(ls_args use! strings::copy(bin_path))
                set listing = use! util::list_text(bin_path)
                set files = use! util::split(listing "\n")
                set nf = len(files)
                set j = 0 :i64 mut
                while j < nf {
                    set fname = use! util::trim(use! util::list_get(files j))
                    if fname != "" {
                        set cp_args = [] :vec[str] mut
                        set cp_args = vec::push::str(cp_args use! strings::copy(use! strings::concat(bin_path "/") + fname))
                        set cp_args = vec::push::str(cp_args use! strings::copy(dest_bin))
                        use proc::run::output("cp" cp_args)
                    }
                    set j += 1
                }
                use dasu("  installed build artifacts to owl cache")
            }
        }
    }
}

pub fn run_simple: (args :&vec[str]) :u8 {
    set has_l = false :bool mut
    set has_t = false :bool mut
    set no_verify = false :bool mut
    set force = false :bool mut
    set target_val = "" :str mut
    set yes = false :bool mut
    set name = "" :str mut
    set ver = "" :str mut
    set has_lock = false :bool mut
    
    set n = use! vec::len(args)
    // `args` is the raw process argv: index 0 is the executable and index 1 is
    // the subcommand ("install"). Positional package names start at index 2.
    set i = 2 :i64 mut
    while i < n {
        set a = use! vec::get::str(args i)
        set matched = false :bool mut
        if a == "-l" || a == "--lock" { 
            set has_lock = true
            set matched = true 
        }
        if !matched && (a == "-l" || a == "--list") { 
            set has_l = true
            set matched = true 
        }
        if !matched && (a == "-t" || a == "--target") { 
            set i += 1
            if i < n { set target_val = use! vec::get::str(args i) }
            set matched = true 
        }
        if !matched && a == "--no-verify" { 
            set no_verify = true
            set matched = true 
        }
        if !matched && (a == "-f" || a == "--force") { 
            set force = true
            set matched = true 
        }
        if !matched && (a == "-y" || a == "--yes") { 
            set yes = true
            set matched = true 
        }
        if !matched && !use! util::startswith(a "-") { 
            if name == "" { set name = a } else { if ver == "" { set ver = a } }
            set matched = true 
        }
        set i += 1
    }
    
    return use! install::run(has_l has_t no_verify force target_val yes name ver has_lock)
}
