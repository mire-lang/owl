module install

load! /code/util
load! /code/semver
load! /code/lockfile

extern fn owl_archive_extract: (input :&str destination :&str) :i32 lib "c"

pub fn run: (has_l :bool has_t :bool no_verify :bool force :bool target_val :str yes :bool name :str ver :str has_lock :bool) :u8 {
    set ec = 0 :u8 mut
    use! util::mkdir_p(use! util::cfg::home())
    if has_lock {
        if use! lockfile::in_sync() {
            use! lockfile::all()
        } else {
            use dasu("  owl.lock does not match owl.toml")
            use dasu("  run 'owl install' to resolve dependencies, then retry with --lock")
            set ec = 1 :u8
        }
        return ec
    }
    if has_l {
        use! install::list()
    } else {
        set is_empty = len(name) == 0
        if is_empty {
            if has_t { use dasu("Usage: owl install -t <name>") } else {
                use dasu("  resolving dependencies from owl.toml ...")
                set regenerated = use! lockfile::generate()
                if regenerated {
                    use dasu("  owl.lock updated")
                    use! lockfile::all()
                } else {
                    use dasu("  error: could not generate owl.lock")
                    set ec = 1 :u8
                }
            }
        } else {
            set version = ver :str mut
            if len(version) == 0 || version == "*" { set version = "latest" }
            set ec = use! install::package(name version no_verify force)
        }
    }
    return ec
}

pub fn list: () {
    set reg_dir = use! util::owl_home_registries()
    set reg_arg = strings::copy(reg_dir)
    set reg_list = use! util::list_text(reg_arg)
    if len(reg_list) == 0 {
        use dasu("  no registries configured -- run: owl reg add <registry-url>")
    } else {
        use dasu("  available packages:")
        set entries = use! util::split(reg_list "\n")
        set ni = len(entries)
        set i_reg = 0 :i64 mut
        while i_reg < ni {
            set reg_name = use! util::trim(use! util::list_get(entries i_reg))
            if len(reg_name) > 0 {
                set idx_path = reg_dir + "/" + reg_name + "/index.toml"
                set content = fs::read(idx_path)
                if len(content) > 0 {
                    set lines = use! semver::count_lines(content)
                    set in_pkg = false :bool mut
                    set cur_name = "" :str mut
                    set cur_ver = "" :str mut
                    set i = 0 :i64 mut
                    while i < lines {
                        set line = use! util::trim(use! semver::nth_line(content i))
                        if line == "[[packages]]" {
                            if in_pkg && len(cur_name) > 0 {
                                use dasu("  " + reg_name + " / " + cur_name + " v" + cur_ver)
                            }
                            set in_pkg = true
                            set cur_name = ""
                            set cur_ver = ""
                        } else {
                            if in_pkg {
                                if use! util::startswith(line "name =") { set cur_name = use! semver::extract_str_val(line) }
                                if use! util::startswith(line "version =") { set cur_ver = use! semver::extract_str_val(line) }
                            }
                        }
                        set i += 1
                    }
                    if in_pkg && len(cur_name) > 0 {
                        use dasu("  " + reg_name + " / " + cur_name + " v" + cur_ver)
                    }
                }
            }
            set i_reg += 1
        }
    }
}

pub fn package: (name :str version :str no_verify :bool force :bool) :u8 {
    set ec = 0 :u8 mut
    set resolved = use! semver::resolve_from_registry(name version)
    set pkg_ver = version :str mut
    if resolved != "" { set pkg_ver = resolved }

    set pkg_info = "" :str mut
    set pkg_name = name :str

    set reg_dir = use! util::owl_home_registries()
    set reg_arg2 = strings::copy(reg_dir)
    set reg_list = use! util::list_text(reg_arg2)
    if reg_list != "" {
        set entries = use! util::split(reg_list "\n")
        set ni = len(entries)
        set i_reg = 0 :i64 mut
        while i_reg < ni {
            set reg_name = use! util::trim(use! util::list_get(entries i_reg))
            if pkg_info != "" { break }
            if len(reg_name) > 0 {
                set idx_path = reg_dir + "/" + reg_name + "/index.toml"
                set idx_content = fs::read(idx_path)
set grep_pattern = "^name = \"" + pkg_name + "\""
                set found_name_match = false :bool mut
                set glines = strings::split(idx_content "\n")
                set gnl = len(glines)
                set gi = 0 :i64 mut
                set found_tarball = "" :str mut
                set found_sha = "" :str mut
                set found_sha512 = "" :str mut
                set found_method = "" :str mut
                set found_repo = "" :str mut
                set found_tag = "" :str mut
                set found_asset = "" :str mut
                set found_ref = "" :str mut
                set found_commit = "" :str mut
                set in_pkg = false :bool mut
                while gi < gnl {
                    set gline = use! util::trim(use! util::list_get(glines gi))
                    set eq = strings::index(gline "=")
                    if eq > 0 {
                        set after = strings::substr(gline eq + 1 9999) :str mut
                        set after = use! util::trim(after)
                        if use! util::startswith(after "\"") && use! util::endswith(after "\"") {
                            set after = strings::substr(after 1 strings::len(after) - 2)
                        } else {
                            if use! util::startswith(after "\"") { set after = strings::substr(after 1 9999) }
                        }
                        if use! util::startswith(gline "name = ") {
                            if after == pkg_name {
                                set in_pkg = true
                                set found_name_match = true
                            } else {
                                set in_pkg = false
                            }
                        }
                        if in_pkg {
                            if use! util::startswith(gline "tarball = ") { set found_tarball = after }
                            if use! util::startswith(gline "sha256 = ") { set found_sha = after }
                            if use! util::startswith(gline "sha512 = ") { set found_sha512 = after }
                            if use! util::startswith(gline "method = ") { set found_method = after }
                            if use! util::startswith(gline "repo = ") { set found_repo = after }
                            if use! util::startswith(gline "tag = ") { set found_tag = after }
                            if use! util::startswith(gline "asset = ") { set found_asset = after }
                            if use! util::startswith(gline "ref = ") { set found_ref = after }
                            if use! util::startswith(gline "commit = ") { set found_commit = after }
                        }
                    }
                    set gi += 1
                }
                if found_tarball != "" || found_method == "clone" || found_repo != "" {
                    set pkg_info = found_tarball + "|" + found_sha + "|" + found_sha512 + "|" + reg_name + "|" + found_method + "|" + found_repo + "|" + found_tag + "|" + found_asset + "|" + found_ref + "|" + found_commit
                }
                }
            }
            set i_reg += 1
        }

    if ec == 0 && pkg_info == "" {
        use dasu("  error: could not find package \"" + pkg_name + "\" in any registry")
        set ec = 1 :u8
    }

    set tarball_path = "" :str mut
    set sha256_val = "" :str mut
    set sha512_val = "" :str mut
    set reg_name = "" :str mut
    set method = "" :str mut
    set repo = "" :str mut
    set tag = "" :str mut
    set asset = "" :str mut
    set ref_val = "" :str mut
    set commit_val = "" :str mut
    if ec == 0 {
        set pipe1 = strings::index(pkg_info "|")
        if pipe1 < 0 {
            use dasu("  error: invalid package info from registry")
            set ec = 1 :u8
        } else {
            set fields = strings::split(pkg_info "|")
            set nf = len(fields)
            if nf >= 1 { set tarball_path = use! util::list_get(fields 0) }
            if nf >= 2 { set sha256_val = use! util::list_get(fields 1) }
            if nf >= 3 { set sha512_val = use! util::list_get(fields 2) }
            if nf >= 4 { set reg_name = use! util::list_get(fields 3) }
            if nf >= 5 { set method = use! util::list_get(fields 4) }
            if nf >= 6 { set repo = use! util::list_get(fields 5) }
            if nf >= 7 { set tag = use! util::list_get(fields 6) }
            if nf >= 8 { set asset = use! util::list_get(fields 7) }
            if nf >= 9 { set ref_val = use! util::list_get(fields 8) }
            if nf >= 10 { set commit_val = use! util::list_get(fields 9) }
        }
    }

    if ec == 0 && method == "clone" {
        set clone_name = use! util::copy_value(pkg_name)
        set clone_version = use! util::copy_value(pkg_ver)
        set clone_repo = use! util::copy_value(repo)
        set clone_ref = use! util::copy_value(ref_val)
        set clone_commit = use! util::copy_value(commit_val)
        return use! install::clone(clone_name clone_version clone_repo clone_ref clone_commit)
    }

    set reg_url = "" :str mut
    if ec == 0 && fs::exists(reg_dir + "/" + reg_name + "/registry.json") {
        set reg_content = fs::read(reg_dir + "/" + reg_name + "/registry.json")
        set reg_url = use! util::json_get_str(reg_content "url") :str mut
        if reg_url == "" {
            set reg_url = use! util::json_get_str(reg_content "name")
        }
    }
    if ec == 0 && reg_url == "" {
        use dasu("  error: could not determine URL for registry \"" + reg_name + "\"")
        set ec = 1 :u8
    }

    set tarball_url = "" :str mut
    set tarball_file = "" :str mut
    if ec == 0 {
        if repo != "" && tag != "" && asset != "" {
            if use! util::startswith(repo "http") {
                set tarball_url = repo + "/releases/download/" + tag + "/" + asset
            } else {
                set tarball_url = "https://github.com/" + repo + "/releases/download/" + tag + "/" + asset
            }
        } else {
            set tarball_url = reg_url + "/" + tarball_path
        }
        use dasu("  downloading from " + tarball_url + "...")
        set tarball_file = use! util::owl_home() + "/cache/tarballs/" + pkg_name + "-" + pkg_ver + ".tar.zst"
        use! util::mkdir_p(use! util::owl_home() + "/cache/tarballs")
        set curl_args = [] :vec[str] mut
        set curl_args = vec::push::str(curl_args "-sL")
        set curl_args = vec::push::str(curl_args "--fail")
        set curl_args = vec::push::str(curl_args "-o")
        set curl_args = vec::push::str(curl_args strings::copy(tarball_file))
        set curl_args = vec::push::str(curl_args strings::copy(tarball_url))
        use proc::run::output("curl" curl_args)

        if !fs::exists(tarball_file) {
            use dasu("  error: download failed")
            set ec = 1 :u8
        }
    }

    if ec == 0 {
        set tarball_arg = strings::copy(tarball_file)
        set file_size = use! util::file_size(tarball_arg)
        if file_size == 0 {
            set rm1 = [] :vec[str] mut
            set rm1 = vec::push::str(rm1 "-f")
            set rm1 = vec::push::str(rm1 strings::copy(tarball_file))
            use! util::rm_RF(tarball_file)
            use dasu("  error: download failed (empty file)")
            set ec = 1 :u8
        }
    }

    if ec == 0 {
        if sha256_val == "" && sha512_val == "" {
            set rm2 = [] :vec[str] mut
            set rm2 = vec::push::str(rm2 "-f")
            set rm2 = vec::push::str(rm2 strings::copy(tarball_file))
            use! util::rm_RF(tarball_file)
            use dasu("  error: registry entry for \"" + pkg_name + "\" has no SHA-256 or SHA-512 - refusing to install unverified package")
            set ec = 1 :u8
        } else {
            /! The registry is authoritative. When it publishes both hashes,
               both must match; when it publishes one, that one is sufficient.
               publish.toml is never used as a substitute for this check. !/
            if sha256_val != "" {
                use dasu("  verifying registry SHA-256...")
                set actual256 = use! util::sha256sum_hex(tarball_file)
                if actual256 == "" || actual256 != sha256_val {
                    use dasu("  error: registry SHA-256 mismatch")
                    use dasu("    expected: " + sha256_val)
                    use dasu("    actual:   " + actual256)
                    set ec = 1 :u8
                } else {
                    use dasu("  registry SHA-256 OK")
                }
            }
            if ec == 0 && sha512_val != "" {
                use dasu("  verifying registry SHA-512...")
                set actual512 = use! util::sha512sum_hex(tarball_file)
                if actual512 == "" || actual512 != sha512_val {
                    use dasu("  error: registry SHA-512 mismatch")
                    use dasu("    expected: " + sha512_val)
                    use dasu("    actual:   " + actual512)
                    set ec = 1 :u8
                } else {
                    use dasu("  registry SHA-512 OK")
                }
            }
        }
    }

    if ec == 0 {
        set sig_url = tarball_url + ".sig"
        set sig_file = tarball_file + ".sig"
        set curl_sig = [] :vec[str] mut
        set curl_sig = vec::push::str(curl_sig "-sL")
        set curl_sig = vec::push::str(curl_sig "--fail")
        set curl_sig = vec::push::str(curl_sig "-o")
        set curl_sig = vec::push::str(curl_sig strings::copy(sig_file))
        set curl_sig = vec::push::str(curl_sig strings::copy(sig_url))
        use proc::run::output("curl" curl_sig)
        if fs::exists(sig_file) {
            set pubkey = "" :str mut
            if fs::exists(reg_dir + "/" + reg_name + "/registry.json") {
                set reg_content = fs::read(reg_dir + "/" + reg_name + "/registry.json")
                set pubkey = use! util::json_get_str(reg_content "public-key") :str mut
            }
            if pubkey == "" {
                set rm5 = [] :vec[str] mut
                set rm5 = vec::push::str(rm5 "-f")
                set rm5 = vec::push::str(rm5 strings::copy(tarball_file))
                set rm5b = [] :vec[str] mut
                set rm5b = vec::push::str(rm5b "-f")
                set rm5b = vec::push::str(rm5b strings::copy(sig_file))
                use! util::rm_RF(tarball_file)
                use! util::rm_RF(sig_file)
                use dasu("  error: no public-key for registry \"" + reg_name + "\" - refusing to install signed package without verification")
                set ec = 1 :u8
            } else {
                use dasu("  verifying Ed25519 signature...")
                set tf_copy = strings::copy(tarball_file)
                set sf_copy = strings::copy(sig_file)
                if !use! crypto::verify::sigfile(pubkey tf_copy sf_copy) {
                    set rm6 = [] :vec[str] mut
                    set rm6 = vec::push::str(rm6 "-f")
                    set rm6 = vec::push::str(rm6 strings::copy(tarball_file))
                    set rm6b = [] :vec[str] mut
                    set rm6b = vec::push::str(rm6b "-f")
                    set rm6b = vec::push::str(rm6b strings::copy(sig_file))
                    use! util::rm_RF(tarball_file)
                    use! util::rm_RF(sig_file)
                    use dasu("  error: Ed25519 signature verification failed")
                    set ec = 1 :u8
                } else {
                    use dasu("  Ed25519 signature OK")
                }
            }
            set rm7 = [] :vec[str] mut
            set rm7 = vec::push::str(rm7 "-f")
            set rm7 = vec::push::str(rm7 strings::copy(sig_file))
            use! util::rm_RF(sig_file)
        } else {
            if !no_verify {
                set rm8 = [] :vec[str] mut
                set rm8 = vec::push::str(rm8 "-f")
                set rm8 = vec::push::str(rm8 strings::copy(tarball_file))
                use! util::rm_RF(tarball_file)
                use dasu("  error: package signature missing - refusing unverified package")
                set ec = 1 :u8
            }
        }
    }

    if ec == 0 {
        set meta_path = use! util::owl_home_libs() + "/" + pkg_name + "/meta.toml"
        use! util::mkdir_p(use! util::owl_home_libs() + "/" + pkg_name)

        use dasu("  extracting...")
        set destination = use! util::owl_home_libs() + "/" + pkg_name
        if owl_archive_extract(tarball_file destination) != 0 {
            use dasu("  error: libarchive/zstd extraction failed")
            set ec = 1 :u8
        }

        if ec == 0 && !fs::exists(meta_path) {
            use dasu("  writing metadata...")
            set meta = "[package]\n" :str mut
            set meta = meta + "name = \"" + pkg_name + "\"\n"
            set meta = meta + "version = \"" + pkg_ver + "\"\n"
            set meta = meta + "compiler = \"" + use! util::compiler_cmd() + "\"\n"
            set meta = meta + "abi = " + use! util::abi_version() + "\n"
            set meta = meta + "language = \"" + use! util::language_version() + "\"\n"
            use fs::write(use! util::owl_home_libs() + "/" + pkg_name + "/meta.toml" meta)
        }

        use! util::fs_make_readonly(use! util::owl_home_libs() + "/" + pkg_name)
        set installed_path = use! util::owl_home_libs() + "/" + pkg_name
        set verified = true :bool mut
        if no_verify { set verified = false }
        set cfg_name = strings::copy(pkg_name)
        set cfg_ver = strings::copy(pkg_ver)
        set cfg_reg = strings::copy(reg_name)
        use! util::cfg::write(cfg_name cfg_ver installed_path sha256_val cfg_reg verified)
        set rm8 = [] :vec[str] mut
        set rm8 = vec::push::str(rm8 "-f")
        set rm8 = vec::push::str(rm8 strings::copy(tarball_file))
        use! util::rm_RF(tarball_file)
        use dasu("  installed " + pkg_name + " v" + pkg_ver)
    }
    return ec
}

pub fn clone: (name :str version :str repo :str ref_val :str commit_val :str) :u8 {
    set ec = 0 :u8 mut
    set libs_dir = use! util::owl_home_libs()
    set libs_dir_copy = strings::copy(libs_dir)
    use! util::mkdir_p(libs_dir)
    set dest = libs_dir_copy + "/" + name
    set dest_copy = strings::copy(dest)
    if fs::exists(strings::copy(dest_copy)) {
        set cleanup_path = strings::copy(dest_copy)
        use! util::rm_RF(cleanup_path)
    }

    use dasu("  cloning " + repo + " ...")
    set clone_url = repo :str mut
    set abs_url = false :bool mut
    if use! util::startswith(repo "http") { set abs_url = true }
    if use! util::startswith(repo "file://") { set abs_url = true }
    if use! util::startswith(repo "/") { set abs_url = true }
    if !abs_url {
        set clone_url = "https://github.com/" + repo
    }
    set git_args = [] :vec[str] mut
    set git_args = vec::push::str(git_args "clone")
    set git_args = vec::push::str(git_args "--depth")
    set git_args = vec::push::str(git_args "1")
    if ref_val != "" {
        set git_args = vec::push::str(git_args "--branch")
        set git_args = vec::push::str(git_args strings::copy(ref_val))
    }
    set git_args = vec::push::str(git_args strings::copy(clone_url))
    set git_args = vec::push::str(git_args strings::copy(dest_copy))
    use proc::run::output("git" git_args)
    if use proc::run::last_exit() != 0 {
        use dasu("  error: git clone failed")
        return 1 :u8
    }

    if commit_val != "" {
        set rev_args = [] :vec[str] mut
        set rev_args = vec::push::str(rev_args "-C")
        set rev_args = vec::push::str(rev_args strings::copy(dest_copy))
        set rev_args = vec::push::str(rev_args "rev-parse")
        set rev_args = vec::push::str(rev_args "HEAD")
        set head = use! util::extract_git_head(rev_args dest_copy)
        if head != commit_val {
            set cleanup_path2 = strings::copy(dest_copy)
            use! util::rm_RF(cleanup_path2)
            use dasu("  error: cloned commit " + head + " does not match pinned commit " + commit_val)
            return 1 :u8
        }
        use dasu("  commit " + head + " verified")
    }

    set meta_path = strings::copy(dest_copy) + "/meta.toml"
    if !fs::exists(strings::copy(meta_path)) {
        use dasu("  writing metadata...")
        set meta = "[package]\n" :str mut
        set meta = meta + "name = \"" + name + "\"\n"
        set meta = meta + "version = \"" + version + "\"\n"
        set meta = meta + "compiler = \"" + use! util::compiler_cmd() + "\"\n"
        set meta = meta + "abi = " + use! util::abi_version() + "\n"
        set meta = meta + "language = \"" + use! util::language_version() + "\"\n"
        use fs::write(meta_path meta)
    }

    set readonly_dest = strings::copy(dest_copy)
    use! util::fs_make_readonly(readonly_dest)
    use dasu("  installed " + name + " v" + version + " (clone from " + repo + ")")
    return ec
}

pub fn target: (target_val :str named :str) {
    if len(named) > 0 {
        if !fs::exists(named) {
            use dasu("  error: binary not found at " + named)
        } else {
            set cp_args = [] :vec[str] mut
            set cp_args = vec::push::str(cp_args strings::copy(named))
            set cp_args = vec::push::str(cp_args strings::copy(use! util::owl_home() + "/bin"))
            use proc::run::output("cp" cp_args)
            set chmod_args = [] :vec[str] mut
            set chmod_args = vec::push::str(chmod_args "+x")
            set chmod_args = vec::push::str(chmod_args strings::copy(named))
            use proc::run::output("chmod" chmod_args)
            use dasu("  installed to owl cache")
        }
    } else {
        if !use! util::has_project() {
            use dasu("  usage: owl install --target=d|r [bin-path]")
        } else {
            set profile = "debug" :str mut
            if target_val == "r" { set profile = "release" }
            set out_dir = use! util::toml_get("owl.toml" "paths" "output") :str mut
            if len(out_dir) == 0 { set out_dir = "bin" }
            set bin_path = out_dir + "/" + profile
            if !fs::exists(bin_path) {
                use dasu("  error: no build output at " + bin_path + " -- run owl build first")
            } else {
                set dest_bin = use! util::owl_home() + "/bin"
                set ls_args = [] :vec[str] mut
                set ls_args = vec::push::str(ls_args "-1")
                set ls_args = vec::push::str(ls_args strings::copy(bin_path))
                set listing = use! util::list_text(bin_path)
                set files = use! util::split(listing "\n")
                set nf = len(files)
                set j = 0 :i64 mut
                while j < nf {
                    set fname = use! util::trim(use! util::list_get(files j))
                    if fname != "" {
                        set cp_args = [] :vec[str] mut
                        set cp_args = vec::push::str(cp_args strings::copy(bin_path + "/" + fname))
                        set cp_args = vec::push::str(cp_args strings::copy(dest_bin))
                        use proc::run::output("cp" cp_args)
                    }
                    set j += 1
                }
                use dasu("  installed build artifacts to owl cache")
            }
        }
    }
}
