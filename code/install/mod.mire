load! /code/util
load! /code/crypto
load! /code/semver
load! /code/lockfile

pub fn cmd_install: (has_l :bool has_t :bool no_verify :bool force :bool target_val :str yes :bool name :str ver :str has_lock :bool) :u8 {
    set ec = 0 :u8 mut
    if has_lock {
        use! lockfile::lockfile_install_all()
        return ec
    }
    if has_l {
        use! install::cmd_list_packages()
    } else {
        set is_empty = len(name) == 0
        if is_empty {
            if has_t { use dasu("Usage: owl install -t <name>") } else {
                if target_val == "d" || target_val == "r" { use! install::cmd_target_install(target_val "") } else {
                    use dasu("Usage: owl install [-l] [-t] [--lock] [--target=d|r] <name> [version]")
                    use dasu("  -l, --list   List packages from all registries")
                    use dasu("  -t, --test   Test install")
                    use dasu("  --lock       Install all packages from owl.lock")
                    use dasu("  --target=d|r Install compiled binary to owl cache")
                }
            }
        } else {
            set version = ver :str mut
            if len(version) == 0 || version == "*" { set version = "latest" }
            set ec = use! install::cmd_install_pkg(name version no_verify force)
        }
    }
    return ec
}

pub fn cmd_list_packages: () {
    set reg_dir = use! util::owl_home_registries()
    set reg_list = use! util::trim(proc::run::output("ls" ["-1" strings::copy(reg_dir)]))
    if len(reg_list) == 0 {
        use dasu("  no registries configured -- run: owl load --url <registry-url>")
    } else {
        use dasu("  available packages:")
        set entries = use! util::split(reg_list "\n")
        set ni = len(entries)
        set i_reg = 0 :i64 mut
        while i_reg < ni {
            set reg_name = use! util::trim(use! util::list_get(entries i_reg))
            if len(reg_name) > 0 {
                set idx_path = reg_dir + "/" + reg_name + "/index.toml"
                set content = fs::read(idx_path)
                if len(content) > 0 {
                    set lines = use! semver::count_lines(content)
                    set in_pkg = false :bool mut
                    set cur_name = "" :str mut
                    set cur_ver = "" :str mut
                    set i = 0 :i64 mut
                    while i < lines {
                        set line = use! util::trim(use! semver::nth_line(content i))
                        if line == "[[packages]]" {
                            if in_pkg && len(cur_name) > 0 {
                                use dasu("  " + reg_name + " / " + cur_name + " v" + cur_ver)
                            }
                            set in_pkg = true
                            set cur_name = ""
                            set cur_ver = ""
                        } else {
                            if in_pkg {
                                if use! util::startswith(line "name =") { set cur_name = use! semver::extract_str_val(line) }
                                if use! util::startswith(line "version =") { set cur_ver = use! semver::extract_str_val(line) }
                            }
                        }
                        set i += 1
                    }
                    if in_pkg && len(cur_name) > 0 {
                        use dasu("  " + reg_name + " / " + cur_name + " v" + cur_ver)
                    }
                }
            }
            set i_reg += 1
        }
    }
}

pub fn cmd_install_pkg: (name :str version :str no_verify :bool force :bool) :u8 {
    set ec = 0 :u8 mut
    set no_verify = false
    set resolved = use! semver::resolve_from_registry(name version)
    set pkg_ver = version :str mut
    if resolved != "" { set pkg_ver = resolved }

    set pkg_info = "" :str mut
    set pkg_name = name :str

    set reg_dir = use! util::owl_home_registries()
    set reg_list = use! util::trim(proc::run::output("ls" ["-1" strings::copy(reg_dir)]))
    if reg_list != "" {
        set entries = use! util::split(reg_list "\n")
        set ni = len(entries)
        set i_reg = 0 :i64 mut
        while i_reg < ni {
            set reg_name = use! util::trim(use! util::list_get(entries i_reg))
            if pkg_info != "" { break }
            if len(reg_name) > 0 {
                set idx_path = reg_dir + "/" + reg_name + "/index.toml"
                set idx_content = fs::read(idx_path)
                set grep_pattern = "^name = \"" + pkg_name + "\""
                set gargs = [] :vec[str] mut
                set gargs = vec::push::str(gargs "-A10")
                set gargs = vec::push::str(gargs strings::copy(grep_pattern))
                set gargs = vec::push::str(gargs strings::copy(idx_path))
                set grep_out = use! util::trim(proc::run::output("grep" gargs))
                if grep_out != "" {
                    set glines = strings::split(grep_out "\n")
                    set gnl = len(glines)
                    set gi = 0 :i64 mut
                    set found_tarball = "" :str mut
                    set found_sha = "" :str mut
                    while gi < gnl {
                        set gline = use! util::trim(use! util::list_get(glines gi))
                        if use! util::startswith(gline "tarball = ") {
                            set eq = strings::index(gline "=")
                            if eq >= 0 {
                                set after = strings::substr(gline eq + 1 9999) :str mut
                                set after = use! util::trim(after)
                                if use! util::startswith(after "\"") { set after = use! util::replace(after "\"" "") }
                                set found_tarball = after
                            }
                        }
                        if use! util::startswith(gline "sha256 = ") {
                            set eq = strings::index(gline "=")
                            if eq >= 0 {
                                set after = strings::substr(gline eq + 1 9999) :str mut
                                set after = use! util::trim(after)
                                if use! util::startswith(after "\"") { set after = use! util::replace(after "\"" "") }
                                set found_sha = after
                            }
                        }
                        set gi += 1
                    }
                    if found_tarball != "" {
                        set pkg_info = found_tarball + "|" + found_sha + "|" + reg_name
                    }
                }
            }
            set i_reg += 1
        }
    }

    if ec == 0 && pkg_info == "" {
        use dasu("  error: could not find package \"" + pkg_name + "\" in any registry")
        set ec = 1 :u8
    }

    if ec == 0 {
        set pipe1 = strings::index(pkg_info "|")
        if pipe1 < 0 {
            use dasu("  error: invalid package info from registry")
            set ec = 1 :u8
        }
    }
    set tarball_path = "" :str mut
    set sha256_val = "" :str mut
    set reg_name = "" :str mut
    if ec == 0 {
        set pipe1 = strings::index(pkg_info "|")
        set pipe2 = strings::index(strings::substr(pkg_info pipe1 + 1 9999) "|")
        if pipe2 < 0 {
            use dasu("  error: invalid package info from registry (missing sha256 or reg)")
            set ec = 1 :u8
        } else {
            set tarball_path = strings::substr(pkg_info 0 pipe1)
            set sha256_val = strings::substr(pkg_info pipe1 + 1 pipe2)
            set reg_name = strings::substr(pkg_info pipe1 + pipe2 + 2 9999)
        }
    }

    set reg_url = "" :str mut
    if ec == 0 && fs::exists(reg_dir + "/" + reg_name + "/registry.json") {
        set reg_content = fs::read(reg_dir + "/" + reg_name + "/registry.json")
        set reg_url = use! util::json_get_str(reg_content "url") :str mut
        if reg_url == "" {
            set reg_url = use! util::json_get_str(reg_content "name")
        }
    }
    if ec == 0 && reg_url == "" {
        use dasu("  error: could not determine URL for registry \"" + reg_name + "\"")
        set ec = 1 :u8
    }

    set tarball_url = "" :str mut
    set tarball_file = "" :str mut
    if ec == 0 {
        set tarball_url = reg_url + "/" + tarball_path
        use dasu("  downloading from " + tarball_url + "...")
        set tarball_file = use! util::owl_home() + "/cache/tarballs/" + pkg_name + "-" + pkg_ver + ".tar.zst"
        use! util::mkdir_p(use! util::owl_home() + "/cache/tarballs")
        set curl_args = [] :vec[str] mut
        set curl_args = vec::push::str(curl_args "-sL")
        set curl_args = vec::push::str(curl_args "--fail")
        set curl_args = vec::push::str(curl_args "-o")
        set curl_args = vec::push::str(curl_args strings::copy(tarball_file))
        set curl_args = vec::push::str(curl_args strings::copy(tarball_url))
        use proc::run::output("curl" curl_args)

        if !fs::exists(tarball_file) {
            use dasu("  error: download failed")
            set ec = 1 :u8
        }
    }

    if ec == 0 {
        set file_size = use! util::trim(proc::run::output("stat" ["-c" "%s" strings::copy(tarball_file)]))
        if file_size == "0" {
            set rm1 = [] :vec[str] mut
            set rm1 = vec::push::str(rm1 "-f")
            set rm1 = vec::push::str(rm1 strings::copy(tarball_file))
            use proc::run::output("rm" rm1)
            use dasu("  error: download failed (empty file)")
            set ec = 1 :u8
        }
    }

    if ec == 0 {
        if sha256_val == "" {
            set rm2 = [] :vec[str] mut
            set rm2 = vec::push::str(rm2 "-f")
            set rm2 = vec::push::str(rm2 strings::copy(tarball_file))
            use proc::run::output("rm" rm2)
            use dasu("  error: registry entry for \"" + pkg_name + "\" has no sha256 - refusing to install unverified package")
            set ec = 1 :u8
        } else {
            use dasu("  verifying SHA-256...")
            set actual = use! util::sha256sum_hex(tarball_file)
            if actual == "" {
                set rm3 = [] :vec[str] mut
                set rm3 = vec::push::str(rm3 "-f")
                set rm3 = vec::push::str(rm3 strings::copy(tarball_file))
                use proc::run::output("rm" rm3)
                use dasu("  error: could not compute SHA-256 (sha256sum missing) - refusing to install unverified package")
                set ec = 1 :u8
            } else {
                if actual != sha256_val {
                    set rm4 = [] :vec[str] mut
                    set rm4 = vec::push::str(rm4 "-f")
                    set rm4 = vec::push::str(rm4 strings::copy(tarball_file))
                    use proc::run::output("rm" rm4)
                    use dasu("  error: SHA-256 mismatch")
                    use dasu("    expected: " + sha256_val)
                    use dasu("    actual:   " + actual)
                    set ec = 1 :u8
                } else {
                    use dasu("  SHA-256 OK")
                }
            }
        }
    }

    if ec == 0 {
        set sig_url = tarball_url + ".sig"
        set sig_file = tarball_file + ".sig"
        set curl_sig = [] :vec[str] mut
        set curl_sig = vec::push::str(curl_sig "-sL")
        set curl_sig = vec::push::str(curl_sig "--fail")
        set curl_sig = vec::push::str(curl_sig "-o")
        set curl_sig = vec::push::str(curl_sig strings::copy(sig_file))
        set curl_sig = vec::push::str(curl_sig strings::copy(sig_url))
        use proc::run::output("curl" curl_sig)
        if fs::exists(sig_file) {
            set pubkey = "" :str mut
            if fs::exists(reg_dir + "/" + reg_name + "/registry.json") {
                set reg_content = fs::read(reg_dir + "/" + reg_name + "/registry.json")
                set pubkey = use! util::json_get_str(reg_content "public-key") :str mut
            }
            if pubkey == "" {
                set rm5 = [] :vec[str] mut
                set rm5 = vec::push::str(rm5 "-f")
                set rm5 = vec::push::str(rm5 strings::copy(tarball_file))
                set rm5b = [] :vec[str] mut
                set rm5b = vec::push::str(rm5b "-f")
                set rm5b = vec::push::str(rm5b strings::copy(sig_file))
                use proc::run::output("rm" rm5)
                use proc::run::output("rm" rm5b)
                use dasu("  error: no public-key for registry \"" + reg_name + "\" - refusing to install signed package without verification")
                set ec = 1 :u8
            } else {
                use dasu("  verifying Ed25519 signature...")
                set tf_copy = strings::copy(tarball_file)
                set sf_copy = strings::copy(sig_file)
                if !use! crypto::crypto_verify_ed25519_sigfile(pubkey tf_copy sf_copy) {
                    set rm6 = [] :vec[str] mut
                    set rm6 = vec::push::str(rm6 "-f")
                    set rm6 = vec::push::str(rm6 strings::copy(tarball_file))
                    set rm6b = [] :vec[str] mut
                    set rm6b = vec::push::str(rm6b "-f")
                    set rm6b = vec::push::str(rm6b strings::copy(sig_file))
                    use proc::run::output("rm" rm6)
                    use proc::run::output("rm" rm6b)
                    use dasu("  error: Ed25519 signature verification failed")
                    set ec = 1 :u8
                } else {
                    use dasu("  Ed25519 signature OK")
                }
            }
            set rm7 = [] :vec[str] mut
            set rm7 = vec::push::str(rm7 "-f")
            set rm7 = vec::push::str(rm7 strings::copy(sig_file))
            use proc::run::output("rm" rm7)
        }
    }

    if ec == 0 {
        set meta_path = use! util::owl_home_libs() + "/" + pkg_name + "/meta.toml"
        use! util::mkdir_p(use! util::owl_home_libs() + "/" + pkg_name)

        use dasu("  extracting...")
        set tar_args = [] :vec[str] mut
        set tar_args = vec::push::str(tar_args "-xzf")
        set tar_args = vec::push::str(tar_args strings::copy(tarball_file))
        set tar_args = vec::push::str(tar_args "-C")
        set tar_args = vec::push::str(tar_args strings::copy(use! util::owl_home_libs() + "/" + pkg_name))
        use proc::run::output("tar" tar_args)

        if !fs::exists(meta_path) {
            use dasu("  writing metadata...")
            set meta = "[package]\n" :str mut
            set meta = meta + "name = \"" + pkg_name + "\"\n"
            set meta = meta + "version = \"" + pkg_ver + "\"\n"
            set meta = meta + "compiler = \"" + use! util::compiler_cmd() + "\"\n"
            set meta = meta + "abi = " + use! util::abi_version() + "\n"
            set meta = meta + "language = \"" + use! util::language_version() + "\"\n"
            use fs::write(use! util::owl_home_libs() + "/" + pkg_name + "/meta.toml" meta)
        }

        use! util::fs_make_readonly(use! util::owl_home_libs() + "/" + pkg_name)
        set rm8 = [] :vec[str] mut
        set rm8 = vec::push::str(rm8 "-f")
        set rm8 = vec::push::str(rm8 strings::copy(tarball_file))
        use proc::run::output("rm" rm8)
        use dasu("  installed " + pkg_name + " v" + pkg_ver)
    }
    return ec
}

pub fn cmd_target_install: (target_val :str named :str) {
    if len(named) > 0 {
        if !fs::exists(named) {
            use dasu("  error: binary not found at " + named)
        } else {
            set cp_args = [] :vec[str] mut
            set cp_args = vec::push::str(cp_args strings::copy(named))
            set cp_args = vec::push::str(cp_args strings::copy(use! util::owl_home() + "/bin"))
            use proc::run::output("cp" cp_args)
            set chmod_args = [] :vec[str] mut
            set chmod_args = vec::push::str(chmod_args "+x")
            set chmod_args = vec::push::str(chmod_args strings::copy(named))
            use proc::run::output("chmod" chmod_args)
            use dasu("  installed to owl cache")
        }
    } else {
        if !use! util::has_project() {
            use dasu("  usage: owl install --target=d|r [bin-path]")
        } else {
            set profile = "debug" :str mut
            if target_val == "r" { set profile = "release" }
            set out_dir = use! util::toml_get("owl.toml" "paths" "output") :str mut
            if len(out_dir) == 0 { set out_dir = "bin" }
            set bin_path = out_dir + "/" + profile
            if !fs::exists(bin_path) {
                use dasu("  error: no build output at " + bin_path + " -- run owl build first")
            } else {
                set dest_bin = use! util::owl_home() + "/bin"
                set ls_args = [] :vec[str] mut
                set ls_args = vec::push::str(ls_args "-1")
                set ls_args = vec::push::str(ls_args strings::copy(bin_path))
                set listing = use! util::trim(proc::run::output("ls" ls_args))
                set files = use! util::split(listing "\n")
                set nf = len(files)
                set j = 0 :i64 mut
                while j < nf {
                    set fname = use! util::trim(use! util::list_get(files j))
                    if fname != "" {
                        set cp_args = [] :vec[str] mut
                        set cp_args = vec::push::str(cp_args strings::copy(bin_path + "/" + fname))
                        set cp_args = vec::push::str(cp_args strings::copy(dest_bin))
                        use proc::run::output("cp" cp_args)
                    }
                    set j += 1
                }
                use dasu("  installed build artifacts to owl cache")
            }
        }
    }
}
