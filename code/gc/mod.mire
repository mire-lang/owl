module gc

load! /code/util
load! /code/args

/! Garbage-collect orphaned package versions.
   SAFETY: a package is only pruned when it uses the versioned layout
   (libs/<pkg>/<version>/meta.toml). Flat working copies -- a top-level
   meta.toml or owl.toml at libs/<pkg>/ (e.g. the kioto copy, or the mire
   symlink to a source checkout) -- are NEVER touched. Default is a dry
   run; pass --yes/-y to actually remove. !/
pub fn run: (args :&vec[str]) {
    set do_delete = use! args::flag::has(args "--yes") || use! args::flag::has(args "-y")
    set lib_dir = use! util::owl_home_libs()
    set has_libs = fs::exists(lib_dir)
    set removed = 0 :i64 mut
    set kept = 0 :i64 mut
    set skipped = 0 :i64 mut

    if !do_delete {
        use dasu("  dry run (use --yes to actually remove)")
    }

    if has_libs {
        set lib_arg = strings::copy(lib_dir)
        set pkg_list = use! util::list_text(lib_arg)
        if pkg_list != "" {
            set entries = use! util::split(pkg_list "\n")
            set ni = len(entries)
            set i_pkg = 0 :i64 mut
            while i_pkg < ni {
                set pkg = use! util::trim(use! util::list_get(entries i_pkg))
                if pkg != "" {
                    set pkg_dir = lib_dir + "/" + pkg
                    if fs::exists(pkg_dir) {
                        /! Flat working copy: top-level meta.toml or owl.toml
                           marks a single live package, not a versioned dir. !/
                        if fs::exists(pkg_dir + "/meta.toml") || fs::exists(pkg_dir + "/owl.toml") {
                            set skipped += 1
                        } else {
                            set ver_arg = strings::copy(pkg_dir)
                            set ver_list = use! util::list_text(ver_arg)
                            set vertries = use! util::split(ver_list "\n")
                            set nv = len(vertries)
                            set i_ver = 0 :i64 mut
                            while i_ver < nv {
                                set ver = use! util::trim(use! util::list_get(vertries i_ver))
                                set ver_dir = pkg_dir + "/" + ver
                                if !fs::exists(ver_dir + "/meta.toml") {
                                    use dasu("  [orphan] " + pkg + "/" + ver)
                                    if do_delete {
                                        use! util::rm_RF(ver_dir)
                                    }
                                    set removed += 1
                                } else {
                                    set kept += 1
                                }
                                set i_ver += 1
                            }

                            set rem_arg = strings::copy(pkg_dir)
                            set rem_vers = use! util::list_text(rem_arg)
                            if rem_vers == "" && do_delete {
                                use! util::rm_RF(pkg_dir)
                            }
                        }
                    }
                }
                set i_pkg += 1
            }
        }
    }

    use dasu("  gc: " + use! util::i64_to_string(removed) + " orphaned versions removed, " + use! util::i64_to_string(kept) + " kept, " + use! util::i64_to_string(skipped) + " working copies skipped")
    use dasu("  done")
}
