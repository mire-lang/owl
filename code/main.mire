load mire::vec
load mire::map
load kioto::strings
load kioto::time
load kioto::fs
load kioto::env
load kioto::proc
load kioto::async
load kioto::mem
load kioto::cpu
load kioto::math
load kioto::net
load kioto::log
load kioto::cli
load kioto::crypto
load! semver
load! util
load! /code/crypto
load! trust
load! registry
load! build
load! check
load! info
load! ui
load! deps
load! args
load! lockfile
load! dload
load! install
load! export
load! gc
load! profile
load! upgrade
load! /code/new

pub fn main: () {
    set args = env_args()
    set n = vec::len(args)
    if n < 2 {
        use! ui::help()
        return
    }
    set cmd = args at 1
    /! Validate flags for subcommand before dispatch !/
    if use! args::validate(cmd args) == false {
        return
    }
    match cmd {
        "build" { use! build::compile(args false) }
        "run" { use! build::compile(args true) }
        "test" { use! check::run_tests(args) }
        "check" { use! check::checkup(args) }
        "info" { use! info::run(args) }
        "checkup" { use! check::checkup(args) }
        "profile" { use! profile::run(args) }
        "new" { use! new::run(args) }
        "clean" { use dasu("clean command not yet implemented") }
        "load" { use dasu("load command not yet implemented") }
        "install" { use dasu("install command not yet implemented") }
        "export" { use! export::run(args) }
        "reg" { use! registry::sync() }
        "deps" { use dasu("deps command not yet implemented") }
        "gc" { use! gc::run(args) }
        "upgrade" { use! upgrade::run(args) }
        "help" { use! ui::help() }
        "-h" { use! ui::help() }
        "--help" { use! ui::help() }
        "version" { use! ui::banner() }
        "-V" { use! ui::banner() }
        "--version" { use! ui::banner() }
        _ { use! ui::help() }
    }
}
