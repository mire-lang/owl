}

pub fn decode_compile_request: (payload :&str) :DecodedCompileRequest {
    set version = use! messages::read_varint_field(payload 1) mut
    set request_id = use! messages::read_string_field(payload 2)
    set entry = use! messages::read_string_field(payload 3)
    set load_policy = use! messages::read_bytes_field(payload 4)
    set manifest = use! messages::read_repeated_bytes_fields(payload 5)
    set c_artifacts = use! messages::read_repeated_bytes_fields(payload 6)
