        set wire_type = field_key & 7
        if field_number <= 0 { return [] :vec[str] }
        if field_number == requested_field_number {
            if wire_type != 2 { return [] :vec[str] }
            set byte_length = use! wire::decode_varint_value(payload value_offset)
            set body_offset = use! wire::decode_varint_next_offset(payload value_offset)
            if byte_length < 0 || byte_length > 67108864 || body_offset < 0 { return [] :vec[str] }
            if byte_length > strings::len(payload) - body_offset { return [] :vec[str] }
            set field_value = strings::substr(payload body_offset byte_length)
            set values = vec::push::str(values field_value)
            set field_offset = body_offset + byte_length
        } else {
            set field_offset = use! messages::skip_field_value(payload value_offset wire_type)
        }
        if field_offset < 0 { return [] :vec[str] }
    }
    return values
}

pub fn read_string_field: (payload :&str, requested_field_number :i64) :str {
    set value = use! messages::read_bytes_field(payload requested_field_number)
    if use! wire::is_valid_utf8(value) == false { return "" }
    return value
}

pub fn payload_has_field: (payload :&str, requested_field_number :i64) :bool {
    if use! messages::is_valid_message_payload(payload) == false { return false }
    set field_offset = 0 mut
    while field_offset < strings::len(payload) {
        set field_key = use! wire::decode_varint_value(payload field_offset)
        set value_offset = use! wire::decode_varint_next_offset(payload field_offset)
        if (field_key >> 3) == requested_field_number { return true }
        set wire_type = field_key & 7
        set field_offset = use! messages::skip_field_value(payload value_offset wire_type)
    }
    return false
}

pub fn decode_load_policy: (payload :&str) :DecodedLoadPolicy {
    set root = use! messages::read_string_field(payload 1)
    set descend_value = use! messages::read_varint_field(payload 2)
    set symlink_value = use! messages::read_varint_field(payload 3)
    set valid = use! messages::is_valid_message_payload(payload) && use! messages::field_wire_types_are_valid(payload 1 2) && use! messages::field_wire_types_are_valid(payload 2 0) && use! messages::field_wire_types_are_valid(payload 3 0) && use! messages::string_field_values_are_valid(payload 1) mut
    if use! messages::payload_has_field(payload 2) && descend_value != 0 && descend_value != 1 { set valid = false }
    if use! messages::payload_has_field(payload 3) && symlink_value != 0 && symlink_value != 1 { set valid = false }
    if descend_value < -1 || symlink_value < -1 { set valid = false }
    return use! messages::DecodedLoadPolicy(valid root descend_value == 1 symlink_value == 1)
}

pub fn decode_source_entry: (payload :&str) :DecodedSourceEntry {
    set source_id = use! messages::read_string_field(payload 1)
    set path = use! messages::read_string_field(payload 2)
    set sha256 = use! messages::read_string_field(payload 3)
    set size = use! messages::read_varint_field(payload 4) mut
    set flags = use! messages::read_varint_field(payload 5) mut
