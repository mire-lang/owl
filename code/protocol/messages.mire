    set artifact_index = 0 mut
    while artifact_index < vec::len(c_artifacts) {
        set c_artifact = use! messages::decode_c_artifact(vec::get::str(c_artifacts artifact_index))
        if c_artifact.valid == false { set valid = false }
        set artifact_index = artifact_index + 1
    }
    if version < 0 { set version = 0 }
    return use! messages::DecodedCompileRequest(valid version request_id entry load_policy manifest c_artifacts security_policy flags artifact target cache_directory output_directory)
}

pub fn decode_compile_response: (payload :&str) :DecodedCompileResponse {
