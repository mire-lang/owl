    if size < -1 || flags < -1 || flags > 4294967295 { set valid = false }
    if use! messages::payload_has_field(payload 4) && size < 0 { set valid = false }
    if use! messages::payload_has_field(payload 5) && flags < 0 { set valid = false }
    if size < 0 { set size = 0 }
    if flags < 0 { set flags = 0 }
    return use! messages::DecodedSourceEntry(valid source_id path sha256 size flags)
}

