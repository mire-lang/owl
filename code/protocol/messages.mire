    if use! messages::string_field_values_are_valid(payload 2) == false || use! messages::string_field_values_are_valid(payload 3) == false || use! messages::string_field_values_are_valid(payload 8) == false || use! messages::string_field_values_are_valid(payload 9) == false || use! messages::string_field_values_are_valid(payload 10) == false || use! messages::string_field_values_are_valid(payload 11) == false || use! messages::string_field_values_are_valid(payload 12) == false { set valid = false }
    if use! messages::payload_has_field(payload 4) && use! messages::decode_load_policy(load_policy).valid == false { set valid = false }
    if use! messages::payload_has_field(payload 7) && use! messages::decode_security_policy(security_policy).valid == false { set valid = false }
    set entry_index = 0 mut
    while entry_index < vec::len(manifest) {
