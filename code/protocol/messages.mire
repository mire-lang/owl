    return use! messages::DecodedCArtifact(valid path sha256 artifact_kind symbol)
}

pub fn decode_security_policy: (payload :&str) :DecodedSecurityPolicy {
    set mode = use! messages::read_string_field(payload 1)
    set externs = use! messages::read_repeated_string_fields(payload 2)
    set external_libraries = use! messages::read_repeated_string_fields(payload 3)
