pub fn new: (args :&vec[str]) {
    use dasu("deps new: not implemented")
}

pub fn clean: (args :&vec[str]) {
    /! Remove unused dependencies from owl.toml and regenerate lockfile !/
    if !use! util::has_project() {
        use dasu("Error: no owl.toml found")
        return
    }
    set ok = use! deps::prune_unused()
    if ok {
        use dasu("  [OK]   unused dependencies pruned and lockfile regenerated")
    } else {
        use dasu("  [FAIL] could not prune dependencies")
    }
}

pub fn deps: (args :&vec[str]) {
    /! Print dependency tree !/
    if !use! util::has_project() {
        use dasu("Error: no owl.toml found")
        return
    }
    use dasu("deps command not yet implemented")
}
