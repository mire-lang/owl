load! /code/util

pub fn deps_section: () :str {
    set section = "" :str mut
    set content = fs::read("owl.toml")
    set marker = "[dependencies]"
    set sec_start = strings::index(content marker)
    if sec_start >= 0 {
        set start_pos = sec_start + len(marker)
        set after = strings::substr(content start_pos 9999)
        set next_sec = strings::index(after "\n[")
        if next_sec >= 0 { set section = strings::substr(after 0 next_sec) } else { set section = after }
    }
    return section
}

pub fn find_dep_raw: (dep_name :str) :str {
    set result = "" :str mut
    set section = use! deps::deps_section()
    if section != "" {
        set search_a = "\n" + dep_name + " = "
        set pos = strings::index(section search_a) :i64 mut
        set used_marker = search_a :str mut
        if pos < 0 {
            set search_b = "\n" + dep_name + "="
            set pos = strings::index(section search_b)
            set used_marker = search_b
        }
        if pos < 0 {
            set search_c = dep_name + " = "
            set pos = strings::index(section search_c)
            set used_marker = search_c
        }
        if pos >= 0 {
            set after_key = strings::substr(section pos + len(used_marker) 9999)
            set nl_pos = strings::index(after_key "\n")
            if nl_pos >= 0 { set result = strings::substr(after_key 0 nl_pos) } else { set result = after_key }
        }
    }
    return result
}

pub fn extract_field: (tbl :str, field :str) :str {
    set val = "" :str mut
    set trimmed = use! util::trim(tbl) :str mut
    if use! util::startswith(trimmed "{") { set trimmed = use! util::replace(trimmed "{" "") }
    if use! util::endswith(trimmed "}") { set trimmed = use! util::replace(trimmed "}" "") }
    set trimmed = use! util::trim(trimmed)

    set search = field + " ="
    set pos = strings::index(trimmed search)
    if pos >= 0 {
        set after_start = pos + len(search)
        set after = strings::substr(trimmed after_start 9999)
        set val = use! util::trim(after) :str mut
        set comma_pos = strings::index(val ",")
        if comma_pos >= 0 {
            set want_len = comma_pos
            set val = strings::substr(val 0 want_len)
        }
        set val = use! util::trim(val)
        if use! util::startswith(val "\"") { set val = use! util::replace(val "\"" "") }
        if use! util::endswith(val "\"") { set val = use! util::replace(val "\"" "") }
        set val = use! util::trim(val)
    }
    return val
}

pub fn get_dep_field: (dep_name :str, field :str) :str {
    set result = "" :str mut
    set raw = use! deps::find_dep_raw(dep_name)
    if raw != "" { set result = use! deps::extract_field(raw field) }
    return result
}

pub fn dep_exists: (dep_name :str) :bool {
    return use! deps::get_dep_field(dep_name "path") != ""
}

pub fn get_dep_names: () :str {
    set result = "" :str mut
    set section = use! deps::deps_section()
    if section != "" {
        set content = "\n" + section
        set clen = len(content)
        set pos = 0 :i64 mut
        while pos < clen {
            set nl = strings::index(strings::substr(content pos clen - pos) "\n")
            if nl < 0 { set pos = clen } else {
                set real_nl = pos + nl
                set line = strings::substr(content pos real_nl - pos)
                set trimmed = use! util::trim(line)
                if trimmed != "" && !use! util::startswith(trimmed "[") {
                    set eq_pos = strings::index(trimmed "=")
                    if eq_pos >= 0 {
                        set key = use! util::trim(strings::substr(trimmed 0 eq_pos))
                        if key != "" {
                            if result != "" { set result = result + "\n" + key } else { set result = key }
                        }
                    }
                }
                set pos = real_nl + 1
            }
        }
    }
    return result
}

pub fn count_deps: () :i64 {
    set count = 0 :i64 mut
    set names = use! deps::get_dep_names()
    if names != "" {
        set pos = 0 :i64 mut
        set nlen = len(names)
        while pos < nlen {
            set nl = strings::index(strings::substr(names pos nlen - pos) "\n")
            if nl < 0 { if use! util::trim(strings::substr(names pos nlen - pos)) != "" { set count += 1 } set pos = nlen } else { if use! util::trim(strings::substr(names pos nl)) != "" { set count += 1 } set pos = pos + nl + 1 }
        }
    }
    return count
}

pub fn get_dep_names_from: (toml_file :str) :str {
    set result = "" :str mut
    if fs::exists(toml_file) {
        set content = fs::read(toml_file)
        set marker = "[dependencies]"
        set sec_start = strings::index(content marker)
        if sec_start >= 0 {
            set start_pos = sec_start + len(marker)
            set after = strings::substr(content start_pos 9999)
            set next_sec = strings::index(after "\n[")
            set section = "" :str mut
            if next_sec >= 0 { set section = strings::substr(after 0 next_sec) } else { set section = after }
            set c = "\n" + section
            set clen = len(c)
            set pos = 0 :i64 mut
            while pos < clen {
                set nl = strings::index(strings::substr(c pos clen - pos) "\n")
                if nl < 0 { set pos = clen } else {
                    set real_nl = pos + nl
                    set line = strings::substr(c pos real_nl - pos)
                    set trimmed = use! util::trim(line)
                    if trimmed != "" && !use! util::startswith(trimmed "[") {
                        set eq_pos = strings::index(trimmed "=")
                        if eq_pos >= 0 {
                            set key = use! util::trim(strings::substr(trimmed 0 eq_pos))
                            if key != "" {
                                if result != "" { set result = result + "\n" + key } else { set result = key }
                            }
                        }
                    }
                    set pos = real_nl + 1
                }
            }
        }
    }
    return result
}

pub fn get_dep_field_from: (toml_file :str dep_name :str field :str) :str {
    set raw = "" :str mut
    if fs::exists(toml_file) {
        set content = fs::read(toml_file)
        set marker = "[dependencies]"
        set sec_start = strings::index(content marker)
        if sec_start >= 0 {
            set start_pos = sec_start + len(marker)
            set after = strings::substr(content start_pos 9999)
            set next_sec = strings::index(after "\n[")
            set section = "" :str mut
            if next_sec >= 0 { set section = strings::substr(after 0 next_sec) } else { set section = after }

            set search_a = "\n" + dep_name + " = "
            set pos = strings::index(section search_a) :i64 mut
            set used_marker = search_a :str mut
            if pos < 0 {
                set search_b = "\n" + dep_name + "="
                set pos = strings::index(section search_b)
                set used_marker = search_b
            }
            if pos < 0 {
                set search_c = dep_name + " = "
                set pos = strings::index(section search_c)
                set used_marker = search_c
            }
            if pos >= 0 {
                set after_key = strings::substr(section pos + len(used_marker) 9999)
                set nl_pos = strings::index(after_key "\n")
                if nl_pos >= 0 { set raw = strings::substr(after_key 0 nl_pos) } else { set raw = after_key }
            }
        }
    }
    return use! deps::extract_field(raw field)
}

/! Scans the first level of ~/owl/libs and returns one TOML
   dependency line per installed library, using its latest local version.
   `mire` is excluded because it is injected directly into
   `[dependencies]` by `owl new`.
!/
pub fn gather_latest_libs: () :str {
    set lib_dir = use! util::owl_home_libs()
    set lib_display = use! util::owl_home_libs_display()
    if !fs::exists(lib_dir) { return "" }
    set raw = proc::run::output("ls" ["-1" lib_dir])
    set entries = strings::split(raw "\n")
    set out = "" :str mut
    set i = 0 :i64 mut
    set n = len(entries)
    while i < n {
        set name = rt_vec_get_str(entries i)
        if name != "mire" && name != "" {
            set toml = lib_dir + "/" + name + "/owl.toml"
            if fs::exists(toml) {
                set ver = use! util::toml_get(toml "project" "version") :str mut
                if ver == "" { set ver = "0.1.0" }
                set line = name + " = { path = \"" + lib_display + "/" + name + "\", version = \"" + ver + "\" }"
                if out == "" { set out = line } else { set out = out + "\n" + line }
            }
        }
        set i += 1
    }
    return out
}

/! Prunes `[dependencies]` to only the entries actually used by the
   project (detected via `load <name>` in code/ and tests/), then
   regenerates owl.lock from the surviving set. This avoids the
   lockfile filling up with false-positive entries from auto-deps.
   Returns true on success.
!/
pub fn prune_unused: () :bool {
    if !use! util::has_project() { return false }
    set used = use! deps::used_dep_names()
    set section = use! deps::deps_section()
    set names = use! deps::get_dep_names()
    if names == "" { return use! lockfile::generate_lockfile() }
    set pos = 0 :i64 mut
    set nlen = len(names)
    set kept = "" :str mut
    set first = true :bool mut
    while pos < nlen {
        set remaining = strings::substr(names pos nlen - pos)
        set nl = strings::index(remaining "\n")
        set end = 0 :i64 mut
        if nl < 0 { set end = nlen } else { set end = pos + nl }
        set name_line = strings::substr(names pos end - pos)
        set dep_name = use! util::trim(name_line)
        set pos = end + 1
        if dep_name != "" {
            set dn = dep_name
            if use! deps::list_contains(used dn) {
                set dnr = dep_name
                set raw = use! deps::find_dep_raw(dnr)
                if !first { set kept = kept + "\n" } else { set first = false }
                set kept = kept + dep_name + " = " + raw
            }
        }
    }
    set content = fs::read("owl.toml")
    set marker = "[dependencies]"
    set sec_pos = strings::index(content marker)
    if sec_pos < 0 { return false }
    set insert_pos = sec_pos + len(marker)
    set before = strings::substr(content 0 insert_pos)
    set rem = len(content) - insert_pos
    set after = strings::substr(content insert_pos rem) :str mut
    /! Strip any trailing [tool.owl.auto-deps] so we only keep deps. !/
    set next_sec = strings::index(after "\n[")
    if next_sec < 0 { set after = "" } else { set after = strings::substr(after next_sec len(after) - next_sec) }
    set new_c = before + "\n" + kept + after
    use fs::write("owl.toml" new_c)
    return use! lockfile::generate_lockfile()
}

/! Returns newline-separated names of dependencies referenced by
   `load <name>` in the project's source and test directories.
!/
pub fn used_dep_names: () :str {
    set found = "" :str mut
    set found_set = "" :str mut
    set names = use! deps::get_dep_names()
    if names != "" {
        set pos = 0 :i64 mut
        set nlen = len(names)
        while pos < nlen {
            set rem = strings::substr(names pos nlen - pos)
            set nl = strings::index(rem "\n")
            set end = 0 :i64 mut
            if nl < 0 { set end = nlen } else { set end = pos + nl }
            set name_line = strings::substr(names pos end - pos)
            set dep = use! util::trim(name_line)
            set pos = end + 1
            if dep != "" {
                set d1 = dep
                if use! util::grep_load(d1) {
                    set d2 = dep
                    if !use! deps::list_contains(found_set d2) {
                        set d3 = dep
                        if found == "" { set found = d3 } else { set found = found + "\n" + d3 }
                        set d4 = dep
                        if found_set == "" { set found_set = d4 } else { set found_set = found_set + "\n" + d4 }
                    }
                }
            }
        }
    }
    return found
}

pub fn list_contains: (list :&str, item :&str) :bool {
    if list == "" { return false }
    set pos = 0 :i64 mut
    set nlen = len(list)
    while pos < nlen {
        set rem = strings::substr(list pos nlen - pos)
        set nl = strings::index(rem "\n")
        set end = 0 :i64 mut
        if nl < 0 { set end = nlen } else { set end = pos + nl }
        set line = strings::substr(list pos end - pos)
        if use! util::trim(line) == *item { return true }
        set pos = end + 1
    }
    return false
}
