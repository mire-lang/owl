module deps

load mire::vec
load! /code/util
load! /code/dep_resolver

pub fn deps_section: () :str {
    set section = "" :str mut
    set content = fs::read("owl.toml")
    set marker = "[dependencies]"
    set sec_start = strings::index(content marker)
    if sec_start >= 0 {
        set start_pos = sec_start + len(marker)
        set after = strings::substr(content start_pos 9999)
        set next_sec = strings::index(after "\n[")
        if next_sec >= 0 { set section = strings::substr(after 0 next_sec) } else { set section = after }
    }
    return section
}

pub fn find_dep_raw: (dep_name :str) :str {
    set result = "" :str mut
    set section = use! deps::deps_section()
    if section != "" {
        set search_a = "\n" + dep_name + " = "
        set pos = strings::index(section search_a) :i64 mut
        set used_marker = search_a :str mut
        if pos < 0 {
            set search_b = "\n" + dep_name + "="
            set pos = strings::index(section search_b)
            set used_marker = search_b
        }
        if pos < 0 {
            set search_c = dep_name + " = "
            set pos = strings::index(section search_c)
            set used_marker = search_c
        }
        if pos >= 0 {
            set after_key = strings::substr(section pos + len(used_marker) 9999)
            set nl_pos = strings::index(after_key "\n")
            if nl_pos >= 0 { set result = strings::substr(after_key 0 nl_pos) } else { set result = after_key }
        }
    }
    return result
}

pub fn extract_field: (tbl :str, field :str) :str {
    set val = "" :str mut
    set trimmed = use! util::trim(tbl) :str mut
    set trimmed = use! util::trim(trimmed)

    set search = field + " ="
    set pos = strings::index(trimmed search)
    if pos >= 0 {
        set after_start = pos + len(search)
        set after = strings::substr(trimmed after_start 9999)
        set val = use! util::trim(after) :str mut
        set comma_pos = strings::index(val ",")
        if comma_pos >= 0 {
            set want_len = comma_pos
            set val = strings::substr(val 0 want_len)
        }
        set val = use! util::trim(val)
        if strings::ends::with(val "}") {
            set brace_len = strings::len(val)
            set val = strings::substr(val 0 brace_len - 1)
            set val = use! util::trim(val)
        }
        if use! util::startswith(val "\"") && use! util::endswith(val "\"") {
            set val_len = strings::len(val)
            set val = strings::substr(val 1 val_len - 2)
        } else {
            if use! util::startswith(val "\"") {
                set val_len2 = strings::len(val)
                set val = strings::substr(val 1 val_len2 - 1)
            }
        }
        set val = use! util::trim(val)
    }
    return val
}

pub fn get_dep_field: (dep_name :str, field :str) :str {
    set result = "" :str mut
    set cfg_name = strings::copy(dep_name)
    set cfg_field = strings::copy(field)
    set raw_field = strings::copy(field)
    set raw = use! deps::find_dep_raw(dep_name)
    if raw != "" { set result = use! deps::extract_field(raw raw_field) }
    if result == "" {
        set cfg_file = use! util::cfg::package(cfg_name)
        if fs::exists(cfg_file) {
            set cfg_content = fs::read(cfg_file)
            set cfg_content_sha = strings::copy(cfg_content)
            set cfg_content_value = strings::copy(cfg_content)
            set cfg_verified = use! deps::extract_field(cfg_content "verified")
            set cfg_sha = use! deps::extract_field(cfg_content_sha "sha256")
            if cfg_verified == "true" && cfg_sha != "" {
                set result = use! deps::extract_field(cfg_content_value cfg_field)
            }
        }
    }
    return result
}

pub fn dep_exists: (dep_name :str) :bool {
    return use! deps::get_dep_field(dep_name "path") != ""
}

pub fn get_dep_names: () :str {
    set result = "" :str mut
    set section = use! deps::deps_section()
    if section != "" {
        set content = "\n" + section
        set clen = len(content)
        set pos = 0 :i64 mut
        while pos < clen {
            set nl = strings::index(strings::substr(content pos clen - pos) "\n")
            set real_nl = clen :i64 mut
            if nl >= 0 { set real_nl = pos + nl }
            set line = strings::substr(content pos real_nl - pos)
            set trimmed = use! util::trim(line)
            if trimmed != "" && !use! util::startswith(trimmed "[") {
                set eq_pos = strings::index(trimmed "=")
                if eq_pos >= 0 {
                    set key = use! util::trim_substr(trimmed 0 eq_pos)
                    if key != "" {
                        if result != "" { set result = result + "\n" + key } else { set result = key }
                    }
                }
            }
            set pos = real_nl + 1
        }
    }
    return result
}

/! Build the explicit search path handed to Avenys. Owl has already resolved
   each dependency; the compiler receives these directories and does not parse
   the project's dependency table. !/
pub fn compiler_lib_dirs: () :str {
    /! Avenys receives real filesystem paths, not the display form
       `~/.owl/libs`. Keeping the expansion here also makes local path
       dependencies reproducible when Owl is launched without a shell. !/
    set result = use! util::owl_home_libs() :str mut
    set names = use! deps::get_dep_names()
    set pos = 0 :i64 mut
    set total = len(names)
    while pos < total {
        set rest = strings::substr(names pos total - pos)
        set nl = strings::index(rest "\n")
        set size = total - pos mut
        if nl >= 0 { set size = nl }
        set name = use! util::trim_substr(names pos size)
        if name != "" {
            set path = use! deps::get_dep_field(name "path") mut
            if path != "" {
                set path = use! util::expand_home(path) mut
                /! Avenys treats every --lib-dir as a package directory and
                   appends the dependency name to it. Therefore a dependency
                   declared as `./testlib` contributes its parent (`.`), not
                   the package root itself. !/
                set parent = fs::path::dir(path) mut
                if parent == "" { set parent = "." }
                set result = result + ":" + parent
            }
        }
        if nl < 0 { set pos = total } else { set pos = pos + nl + 1 }
    }
    return result
}

pub fn count_deps: () :i64 {
    set count = 0 :i64 mut
    set names = use! deps::get_dep_names()
    if names != "" {
        set pos = 0 :i64 mut
        set nlen = len(names)
        while pos < nlen {
            set nl = strings::index(strings::substr(names pos nlen - pos) "\n")
            if nl < 0 { if use! util::trim_substr(names pos nlen - pos) != "" { set count += 1 } set pos = nlen } else { if use! util::trim_substr(names pos nl) != "" { set count += 1 } set pos = pos + nl + 1 }
        }
    }
    return count
}

pub fn get_dep_names_from: (toml_file :str) :str {
    set result = "" :str mut
    if fs::exists(toml_file) {
        set content = fs::read(toml_file)
        set marker = "[dependencies]"
        set sec_start = strings::index(content marker)
        if sec_start >= 0 {
            set start_pos = sec_start + len(marker)
            set after = strings::substr(content start_pos 9999)
            set next_sec = strings::index(after "\n[")
            set section = "" :str mut
            if next_sec >= 0 { set section = strings::substr(after 0 next_sec) } else { set section = after }
            set c = "\n" + section
            set clen = len(c)
            set pos = 0 :i64 mut
            while pos < clen {
                set nl = strings::index(strings::substr(c pos clen - pos) "\n")
                set real_nl = clen :i64 mut
                if nl >= 0 { set real_nl = pos + nl }
                set line = strings::substr(c pos real_nl - pos)
                set trimmed = use! util::trim(line)
                if trimmed != "" && !use! util::startswith(trimmed "[") {
                    set eq_pos = strings::index(trimmed "=")
                    if eq_pos >= 0 {
                        set key = use! util::trim_substr(trimmed 0 eq_pos)
                        if key != "" {
                            if result != "" { set result = result + "\n" + key } else { set result = key }
                        }
                    }
                }
                set pos = real_nl + 1
            }
        }
    }
    return result
}

pub fn get_dep_field_from: (toml_file :str dep_name :str field :str) :str {
    set raw = "" :str mut
    if fs::exists(toml_file) {
        set content = fs::read(toml_file)
        set marker = "[dependencies]"
        set sec_start = strings::index(content marker)
        if sec_start >= 0 {
            set start_pos = sec_start + len(marker)
            set after = strings::substr(content start_pos 9999)
            set next_sec = strings::index(after "\n[")
            set section = "" :str mut
            if next_sec >= 0 { set section = strings::substr(after 0 next_sec) } else { set section = after }

            set search_a = "\n" + dep_name + " = "
            set pos = strings::index(section search_a) :i64 mut
            set used_marker = search_a :str mut
            if pos < 0 {
                set search_b = "\n" + dep_name + "="
                set pos = strings::index(section search_b)
                set used_marker = search_b
            }
            if pos < 0 {
                set search_c = dep_name + " = "
                set pos = strings::index(section search_c)
                set used_marker = search_c
            }
            if pos >= 0 {
                set after_key = strings::substr(section pos + len(used_marker) 9999)
                set nl_pos = strings::index(after_key "\n")
                if nl_pos >= 0 { set raw = strings::substr(after_key 0 nl_pos) } else { set raw = after_key }
            }
        }
    }
    return use! deps::extract_field(raw field)
}

/! Scans the first level of ~/owl/libs and returns one TOML
   dependency line per installed library, using its latest local version.
   `mire` is excluded because it is injected directly into
   `[dependencies]` by `owl new`.
!/
pub fn gather_latest_libs: () :str {
    set lib_dir = use! util::owl_home_libs()
    set lib_display = use! util::owl_home_libs_display()
    if !fs::exists(lib_dir) { return "" }
    set raw = use! util::list_text(lib_dir)
    set entries = strings::split(raw "\n")
    set out = "" :str mut
    set i = 0 :i64 mut
    set n = len(entries)
    while i < n {
        set name = vec::get::str(entries i)
        if name != "mire" && name != "" {
            /! Look for versioned directory <name>@<ver> !/
            set ver_dir = lib_dir + "/" + name + "@"
            /! List versioned directories matching this package !/
            set lib_raw = use! util::list_text(lib_dir)
            set lib_entries = strings::split(lib_raw "\n")
            set j = 0 :i64 mut
            set lib_n = len(lib_entries)
            set found_ver = "" :str mut
            while j < lib_n {
                set lib_name = vec::get::str(lib_entries j)
                if use! util::startswith(lib_name name + "@") {
                    set found_ver = strings::substr(lib_name len(name) + 1 9999)
                    set j = lib_n /! break
                }
                set j += 1
            }
            if found_ver != "" {
                set ver = found_ver
                set line = name + " = { path = \"" + lib_display + "/" + name + "\", version = \"" + ver + "\" }"
                if out == "" { set out = line } else { set out = out + "\n" + line }
            }
        }
        set i += 1
    }
    return out
}

pub fn list_contains: (list :&str, item :&str) :bool {
    if list == "" { return false }
    set pos = 0 :i64 mut
    set nlen = len(list)
    while pos < nlen {
        set rem = strings::substr(list pos nlen - pos)
        set nl = strings::index(rem "\n")
        set end = 0 :i64 mut
        if nl < 0 { set end = nlen } else { set end = pos + nl }
        set line = strings::substr(list pos end - pos)
        if use! util::trim(line) == *item { return true }
        set pos = end + 1
    }
    return false
}

/! Returns newline-separated names of dependencies referenced by
   `load <name>` in the project's source and test directories.
!/
pub fn used_dep_names: () :str {
    set found = "" :str mut
    set found_set = "" :str mut
    set names = use! deps::get_dep_names()
    if names != "" {
        set pos = 0 :i64 mut
        set nlen = len(names)
        while pos < nlen {
            set rem = strings::substr(names pos nlen - pos)
            set nl = strings::index(rem "\n")
            set end = 0 :i64 mut
            if nl < 0 { set end = nlen } else { set end = pos + nl }
            set name_line = strings::substr(names pos end - pos)
            set dep = use! util::trim(name_line)
            set pos = end + 1
            if dep != "" {
                set d1 = dep
                if use! util::grep_load(d1) {
                    set d2 = dep
                    set in_found = false :bool mut
                    set flist = found_set :str mut
                    set fpos = 0 :i64 mut
                    set flen = len(flist)
                    while fpos < flen {
                        set frem = strings::substr(flist fpos flen - fpos)
                        set fnl = strings::index(frem "\n")
                        set fend = 0 :i64 mut
                        if fnl < 0 { set fend = flen } else { set fend = fpos + fnl }
                        set fline = strings::substr(flist fpos fend - fpos)
                        if use! util::trim(fline) == d2 { set in_found = true }
                        set fpos = fend + 1
                    }
                    if !in_found {
                        set d3 = dep
                        if found == "" { set found = d3 } else { set found = found + "\n" + d3 }
                        set d4 = dep
                        if found_set == "" { set found_set = d4 } else { set found_set = found_set + "\n" + d4 }
                    }
                }
            }
        }
    }
    return found
}

/! Prunes `[dependencies]` to only the entries actually used by the
   project (detected via `load <name>` in code/ and tests/), then
   regenerates owl.lock from the surviving set. This avoids the
   lockfile filling up with false-positive entries from auto-deps.
   Returns true on success.
!/
pub fn prune_unused: () :bool {
    if !use! util::has_project() { return false }
    set used = use! used_dep_names()
    set section = use! deps::deps_section()
    set names = use! deps::get_dep_names()
    if names == "" { return use! lockfile::generate() }
    set pos = 0 :i64 mut
    set nlen = len(names)
    set kept = "" :str mut
    set first = true :bool mut
    set raw_val = "" :str mut
    while pos < nlen {
        set remaining = strings::substr(names pos nlen - pos)
        set nl = strings::index(remaining "\n")
        set end = 0 :i64 mut
        if nl < 0 { set end = nlen } else { set end = pos + nl }
        set name_line = strings::substr(names pos end - pos)
        set dep_name = use! util::trim(name_line)
        set pos = end + 1
        if dep_name != "" {
            /! `mire` is the compiler's standard library, injected by
               `owl new`; it must never be pruned even when no source
               file loads it directly (kioto and tooling load it
               transitively). !/
            set dn = dep_name
            set is_mire = dep_name == "mire" :bool mut
            set in_used = false :bool mut
            set ulist = used :str mut
            set upos = 0 :i64 mut
            set ulen = len(ulist)
            while upos < ulen {
                set urem = strings::substr(ulist upos ulen - upos)
                set unl = strings::index(urem "\n")
                set uend = 0 :i64 mut
                if unl < 0 { set uend = ulen } else { set uend = upos + unl }
                set uline = strings::substr(ulist upos uend - upos)
                if use! util::trim(uline) == dn { set in_used = true }
                set upos = uend + 1
            }
            if is_mire || in_used {
                set dnr = dep_name
                set raw_val = use! deps::find_dep_raw(dnr)
                if !first { set kept = kept + "\n" } else { set first = false }
                set kept = kept + dep_name + " = " + raw_val
            }
        }
    }
    set content = fs::read("owl.toml")
    set marker = "[dependencies]"
    set sec_pos = strings::index(content marker)
    if sec_pos < 0 { return false }
    set insert_pos = sec_pos + len(marker)
    set before = strings::substr(content 0 insert_pos)
    set rem = len(content) - insert_pos
    set after = strings::substr(content insert_pos rem) :str mut
    /! Strip any trailing [tool.owl.auto-deps] so we only keep deps. !/
    set next_sec = strings::index(after "\n[")
    if next_sec < 0 { set after = "" } else { set after = strings::substr(after next_sec len(after) - next_sec) }
    set new_c = before + "\n" + kept + after
    use fs::write("owl.toml" new_c)
    return use! lockfile::generate()
}

/! Delegate resolution to dep_resolver !/
pub fn resolve: () :bool {
    set plan = use! dep_resolver::resolve()
    return use! dep_resolver::execute_plan(plan)
}

/! Install/update dependencies based on owl.toml !/
pub fn install_deps: () :bool {
    return use! deps::resolve()
}

