module pkgbuild

load mire::vec
load! /code/util
load! /code/deps_db
load kioto::strings
load kioto::fs
load kioto::proc

/! PKGBUILD-style package definitions for Owl.
   Modeled after Arch Linux AUR PKGBUILD, with security policies
   for checksum verification, PGP signature verification, and
   IEEE-compliant secure installation.
   
   Package format (TOML):
   [[pkgbuild]]
   name = "sqlite3"
   version = "3.45.0"
   release = "1"
   desc = "SQLite database library"
   arch = "x86_64"
   url = "https://sqlite.org"
   license = "Public Domain"
   
   [pkgbuild.source]
   url = "https://sqlite.org/2024/sqlite-amalgamation-3450000.zip"
   sha256 = "abc123def456..."
   pgp_key = "0x1234567890ABCDEF"
   pgp_sig = "signature.asc"
   
   [pkgbuild.security]
   verify_checksum = true
   verify_signature = true
   require_ssl = true
   allow_unsigned = false
   
   [pkgbuild.build]
   depends_on = ["readline", "zlib"]
   build_cmd = "./configure && make"
   install_cmd = "make install"
   configure_flags = ["--enable-fts5"]
   
   [pkgbuild.distros]
   arch = { package = "sqlite", repo = "extra" }
   debian = { package = "libsqlite3-dev", repo = "main" }
   ubuntu = { package = "libsqlite3-dev", repo = "main" }
   fedora = { package = "sqlite-devel", repo = "updates" }
!/

pub fn db_path: () :str {
    set home = env::var("HOME")
    if home == "" { return "" }
    return strings::concat(home "/.owl/pkgbuild")
}

pub fn db_file: () :str {
    return use! pkgbuild::db_path() + "/packages.toml"
}

pub fn init: () :bool {
    set dir = use! pkgbuild::db_path()
    if dir == "" { return false }
    if !fs::exists(dir) {
        use! util::mkdir_p(strings::copy(dir))
    }
    set f = use! pkgbuild::db_file()
    if !fs::exists(f) {
        set initial = "# Owl PKGBUILD Database\n# PKGBUILD-style package definitions\n# Managed by Owl package manager\n# Format: [[pkgbuild]] sections with source, security, build, distros tables\n\n"
        use fs::write(f initial)
    }
    use dasu("  [OK]    PKGBUILD database initialized at " + f)
    return true
}

pub fn list: () {
    set f = use! pkgbuild::db_file()
    if !fs::exists(f) {
        use dasu("  [FAIL]  PKGBUILD database not initialized. Run 'owl pkgbuild init' first.")
        return
    }
    set content = fs::read(f)
    set lines = strings::split(content "\n")
    use dasu("  registered PKGBUILD packages:")
    set i = 0 :i64 mut
    while i < vec::len(lines) {
        set line = use! util::trim(lines at i)
        if use! strings::starts::with(line "[[pkgbuild]]") {
            set name = "" :str mut
            set ver = "" :str mut
            set j = i + 1 :i64 mut
            while j < vec::len(lines) {
                set next_line = use! util::trim(lines at j)
                if use! strings::starts::with(next_line "[[") { break }
                if use! strings::starts::with(next_line "name =") {
                    set name = use! semver::extract_str_val(next_line)
                }
                if use! strings::starts::with(next_line "version =") {
                    set ver = use! semver::extract_str_val(next_line)
                }
                set j += 1
            }
            if len(name) > 0 {
                set ver_disp = if len(ver) > 0 { " " + ver } else { "" }
                use dasu(sc("  " name) ver_disp)
            }
        }
        set i += 1
    }
}

pub fn add: (name :&str version :&str url :&str sha256 :&str desc :&str) :bool {
    set name = strings::copy(name)
    set name = strings::copy(name)
    set version = strings::copy(version)
    set url = strings::copy(url)
    set sha256 = strings::copy(sha256)
    set desc = strings::copy(desc)
    set name = strings::copy(name)
    set version = strings::copy(version)
    set url = strings::copy(url)
    set sha256 = strings::copy(sha256)
    set desc = strings::copy(desc)
    set f = use! pkgbuild::db_file()
    if !fs::exists(f) {
        use! pkgbuild::init()
    }
    
    set home = env::var("HOME")
    set distro = use! os::detect_id()
    set fam = use! os::detect_family()
    
    set entry = "" :str mut
    set entry = entry + "[[pkgbuild]]\n"
    set entry = entry + "name = \"" + name + "\"\n"
    set entry = entry + "version = \"" + version + "\"\n"
    set entry = entry + "release = \"1\"\n"
    set entry = entry + "desc = \"" + desc + "\"\n"
    set entry = entry + "url = \"" + url + "\"\n"
    set entry = entry + "os_id = \"" + distro + "\"\n"
    set entry = entry + "os_family = \"" + fam + "\"\n"
    set entry = entry + "added = \"" + use! util::i64_to_string(time::now::ns()) + "\"\n"
    set entry = entry + "\n"
    set entry = entry + "[pkgbuild.source]\n"
    set entry = entry + "url = \"" + url + "\"\n"
    set entry = entry + "sha256 = \"" + sha256 + "\"\n"
    set entry = entry + "verify_checksum = true\n"
    set entry = entry + "verify_signature = true\n"
    set entry = entry + "require_ssl = true\n"
    set entry = entry + "allow_unsigned = false\n"
    set entry = entry + "\n"
    set entry = entry + "[pkgbuild.security]\n"
    set entry = entry + "policy = \"strict\"\n"
    set entry = entry + "ieee_compliant = true\n"
    set entry = entry + "cve_check = true\n"
    set entry = entry + "signature_required = true\n"
    set entry = entry + "\n"
    
    set content = fs::read(f)
    set new_content = content + entry
    use fs::write(f new_content)
    use dasu("  [OK]    PKGBUILD '" name + "' version " + version + " added")
    return true
}

pub fn lookup: (name :&str) :str {
    set f = use! pkgbuild::db_file()
    if !fs::exists(f) { return "" }
    set content = fs::read(f)
    set lines = strings::split(content "\n")
    set i = 0 :i64 mut
    while i < vec::len(lines) {
        set line = use! util::trim(lines at i)
        if use! strings::starts::with(line "[[pkgbuild]]") {
            set found_name = "" :str mut
            set found_ver = "" :str mut
            set j = i + 1 :i64 mut
            while j < vec::len(lines) {
                set next_line = use! util::trim(lines at j)
                if use! strings::starts::with(next_line "[[") { break }
                if use! strings::starts::with(next_line "name =") {
                    set found_name = use! semver::extract_str_val(next_line)
                }
                if use! strings::starts::with(next_line "version =") {
                    set found_ver = use! semver::extract_str_val(next_line)
                }
                set j += 1
            }
            if found_name == name {
                return found_ver
            }
        }
        set i += 1
    }
    return ""
}

pub fn verify_checksum: (name :&str file_path :&str) :bool {
    set name = strings::copy(name)
    set file_path = strings::copy(file_path)
    set f = use! pkgbuild::db_file()
    if !fs::exists(f) {
        use dasu("  [FAIL]  PKGBUILD database not initialized")
        return false
    }
    set expected_sha = use! pkgbuild::get_checksum_from_db(name)
    if len(expected_sha) == 0 {
        use dasu("  [WARN]  no checksum recorded for '" + name + "', skipping verification")
        return true
    }
    set actual_sha = use! crypto::sha256(file_path)
    if actual_sha == expected_sha {
        use dasu("  [OK]    checksum verified for '" + name + "'")
        return true
    } else {
        use dasu("  [FAIL]  checksum mismatch for '" + name + "'")
        use dasu("    expected: " + expected_sha)
        use dasu("    actual:   " + actual_sha)
        return false
    }
}

pub fn get_checksum_from_db: (name :&str) :str {
    set f = use! pkgbuild::db_file()
    if !fs::exists(f) { return "" }
    set content = fs::read(f)
    set lines = strings::split(content "\n")
    set i = 0 :i64 mut
    while i < vec::len(lines) {
        set line = use! util::trim(lines at i)
        if use! strings::starts::with(line "[[pkgbuild]]") {
            set found_name = "" :str mut
            set found_sha = "" :str mut
            set j = i + 1 :i64 mut
            while j < vec::len(lines) {
                set next_line = use! util::trim(lines at j)
                if use! strings::starts::with(next_line "[[") { break }
                if use! strings::starts::with(next_line "name =") {
                    set found_name = use! semver::extract_str_val(next_line)
                }
                if found_name == name {
                    if use! strings::starts::with(next_line "sha256 =") {
                        set found_sha = use! semver::extract_str_val(next_line)
                    }
                }
                set j += 1
            }
            if found_name == name {
                return found_sha
            }
        }
        set i += 1
    }
    return ""
}

pub fn get_source_url: (name :&str) :str {
    set f = use! pkgbuild::db_file()
    if !fs::exists(f) { return "" }
    set content = fs::read(f)
    set lines = strings::split(content "\n")
    set i = 0 :i64 mut
    while i < vec::len(lines) {
        set line = use! util::trim(lines at i)
        if use! strings::starts::with(line "[[pkgbuild]]") {
            set found_name = "" :str mut
            set found_url = "" :str mut
            set j = i + 1 :i64 mut
            while j < vec::len(lines) {
                set next_line = use! util::trim(lines at j)
                if use! strings::starts::with(next_line "[[") { break }
                if use! strings::starts::with(next_line "name =") {
                    set found_name = use! semver::extract_str_val(next_line)
                }
                if found_name == name {
                    if use! strings::starts::with(next_line "url =") {
                        set found_url = use! semver::extract_str_val(next_line)
                    }
                }
                set j += 1
            }
            if found_name == name && len(found_url) > 0 {
                return found_url
            }
        }
        set i += 1
    }
    return ""
}

pub fn security_policy: (name :&str) :str {
    set f = use! pkgbuild::db_file()
    if !fs::exists(f) { return "unknown" }
    set content = fs::read(f)
    set lines = strings::split(content "\n")
    set i = 0 :i64 mut
    while i < vec::len(lines) {
        set line = use! util::trim(lines at i)
        if use! strings::starts::with(line "[[pkgbuild]]") {
            set found_name = "" :str mut
            set found_policy = "" :str mut
            set j = i + 1 :i64 mut
            while j < vec::len(lines) {
                set next_line = use! util::trim(lines at j)
                if use! strings::starts::with(next_line "[[") { break }
                if use! strings::starts::with(next_line "name =") {
                    set found_name = use! semver::extract_str_val(next_line)
                }
                if found_name == name {
                    if use! strings::starts::with(next_line "policy =") {
                        set found_policy = use! semver::extract_str_val(next_line)
                    }
                }
                set j += 1
            }
            if found_name == name {
                return found_policy
            }
        }
        set i += 1
    }
    return "unknown"
}

pub fn security_info: (name :&str) {
    set f = use! pkgbuild::db_file()
    if !fs::exists(f) {
        use dasu("  [FAIL]  PKGBUILD database not initialized")
        return
    }
    set content = fs::read(f)
    set lines = strings::split(content "\n")
    set i = 0 :i64 mut
    while i < vec::len(lines) {
        set line = use! util::trim(lines at i)
        if use! strings::starts::with(line "[[pkgbuild]]") {
            set found_name = "" :str mut
            set j = i + 1 :i64 mut
            while j < vec::len(lines) {
                set next_line = use! util::trim(lines at j)
                if use! strings::starts::with(next_line "[[") { break }
                if use! strings::starts::with(next_line "name =") {
                    set found_name = use! semver::extract_str_val(next_line)
                }
                if found_name == name {
                    if use! strings::starts::with(next_line "verify_checksum =") {
                        set v = use! semver::extract_str_val(next_line)
                        use dasu("  verify_checksum: " + v)
                    }
                    if use! strings::starts::with(next_line "verify_signature =") {
                        set v = use! semver::extract_str_val(next_line)
                        use dasu("  verify_signature: " + v)
                    }
                    if use! strings::starts::with(next_line "require_ssl =") {
                        set v = use! semver::extract_str_val(next_line)
                        use dasu("  require_ssl: " + v)
                    }
                    if use! strings::starts::with(next_line "allow_unsigned =") {
                        set v = use! semver::extract_str_val(next_line)
                        use dasu("  allow_unsigned: " + v)
                    }
                    if use! strings::starts::with(next_line "policy =") {
                        set v = use! semver::extract_str_val(next_line)
                        use dasu("  security_policy: " + v)
                    }
                    if use! strings::starts::with(next_line "ieee_compliant =") {
                        set v = use! semver::extract_str_val(next_line)
                        use dasu("  ieee_compliant: " + v)
                    }
                    if use! strings::starts::with(next_line "cve_check =") {
                        set v = use! semver::extract_str_val(next_line)
                        use dasu("  cve_check: " + v)
                    }
                    if use! strings::starts::with(next_line "signature_required =") {
                        set v = use! semver::extract_str_val(next_line)
                        use dasu("  signature_required: " + v)
                    }
                }
                set j += 1
            }
        }
        set i += 1
    }
}

fn sc: (a :&str, b :&str) :str {
    return strings::concat(a b)
}

pub fn run: (args :&vec[str]) {
    if vec::len(args) < 2 {
        use dasu("Usage: owl pkgbuild <init|list|add|find|checksum|url|security|info> [args...]")
        return
    }
    set sub = vec::get::str(args 1)
    match sub {
        "init" { use! pkgbuild::init() }
        "list" { use! pkgbuild::list() }
        "add" {
            if vec::len(args) < 6 {
                use dasu("Usage: owl pkgbuild add <name> <version> <url> <sha256> <description>")
            } else {
                set name = strings::copy(vec::get::str(args 2))
                set version = strings::copy(vec::get::str(args 3))
                set url = vec::get::str(args 4)
                set sha256 = vec::get::str(args 5)
                set desc = strings::copy(vec::get::str(args 5))
                if use! pkgbuild::add(name version url sha256 desc) {
                    use dasu("  [OK]    PKGBUILD added")
                } else {
                    use dasu("  [FAIL]  could not add PKGBUILD")
                }
            }
        }
        "find" {
            if vec::len(args) < 3 {
                use dasu("Usage: owl pkgbuild find <name>")
            } else {
                set name = strings::copy(vec::get::str(args 2))
                set ver = use! pkgbuild::lookup(name)
                if len(ver) > 0 {
                    use dasu("  " + name + " version " + ver)
                } else {
                    use dasu("  package '" + name + "' not found in PKGBUILD database")
                }
            }
        }
        "checksum" {
            if vec::len(args) < 3 {
                use dasu("Usage: owl pkgbuild checksum <name>")
            } else {
                set name = strings::copy(vec::get::str(args 2))
                set sha = use! pkgbuild::get_checksum_from_db(name)
                if len(sha) > 0 {
                    use dasu("  " + name + " sha256: " + sha)
                } else {
                    use dasu("  no checksum recorded for '" + name + "'")
                }
            }
        }
        "url" {
            if vec::len(args) < 3 {
                use dasu("Usage: owl pkgbuild url <name>")
            } else {
                set name = strings::copy(vec::get::str(args 2))
                set url = use! pkgbuild::get_source_url(name)
                if len(url) > 0 {
                    use dasu("  " + name + " source: " + url)
                } else {
                    use dasu("  no source URL recorded for '" + name + "'")
                }
            }
        }
        "security" {
            if vec::len(args) < 3 {
                use dasu("Usage: owl pkgbuild security <name>")
            } else {
                set name = strings::copy(vec::get::str(args 2))
                set policy = use! pkgbuild::security_policy(name)
                use dasu("  " + name + " security policy: " + policy)
            }
        }
        "info" {
            if vec::len(args) < 3 {
                use dasu("Usage: owl pkgbuild info <name>")
            } else {
                set name = strings::copy(vec::get::str(args 2))
                use! pkgbuild::security_info(name)
            }
        }
        _ { use dasu("Unknown pkgbuild subcommand: " + sub)
            use dasu("Available: init, list, add, find, checksum, url, security, info") }
    }
}