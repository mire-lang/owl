module export

load mire::vec
load! /code/util
load kioto::fs
load kioto::strings
load kioto::proc
load kioto::time
load! /code/args
load! /code/_externs
load! /code/cfg
load! /code/build

/! Export package: build and create .tar.lzma artifact using internal codecs
    (no external 7z, tar, xz binaries).
    Artifacts: .so, .a, .o + metadata in tarball.
!/
pub fn run: (args :&vec[str]) :u8 {
    set ec = 0 :u8 mut
    set dry_run = use! args::flag::has(args "--dry-run")

    if !use! util::has_project() {
        use dasu("error: no owl.toml found in current directory")
        return 1 :u8
    }

    set name = use! util::toml_get("owl.toml" "project" "name")
    set ver = use! util::toml_get("owl.toml" "project" "version")

    if name == "" || ver == "" {
        use dasu("error: [project].name and [project].version required in owl.toml")
        return 1 :u8
    }

    /! ── status() verification ─────────────────────────────────────────
        Mire Lang organization recommends every library expose a `status()`
        function (phpinfo-style console report) so consumers can inspect
        what a loaded library provides. Check whether the library being
        exported defines `status`; warn if missing but do not block export. !/
    set status_found = false :bool mut
    set entry = use! util::toml_get("owl.toml" "project" "entry")
    if len(entry) > 0 && use! fs::exists(entry) {
        set content = use! fs::read(entry)
        if use! strings::contains(content "pub fn status") {
            set status_found = true
        }
    }
    if !status_found {
        use dasu("  [WARN] Mire Lang organization recommends adding a `status()` function to libraries.")
        use dasu("         Add: pub fn status: () :str { ... } returning a phpinfo-style report.")
        use dasu("         See: https://github.com/mire-lang/Avenys-rust#library-status")
    }

    /! Resolve artifact types from [build] section or default to all !/
    set artifacts = use! export::resolve_artifacts()

    /! Build the package first (installs dev deps automatically) !/
    use dasu("  [BUILD] building " + name + "@" + ver + " for export")
    set build_ok = use! build::compile(args false)
    if !build_ok {
        use dasu("  [FAIL] build failed")
        return 1 :u8
    }

    /! Collect built artifacts !/
    set artifact_files = use! export::collect_artifacts(artifacts)
    if vec::len(artifact_files) == 0 {
        use dasu("  [WARN] no artifacts found to export")
    }

    /! Create manifest for the package !/
    set manifest = use! export::create_manifest(name ver artifacts)

    if dry_run {
        use dasu("  [DRY-RUN] would export " + name + "@" + ver)
        set i = 0 :i64 mut
        while i < vec::len(artifact_files) {
            set msg = strings::concat("    " vec::get::str(artifact_files i))
            use dasu(msg)
            set i += 1
        }
        return 0 :u8
    }

    /! Create tar.lzma package !/
    set out_name = name + "-" + ver + ".tar.lzma"
    use dasu("  [PACK] creating " + out_name)
    set ok = use! export::create_tar_lzma(out_name artifact_files manifest)
    if !ok {
        use dasu("  [FAIL] could not create package archive")
        return 1 :u8
    }

    /! Sign the package (placeholder - needs ed25519 key) !/
    set sig_name = out_name + ".sig"
    /! export::sign(out_name sig_name) !/

    use dasu("  [OK]   exported " + out_name)
    return 0 :u8
}

/! Resolve which artifacts to export from [build] section or defaults !/
pub fn resolve_artifacts: () :vec[str] {
    set result = [] :vec[str] mut
    /! Check [build].artifacts or default to all !/
    set list = use! util::toml_get("owl.toml" "build" "artifacts")
    if len(list) > 0 {
        set parts = strings::split(list ",")
        set i = 0 :i64 mut
        while i < vec::len(parts) {
            set a = use! util::trim(parts at i)
            if len(a) > 0 { set result = vec::push::str(result a) }
            set i += 1
        }
    } else {
        /! Default: shared, static, object !/
        set result = vec::push::str(result "so")
        set result = vec::push::str(result "a")
        set result = vec::push::str(result "o")
    }
    return result
}

/! Find built artifacts in bin/ directory !/
pub fn collect_artifacts: (wanted :&vec[str]) :vec[str] {
    set result = [] :vec[str] mut
    set bin_dir = "bin"
    if !use! fs::exists(bin_dir) { return result }

    set entries = use! fs::list(bin_dir)
    set i = 0 :i64 mut
    while i < vec::len(entries) {
        set entry = vec::get::str(entries i)
        set full = strings::concat(bin_dir "/") entry
        /! Check if matches wanted types !/
        set matched = false :bool mut
        set j = 0 :i64 mut
        while j < vec::len(wanted) {
            set w = vec::get::str(wanted j)
            if (w == "so" && use! strings::ends::with(full ".so")) ||
               (w == "a" && use! strings::ends::with(full ".a")) ||
               (w == "o" && use! strings::ends::with(full ".o")) {
                set matched = true
            }
            set j += 1
        }
        if matched { set result = vec::push::str(result full) }
        set i += 1
    }
    return result
}

/! Create manifest.toml for the package !/
pub fn create_manifest: (name :&str ver :&str artifacts :&vec[str]) :str {
    set q = "\"" :str mut
    set m = "[package]" :str mut
    set m = strings::concat(m q) :str mut
    set m = strings::concat(m "name = ") :str mut
    set m = strings::concat(m q) :str mut
    set m = strings::concat(m name) :str mut
    set m = strings::concat(m q) :str mut
    set m = strings::concat(m "\nversion = ") :str mut
    set m = strings::concat(m q) :str mut
    set m = strings::concat(m ver) :str mut
    set m = strings::concat(m q) :str mut
    set m = strings::concat(m "\n\n") :str mut
    set m = strings::concat(m "[artifacts]\n") :str mut
    set i = 0 :i64 mut
    while i < vec::len(artifacts) {
        set a = vec::get::str(artifacts i) :str mut
        set m = strings::concat(strings::concat(strings::concat(m a) " = true\n") "") :str mut
        set i += 1
    }
    set m = strings::concat(m "\n[build]\ntimestamp = ") :str mut
    set ts_ms = use! time::now::ms() :i64 mut
    set ts = use! strings::from::i64(ts_ms) :str mut
    set m = strings::concat(m q) :str mut
    set m = strings::concat(m ts) :str mut
    set m = strings::concat(m q) :str mut
    set m = strings::concat(m "\n") :str mut
    return m
}

/! Create tar.lzma archive using internal codecs (no external tools) !/
pub fn create_tar_lzma: (out_name :&str files :&vec[str] manifest :&str) :bool {
    /! Write manifest to a temp file !/
    set manifest_path = ".owl_export_manifest.toml"
    use! fs::write(manifest_path manifest)
    if !use! fs::exists(manifest_path) { return false }

    set all_files = [] :vec[str] mut
    /! Add manifest first !/
    set all_files = vec::push::str(all_files manifest_path)
    /! Add artifact files !/
    set i = 0 :i64 mut
    while i < vec::len(files) {
        set all_files = vec::push::str(all_files vec::get::str(files i))
        set i += 1
    }

    /! The pure-Mire tar+LZMA encoder is not available yet. Do not call an
        undeclared archive module or silently invoke an external tool. !/
    use dasu("  [UNAVAILABLE] pure-Mire tar.lzma export is not implemented")
    use! fs::remove(manifest_path)
    return false
}
