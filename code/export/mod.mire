load! /code/util
load! /code/crypto
load! /code/args

pub fn cmd_export: (args :&vec[str]) {
    set proceed = true :bool mut
    if !use! util::has_project() {
        use dasu("error: no owl.toml found")
        set proceed = false
    }

    if proceed {
        set name = use! util::toml_get("owl.toml" "project" "name")
        set ver = use! util::toml_get("owl.toml" "project" "version")

        if name == "" || ver == "" {
            use dasu("error: [project].name and [project].version required in owl.toml")
            set proceed = false
        }

        if proceed {
            set sources = use! util::toml_get("owl.toml" "paths" "sources") :str mut
            if sources == "" { set sources = "code" }

            set check_only = use! args::has_flag(args "--check")
            set dry_run = use! args::has_flag(args "--dry-run")

            if check_only {
                use dasu("  checking " + name + " v" + ver + "...")
                if !fs::exists(sources) {
                    use dasu("  error: sources directory \"" + sources + "\" not found")
                    set proceed = false
                }
                 if proceed {
                     set t = use! util::trim(proc::run::output("which" ["tar"]))
                     set z = use! util::trim(proc::run::output("which" ["zstd"]))
                     set o = use! util::trim(proc::run::output("which" ["openssl"]))
                     if t == "" { use dasu("  warning: tar not found") }
                     if z == "" { use dasu("  warning: zstd not found") }
                     if o == "" { use dasu("  warning: openssl not found (signing unavailable)") }
                     use dasu("  check passed")
                 }
            } else {
                set archive = name + "-" + ver + ".tar.zst"
                set sig_file = archive + ".sig"
                set pub_file = name + "-" + ver + ".pub"

                use dasu("  exporting " + name + " v" + ver + "...")

                 set a2 = archive :str
                 set tar_args = [] :vec[str] mut
                 set tar_args = vec::push::str(tar_args "--zstd")
                 set tar_args = vec::push::str(tar_args "-cf")
                 set tar_args = vec::push::str(tar_args strings::copy(archive))
                 set tar_args = vec::push::str(tar_args strings::copy(sources))
                 use! proc::run::output("tar" tar_args)
                 set tar_ok = use! proc::run::last_exit() == 0 :bool mut

                 if !tar_ok {
                     set tar_args2 = [] :vec[str] mut
                     set tar_args2 = vec::push::str(tar_args2 "-I")
                     set tar_args2 = vec::push::str(tar_args2 "zstd")
                     set tar_args2 = vec::push::str(tar_args2 "-cf")
                     set tar_args2 = vec::push::str(tar_args2 strings::copy(archive))
                     set tar_args2 = vec::push::str(tar_args2 strings::copy(sources))
                     use! proc::run::output("tar" tar_args2)
                     set tar_ok = use! proc::run::last_exit() == 0
                 }

                if !tar_ok {
                    use dasu("  error: failed to create archive (tar + zstd required)")
                    set proceed = false
                }

                if proceed {
                    set hash = use! crypto::crypto_sha256(a2)
                    if hash == "" {
                        use dasu("  error: failed to checksum " + archive)
                        set proceed = false
                    }

                    if proceed && !dry_run {
                        set keys_dir = use! util::owl_home_keys()
                        set priv_key = keys_dir + "/id_ed25519"
                        set pub_key = keys_dir + "/id_ed25519.pub"

                         if !fs::exists(priv_key) {
                             use! util::mkdir_p(keys_dir)
                             set gk_args = [] :vec[str] mut
                             set gk_args = vec::push::str(gk_args "genpkey")
                             set gk_args = vec::push::str(gk_args "-algorithm")
                             set gk_args = vec::push::str(gk_args "ed25519")
                             set gk_args = vec::push::str(gk_args "-out")
                             set gk_args = vec::push::str(gk_args strings::copy(priv_key))
                             use proc::run::output("openssl" gk_args)
                             set pk_args = [] :vec[str] mut
                             set pk_args = vec::push::str(pk_args "pkey")
                             set pk_args = vec::push::str(pk_args "-in")
                             set pk_args = vec::push::str(pk_args strings::copy(priv_key))
                             set pk_args = vec::push::str(pk_args "-pubout")
                             set pk_args = vec::push::str(pk_args "-out")
                             set pk_args = vec::push::str(pk_args strings::copy(pub_key))
                             use proc::run::output("openssl" pk_args)
                             if !fs::exists(priv_key) {
                                 use dasu("  error: failed to generate signing key (openssl required)")
                                 set proceed = false
                             }
                         }

                         if proceed {
                             set b64_args = [] :vec[str] mut
                             set b64_args = vec::push::str(b64_args "-w0")
                             set b64_args = vec::push::str(b64_args strings::copy(pub_key))
                             set pubkey_b64 = use! util::trim(proc::run::output("base64" b64_args))
                             set sign_args = [] :vec[str] mut
                             set sign_args = vec::push::str(sign_args "pkeyutl")
                             set sign_args = vec::push::str(sign_args "-sign")
                             set sign_args = vec::push::str(sign_args "-inkey")
                             set sign_args = vec::push::str(sign_args strings::copy(priv_key))
                             set sign_args = vec::push::str(sign_args "-in")
                             set sign_args = vec::push::str(sign_args strings::copy(archive))
                             set sign_args = vec::push::str(sign_args "-rawin")
                             set sig_b64 = use! util::trim(proc::run::output("openssl" sign_args))

                             if sig_b64 == "" {
                                 use dasu("  error: failed to sign " + archive)
                                 set proceed = false
                             }

                             if proceed {
                                 set sig_tmp = use! crypto::crypto_tempdir("owl-sig")
                                 if sig_tmp != "" {
                                     set sig_in = sig_tmp + "/sig.b64"
                                     use fs::write(sig_in sig_b64)
                                     set bd_args = [] :vec[str] mut
                                     set bd_args = vec::push::str(bd_args "-d")
                                     set bd_args = vec::push::str(bd_args "-i")
                                     set bd_args = vec::push::str(bd_args strings::copy(sig_in))
                                     set bd_args = vec::push::str(bd_args "-o")
                                     set bd_args = vec::push::str(bd_args strings::copy(sig_file))
                                     use proc::run::output("base64" bd_args)
                                     set rm_sig = [] :vec[str] mut
                                     set rm_sig = vec::push::str(rm_sig "-rf")
                                     set rm_sig = vec::push::str(rm_sig strings::copy(sig_tmp))
                                     use proc::run::output("rm" rm_sig)
                                 }
                                 set cp_args = [] :vec[str] mut
                                 set cp_args = vec::push::str(cp_args strings::copy(pub_key))
                                 set cp_args = vec::push::str(cp_args strings::copy(pub_file))
                                 use proc::run::output("cp" cp_args)

                                set publish = "[package]\n" :str mut
                                set publish = publish + "name = \"" + name + "\"\n"
                                set publish = publish + "version = \"" + ver + "\"\n"
                                set publish = publish + "archive = \"" + archive + "\"\n"
                                set publish = publish + "sha256 = \"" + hash + "\"\n"
                                if pubkey_b64 != "" {
                                    set publish = publish + "public-key = \"" + pubkey_b64 + "\"\n"
                                }
                                set publish = publish + "signature = \"" + sig_b64 + "\"\n"
                                use fs::write("publish.toml" publish)

                                use dasu("  created " + archive)
                                use dasu("  created " + sig_file)
                                use dasu("  created publish.toml")
                                use dasu("  done")
                            }
                        }
                    }

                    if proceed && dry_run {
                        set publish = "[package]\n" :str mut
                        set publish = publish + "name = \"" + name + "\"\n"
                        set publish = publish + "version = \"" + ver + "\"\n"
                        set publish = publish + "archive = \"" + archive + "\"\n"
                        set publish = publish + "sha256 = \"" + hash + "\"\n"
                        use fs::write("publish.toml" publish)

                        use dasu("  created " + archive)
                        use dasu("  created publish.toml")
                        use dasu("  done")
                    }
                }
            }
        }
    }
    return
}
