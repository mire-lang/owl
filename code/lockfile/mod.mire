module lockfile

load mire::vec
load! /code/util
load! /code/_externs

pub fn exists: () :bool {
    return fs::exists("owl.lock")
}

/! Get a specific field from a lockfile package entry by name.
   Fields: "version", "path", "registry", "abi"
!/
pub fn get_field: (pkg_name :str field_name :str) :str {
    set val = "" :str mut
    if !use! lockfile::exists() { return val }

    set content = fs::read("owl.lock")
    if content == "" { return val }

    set search_name = "name     = \"" + pkg_name + "\""
    set name_pos = strings::index(content search_name)
    if name_pos < 0 { return val }

    set block = strings::substr(content name_pos len(content) - name_pos) :str mut
    set next_header = strings::index(block "\n[[package]]")
    if next_header >= 0 { set block = strings::substr(block 0 next_header) }

    set field_search = "\n" + field_name + "     = \"" :str mut
    if field_name == "abi" { set field_search = "\n" + field_name + "      = " }
    if field_name == "registry" { set field_search = "\nregistry = \"" }
    if field_name == "version" { set field_search = "\nversion  = \"" }
    if field_name == "path" { set field_search = "\npath     = \"" }

    set fpos = strings::index(block field_search)
    if fpos >= 0 {
        set vstart = fpos + len(field_search)
        set after_val = strings::substr(block vstart 9999)
        if field_name == "abi" {
            set vend = strings::index(after_val "\n") :i64 mut
            if vend < 0 { set vend = len(after_val) }
            set val = use! util::trim_substr(after_val 0 vend)
        } else {
            set vend = strings::index(after_val "\"")
            if vend >= 0 { set val = strings::substr(after_val 0 vend) }
        }
    }

    return val
}

pub fn in_sync: () :bool {
    set ok = false :bool mut
    if use! lockfile::exists() {
        set content = fs::read("owl.lock")
        if content != "" {
            /! The manifest digest catches changes outside dependency lines
               (cfg, paths, publisher and security settings). This makes a
               lockfile stale as soon as owl.toml changes materially. !/
            set expected_manifest = use! util::sha256sum_hex("owl.toml")
            set lock_content = strings::copy(content)
            set locked_manifest = use! util::toml_get_from_string(lock_content "lock" "manifest-sha256")
            if locked_manifest == "" || expected_manifest == "" || locked_manifest != expected_manifest {
                return false
            }
            if strings::contains(content "no dependencies") {
                set ok = use! deps::count_deps() == 0
            } else {
        set lock_str = use! lockfile::packages()
                set lock_str_len = len(lock_str)
                set toml_names = use! deps::get_dep_names()
                set toml_count = use! deps::count_deps()

                set lock_count = 0 :i64 mut
                set lcount_pos = 0 :i64 mut
                while lcount_pos < lock_str_len {
                    set lrem = strings::substr(lock_str lcount_pos lock_str_len - lcount_pos)
                    set lnl = strings::index(lrem "\n")
                    if lnl < 0 {
                        if use! util::trim(lrem) != "" { set lock_count += 1 }
                        set lcount_pos = lock_str_len
                    } else {
                        if use! util::trim_substr(lock_str lcount_pos lnl) != "" { set lock_count += 1 }
                        set lcount_pos = lcount_pos + lnl + 1
                    }
                }

                if lock_count == toml_count {
                    set ok = true
                    set pos = 0 :i64 mut
                    set nlen = len(toml_names)
                    while pos < nlen {
                        set remaining_toml = strings::substr(toml_names pos nlen - pos)
                        set nl0 = strings::index(remaining_toml "\n")
                        set end = 0 :i64 mut
if nl0 < 0 { set end = nlen } else { set end = pos + nl0 }
                        set name_line0 = strings::substr(toml_names pos end - pos)
                        set dep_name = use! util::trim(name_line0)
                        set pos = end + 1
                        if dep_name != "" {
                            set found = false :bool mut
                            set lpos = 0 :i64 mut
                            set lnlen = len(lock_str)
                            while lpos < lnlen {
                                set lrem = strings::substr(lock_str lpos lnlen - lpos)
                                set lnl = strings::index(lrem "\n")
                                set lend = 0 :i64 mut
                                if lnl < 0 { set lend = lnlen } else { set lend = lpos + lnl }
                                set lname_line = strings::substr(lock_str lpos lend - lpos)
                                set lnm = use! util::trim(lname_line)
                                if lnm == dep_name { set found = true }
                                set lpos = lend + 1
                                if lpos >= lnlen { break }
                            }
                            /! Hash/drift hardening: the lockfile must agree with
                               owl.toml on the resolved version AND path for every
                               dep. A version bump or path change in owl.toml makes
                               the lockfile out of sync (forces `owl install`). !/
                            if found {
                                set dn1 = strings::copy(dep_name)
                                set dn2 = strings::copy(dep_name)
                                set dn3 = strings::copy(dep_name)
                                set dn4 = strings::copy(dep_name)
                                set tv = use! deps::get_dep_field(dn1 "version")
                                set lv = use! lockfile::get_field(dn2 "version")
                                if tv != "" && lv != "" && tv != lv { set found = false }
                                set tp = use! deps::get_dep_field(dn3 "path")
                                set lp = use! lockfile::get_field(dn4 "path")
                                if tp != "" && lp != "" && tp != lp { set found = false }
                            }
                            if !found { set ok = false }
                        }
                    }
                }
            }
        }
    }
    return ok
}

pub fn packages: () :str {
    set result = "" :str mut
    if use! lockfile::exists() {
        set content = fs::read("owl.lock")
        if content != "" {
            set search = "[[package]]"
            set pos = 0 :i64 mut
            set clen = len(content)
            set running = true :bool mut
            while running {
                set remaining = strings::substr(content pos clen - pos)
                set idx = strings::index(remaining search)
                if idx < 0 { set running = false } else {
                    set pkg_start = pos + idx
                    set after_this = strings::substr(content pkg_start + len("[[package]]") clen - pkg_start - len("[[package]]"))
                    set next_pkg = strings::index(after_this "[[package]]")
                    set pkg_end = 0 :i64 mut
                    if next_pkg >= 0 { set pkg_end = pkg_start + len("[[package]]") + next_pkg } else { set pkg_end = clen }
                    set pkg_content = strings::substr(content pkg_start pkg_end - pkg_start)
                    set name_search = "\nname     = \""
                    set npos = strings::index(pkg_content name_search)
                    if npos >= 0 {
                        set nstart = npos + len(name_search)
                        set after_name = strings::substr(pkg_content nstart len(pkg_content) - nstart)
                        set nend = strings::index(after_name "\"")
                        if nend >= 0 {
                            set pkg_name = strings::substr(after_name 0 nend)
                            if result == "" { set result = pkg_name } else { set result = result + "\n" + pkg_name }
                        }
                    }
                    set pos = pkg_end
                    if pos >= clen { set running = false }
                }
            }
        }
    }
    return result
}

pub fn count: (names :str) :i64 {
    set count = 0 :i64 mut
    if names != "" {
set pos = 0 :i64 mut
            set gen_nlen = len(names) :i64 mut
            set running = true :bool mut
        while running {
            set remaining = strings::substr(names pos gen_nlen - pos)
            set nl_c = strings::index(remaining "\n")
            if nl_c < 0 {
                if use! util::trim(remaining) != "" { set count += 1 }
                set running = false
            } else {
                if use! util::trim_substr(names pos nl_c) != "" { set count += 1 }
                set pos = pos + nl_c + 1
                if pos >= gen_nlen { set running = false }
            }
        }
    }
    return count
}

pub fn generate: () :bool {
    set ok = false :bool mut
    set dep_count = use! deps::count_deps()

    // Determine lockfile version - default to V3
    set lock_version = use! util::toml_get("owl.toml" "owl@lock" "version") :str mut
    if lock_version == "" {
        set lock_version = "3"
        use! util::toml_set("owl.toml" "owl@lock" "version" "3")
    }

    /! If no [dependencies] entries exist, scan source files for `load`
       statements and resolve them from ~/.owl/libs to populate the lockfile.
       This ensures reproducible builds even when owl.toml hasn't been
       explicitly configured with `owl load` or `owl checkup --fix loads`.
    !/
    if dep_count == 0 {
        set scanned = use! util::scan_load_packages()
        set lib_dir = use! util::owl_home_libs()
        set lib_display = use! util::owl_home_libs_display()
if scanned == "" {
            set manifest_hash = use! util::sha256sum_hex("owl.toml") :str mut
            use fs::write("owl.lock" "# Generated by owl - do not edit manually\n\n[lock]\nmanifest-sha256 = \"" + manifest_hash + "\"\n\n# no dependencies\n")
            set ok = true
        } else {
            set manifest_hash = use! util::sha256sum_hex("owl.toml")
            set header = "# Generated by owl - do not edit manually\n\n[lock]\nmanifest-sha256 = \"" + manifest_hash + "\"\n\n"
            set content = header :str mut
            set first = true :bool mut
            set scanned_len = len(scanned)
            set pos = 0 :i64 mut
            while pos < scanned_len {
                set rem = strings::substr(scanned pos scanned_len - pos)
                set nl11 = strings::index(rem "\n") :i64 mut
                set end = 0 :i64 mut
                if nl11 < 0 { set end = scanned_len } else { set end = pos + nl11 }
                set line = strings::substr(scanned pos end - pos)
                set pkg = use! util::trim(line)
                set pos = end + 1
                if pkg != "" {
                    set toml_path = lib_dir + "/" + pkg + "/owl.toml"
                    if fs::exists(toml_path) {
                        set ver = use! util::toml_get(toml_path "project" "version") :str mut
                        if ver == "" { set ver = "0.1.0" }
                        if !first { set content = content + "\n" } else { set first = false }
                        set entry = "[[package]]\n" :str mut
                        set entry = entry + "name     = \"" + pkg + "\"\n"
                        set entry = entry + "version  = \"" + ver + "\"\n"
                        set entry = entry + "path     = \"" + lib_display + "/" + pkg + "\"\n"
                        set entry = entry + "registry = \"local\"\n"
                        set content = content + entry
                    }
                }
            }
            use fs::write("owl.lock" content)
            set ok = true
        }
    } else {
        set manifest_hash = use! util::sha256sum_hex("owl.toml")
        set header = "# Generated by owl - do not edit manually\n\n[lock]\nmanifest-sha256 = \"" + manifest_hash + "\"\n\n"
        
        set names = use! deps::get_dep_names()
        if names == "" {
set sha_main = use! util::sha256sum_hex("owl.toml")
            if sha_main != "" {
                set sha_cache = use! util::sha256sum_hex("owl.toml")
                set res_dir = use! util::owl_home() + "/cache/resolution/" + strings::copy(sha_cache)
                use! util::mkdir_p(res_dir)
                /! Skip cache write for now to avoid ownership issues !/
                /! use fs::write(res_dir + "/lock.toml" "# Generated by owl - do not edit manually\n\n[lock]\nmanifest-sha256 = \"" + sha_cache + "\"\n\n") !/
            }
            use fs::write("owl.lock" "# Generated by owl - do not edit manually\n\n[lock]\nmanifest-sha256 = \"" + sha_main + "\"\n\n")
        } else {
            /! Collect package entries in a vector for double-write !/
            set entries = [] :vec[str] mut
            
            set pos = 0 :i64 mut
            set gen_nlen = 0 :i64 mut
            set gen_nlen = len(names)
            set running = true :bool mut
            while running {
                set remaining = strings::substr(names pos gen_nlen - pos) :str mut
                set nl2 = strings::index(remaining "\n") :i64 mut
                set end = 0 :i64 mut
                if nl2 < 0 { set end = gen_nlen } else { set end = pos + nl2 }
                set name_line2 = strings::substr(names pos end - pos) :str mut
                set dep_name = use! util::trim(name_line2) :str mut
                set pos = end + 1
                if dep_name != "" {
                    set dname = dep_name :str mut
                    set version = use! deps::get_dep_field(dname "version") :str mut
                    set dname2 = dep_name :str mut
                    set path = use! deps::get_dep_field(dname2 "path") :str mut
                    set dname3 = dep_name :str mut
                    set abi = use! deps::get_dep_field(dname3 "abi") :str mut
                    set dname4 = dep_name :str mut
                    set registry = use! deps::get_dep_field(dname4 "registry") :str mut
                    if path == "" && version != "" {
                        set resolved_version = use! semver::resolve_from_registry(dep_name version)
                        if resolved_version != "" { set version = resolved_version }
                    }
                    if registry == "" && path == "" {
                        set reg_dir = use! util::owl_home_registries()
                        set reg_arg = strings::copy(reg_dir)
                        set reg_list = use! util::list_text(reg_arg)
                        set rpos = 0 :i64 mut
                        set rlen = len(reg_list)
                        set resolved = false :bool mut
                        while rpos < rlen && !resolved {
                            set rrem = strings::substr(reg_list rpos rlen - rpos)
                            set rnl = strings::index(rrem "\n")
                            set rend = 0 :i64 mut
                            if rnl < 0 { set rend = rlen } else { set rend = rpos + rnl }
                            set rline = strings::substr(reg_list rpos rend - rpos)
                            set rname = use! util::trim(rline)
                            set rpos = rend + 1
                            if rname != "" {
                                set idx_path = reg_dir + "/" + rname + "/index.toml"
                                if fs::exists(idx_path) {
                                    set idx_content = fs::read(idx_path)
                                    set dep_copy = strings::copy(dep_name)
                                    set needle = "name = \"" + dep_copy + "\""
                                    if strings::index(idx_content needle) >= 0 {
                                        set registry = rname
                                        set resolved = true
                                    }
                                }
                            }
                        }
                    }
                    if registry == "" { set registry = "local" }

/! Collect package entries in a vector for double-write !/
            set entries = [] :vec[str] mut
            
            set pos = 0 :i64 mut
            set gen_nlen = 0 :i64 mut
            set gen_nlen = len(names)
            set running = true :bool mut
            while running {
                set remaining2 = strings::substr(names pos gen_nlen - pos)
                set nl3 = strings::index(remaining2 "\n")
                set end = 0 :i64 mut
                if nl3 < 0 { set end3 = gen_nlen } else { set end3 = pos + nl3 }
                set name_line3 = strings::substr(names pos end3 - pos)
                set dep_name3 = use! util::trim(name_line3)
                set pos3 = end3 + 1
                if dep_name3 != "" {
                    set dname = dep_name3 :str mut
                    set version = use! deps::get_dep_field(dname "version") :str mut
                    set dname2 = dep_name3 :str mut
                    set path = use! deps::get_dep_field(dname2 "path")
                    set dname3 = dep_name3 :str mut
                    set abi = use! deps::get_dep_field(dname3 "abi")
                    set dname4 = dep_name3 :str mut
                    set registry = use! deps::get_dep_field(dname4 "registry") :str mut
                    if path == "" && version != "" {
                        set resolved_version = use! semver::resolve_from_registry(dep_name3 version)
                        if resolved_version != "" { set version = resolved_version }
                    }
                    if registry == "" && path == "" {
                        set reg_dir = use! util::owl_home_registries()
                        set reg_arg = strings::copy(reg_dir)
                        set reg_list = use! util::list_text(reg_arg)
                        set rpos = 0 :i64 mut
                        set rlen = len(reg_list)
                        set resolved = false :bool mut
                        while rpos < rlen && !resolved {
                            set rrem = strings::substr(reg_list rpos rlen - rpos)
                            set rnl = strings::index(rrem "\n")
                            set rend = 0 :i64 mut
                            if rnl < 0 { set rend = rlen } else { set rend = rpos + rnl }
                            set rline = strings::substr(reg_list rpos rend - rpos)
                            set rname = use! util::trim(rline)
                            set rpos = rend + 1
                            if rname != "" {
                                set idx_path = reg_dir + "/" + rname + "/index.toml"
                                if fs::exists(idx_path) {
                                    set idx_content = fs::read(idx_path)
                                    set dep_copy = strings::copy(dep_name3)
                                    set needle = "name = \"" + dep_copy + "\""
                                    if strings::index(idx_content needle) >= 0 {
                                        set registry = rname
                                        set resolved = true
                                    }
                                }
                            }
                        }
                    }
                    if registry == "" { set registry = "local" }

                    set compiler = "" :str mut
                    set language = "" :str mut
                    if path != "" {
                        set meta_path = path + "/meta.toml" :str mut
                        if fs::exists(meta_path) {
                            set mp1 = meta_path :str
                            set mp2 = meta_path :str
                            set compiler = use! util::toml_get(mp1 "package" "compiler")
                            set language = use! util::toml_get(mp2 "package" "language")
                        }
                        set meta_path = path + "/meta.toml"
                        if fs::exists(meta_path) {
                            set mp1 = meta_path :str
                            set mp2 = meta_path :str
                            set compiler = use! util::toml_get(mp1 "package" "compiler")
                            set language = use! util::toml_get(mp2 "package" "language")
                        }
                        if compiler == "" {
                            set owl_at = path + "/owl.toml"
                            if fs::exists(owl_at) {
                                set compiler = use! util::toml_get(owl_at "build" "compiler")
                            }
                        }
                    }

                    set entry = "[[package]]\n" :str mut
                    set entry = entry + "name     = \"" + dep_name + "\"\n"
                    if version != "" { set entry = entry + "version  = \"" + version + "\"\n" }
                    if path != "" { set entry = entry + "path     = \"" + path + "\"\n" }
                    if registry != "" { set entry = entry + "registry = \"" + registry + "\"\n" }
                    if abi != "" { set entry = entry + "abi      = " + abi + "\n" }
                    if compiler != "" { set entry = entry + "compiler = \"" + compiler + "\"\n" }
                    if language != "" { set entry = entry + "language = \"" + language + "\"\n" }
                    set entries = vec::push::str(entries entry)
                }
                if nl3 < 0 { set running = false }
            }
            
            /! Build both content strings from entries !/
            set sha = use! util::sha256sum_hex("owl.toml")
            set sha_cache = strings::copy(sha)
            if sha != "" {
                set res_dir = use! util::owl_home_cache_resolution(sha)
                use! util::mkdir_p(res_dir)
            }
            /! Build both content strings from entries !/
            set content_owl = header :str mut
            set i = 0 :i64 mut
            set elen = vec::len(entries)
            while i < elen {
                set content_owl = content_owl + vec::get::str(entries i)
                set i += 1
            }
/! Skip cache write for now to avoid ownership issues - write main lock only !/
            set main_content = header + vec::join(entries "") :str mut
            use fs::write("owl.lock" main_content)
            set ok = true
        }
    }
    return ok
}

pub fn ensure: () :bool {
    set ok = true :bool mut
    if !use! lockfile::exists() {
        /! Fresh project: auto-generate V3 lockfile with owl.toml manifest hash
         and no locked dependencies yet.
         !/
        set manifest_hash_ensure = use! util::sha256sum_hex("owl.toml") :str mut
        set content = "# Generated by owl - do not edit manually\n\n[lock]\nmanifest-sha256 = \"" + manifest_hash_ensure + "\"\n\n# no dependencies\n"
        use fs::write("owl.lock" content)
        use dasu("  [OK]   lockfile auto-generated for fresh project (V3)")
    } else {
        /! Existing lockfile: validate checksum and apply update policy.
        !/
        set lock_content = fs::read("owl.lock")
        if lock_content != "" {
            set expected_manifest = use! util::toml_get_from_string(lock_content "lock" "manifest-sha256")
            set current_manifest = use! util::sha256sum_hex("owl.toml")
            if expected_manifest != current_manifest {
                /! owl.toml has changed: apply update@lock policy.
                 !/
                set cfg_lock = use! util::toml_get("owl.toml" "cfg" "lock") :str mut
                if cfg_lock == "" || cfg_lock == "1" {
                    /! Default: active verification with interactive prompt.
                     !/
                    use dasu("  [WARN] owl.toml has changed since last lockfile generation")
                    use dasu("  [WARN] Update lockfile now? (y/N): ")
                    set answer = use! util::read_line() :str mut
                    if answer == "y" || answer == "Y" {
                        use dasu("  [INFO] regenerating lockfile...")
                        use! lockfile::generate()
                        use dasu("  [OK]   lockfile updated")
                    } else {
                        use dasu("  [INFO] keeping existing lockfile (may be out of date)")
                        /! Skip revalidation to avoid false failures.
                         !/
                        set ok = true
                        return ok
                    }
                } else {
                    /! lock = 0: verification disabled, generate without strict checks.
                     !/
                    use dasu("  [OK]   lockfile: verification disabled (cfg lock = 0)")
                }
            } else {
                /! Checksum matches: lockfile is in sync, skip full validation.
                 !/
                use dasu("  [OK]   lockfile in sync (checksum matches)")
                set ok = true
                return ok
            }
        }
    }
    /! If we reach here, full validation should run (lockfile was updated or needs it).
     !/
    return ok
}

/! Validate all lockfile entries: check paths exist and packages are loadable.
   Returns true if all entries are valid.
!/
pub fn validate: () :bool {
    set ok = true :bool mut
    if !use! lockfile::exists() {
        use dasu("  [FAIL] owl.lock not found")
        return false
    }

    set content = fs::read("owl.lock")
    if content == "" {
        use dasu("  [FAIL] owl.lock is empty")
        return false
    }

    if strings::contains(content "no dependencies") {
        use dasu("  [OK]   lockfile: no dependencies (valid)")
        return true
    }

    set pos = 0 :i64 mut
    set clen = len(content)
    set pkg_count = 0 :i64 mut
    set valid_count = 0 :i64 mut

    while pos < clen {
        set remaining = strings::substr(content pos clen - pos)
        set idx = strings::index(remaining "[[package]]")
        if idx < 0 { set pos = clen } else {
            set pkg_start = pos + idx + len("[[package]]")
            set after_this = strings::substr(content pkg_start clen - pkg_start)
            set next_pkg = strings::index(after_this "[[package]]")
            set pkg_end = 0 :i64 mut
            if next_pkg >= 0 { set pkg_end = pkg_start + next_pkg } else { set pkg_end = clen }
            set pkg_content = strings::substr(content pkg_start pkg_end - pkg_start)

            set pkg_name = "" :str mut
            set pkg_ver = "" :str mut
            set pkg_path = "" :str mut
            set pkg_registry = "" :str mut

            set name_idx = strings::index(pkg_content "\nname     = \"")
            if name_idx >= 0 {
                set ns = name_idx + len("\nname     = \"")
                set ne = strings::index(strings::substr(pkg_content ns 9999) "\"")
                if ne >= 0 { set pkg_name = strings::substr(pkg_content ns ne) }
            }
            set ver_idx = strings::index(pkg_content "\nversion  = \"")
            if ver_idx >= 0 {
                set vs = ver_idx + len("\nversion  = \"")
                set ve = strings::index(strings::substr(pkg_content vs 9999) "\"")
                if ve >= 0 { set pkg_ver = strings::substr(pkg_content vs ve) }
            }
            set path_idx = strings::index(pkg_content "\npath     = \"")
            if path_idx >= 0 {
                set ps = path_idx + len("\npath     = \"")
                set pe = strings::index(strings::substr(pkg_content ps 9999) "\"")
                if pe >= 0 { set pkg_path = strings::substr(pkg_content ps pe) }
            }
            set reg_idx = strings::index(pkg_content "\nregistry = \"")
            if reg_idx >= 0 {
                set rs = reg_idx + len("\nregistry = \"")
                set re = strings::index(strings::substr(pkg_content rs 9999) "\"")
                if re >= 0 { set pkg_registry = strings::substr(pkg_content rs re) }
            }

            if pkg_name != "" {
                set pkg_count += 1
                set entry_ok = true :bool mut

                if pkg_path != "" {
                    set pkg_path_check = use! util::expand_home(pkg_path)
                    if !fs::exists(pkg_path_check) {
                        use dasu("  [FAIL] lockfile/" + pkg_name + ": path not found (" + pkg_path + ")")
                        set entry_ok = false
                        set ok = false
                    } else {
                        set toml_check = pkg_path_check + "/owl.toml"
                        if !fs::exists(toml_check) {
                            if !use! util::startswith(pkg_path "./") {
                                use dasu("  [WARN] lockfile/" + pkg_name + ": path exists but no owl.toml")
                            }
                        }
                    }
                } else {
                    if pkg_registry == "local" || pkg_registry == "" {
                        use dasu("  [WARN] lockfile/" + pkg_name + ": no path configured")
                    }
                }

                if entry_ok { set valid_count += 1 }

                set pos = pkg_end
            } else {
                set pos = pkg_end
            }
        }
    }

    if pkg_count == 0 {
        use dasu("  [OK]   lockfile: no packages")
    } else {
        if valid_count == pkg_count {
            use dasu("  [OK]   lockfile: " + use! util::i64_to_string(valid_count) + "/" + use! util::i64_to_string(pkg_count) + " entries valid")
        } else {
            use dasu("  [FAIL] lockfile: " + use! util::i64_to_string(valid_count) + "/" + use! util::i64_to_string(pkg_count) + " entries valid")
        }
    }

    return ok
}

/! Install all packages from lockfile that are not already present.
   Skips packages with registry="local" (symlinked/local packages).
!/
pub fn all: () :bool {
    set ok = true :bool mut
    if !use! lockfile::exists() {
        use dasu("  [FAIL] owl.lock not found - run 'owl install' or 'owl checkup' first")
        return false
    }

    set content = fs::read("owl.lock")
    if content == "" {
        use dasu("  [FAIL] owl.lock is empty")
        return false
    }

    if strings::contains(content "no dependencies") {
        use dasu("  [OK]   no packages to install")
        return true
    }

    set pos = 0 :i64 mut
    set clen = len(content)
    set installed = 0 :i64 mut
    set skipped = 0 :i64 mut
    set failed = 0 :i64 mut

    while pos < clen {
        set remaining = strings::substr(content pos clen - pos)
        set idx = strings::index(remaining "[[package]]")
        if idx < 0 { set pos = clen } else {
            set pkg_start = pos + idx + len("[[package]]")
            set after_this = strings::substr(content pkg_start clen - pkg_start)
            set next_pkg = strings::index(after_this "[[package]]")
            set pkg_end = 0 :i64 mut
            if next_pkg >= 0 { set pkg_end = pkg_start + next_pkg } else { set pkg_end = clen }
            set pkg_content = strings::substr(content pkg_start pkg_end - pkg_start)

            set pkg_name = "" :str mut
            set pkg_ver = "" :str mut
            set pkg_path = "" :str mut
            set pkg_registry = "" :str mut

            set name_idx = strings::index(pkg_content "\nname     = \"")
            if name_idx >= 0 {
                set ns = name_idx + len("\nname     = \"")
                set ne = strings::index(strings::substr(pkg_content ns 9999) "\"")
                if ne >= 0 { set pkg_name = strings::substr(pkg_content ns ne) }
            }
            set ver_idx = strings::index(pkg_content "\nversion  = \"")
            if ver_idx >= 0 {
                set vs = ver_idx + len("\nversion  = \"")
                set ve = strings::index(strings::substr(pkg_content vs 9999) "\"")
                if ve >= 0 { set pkg_ver = strings::substr(pkg_content vs ve) }
            }
            set path_idx = strings::index(pkg_content "\npath     = \"")
            if path_idx >= 0 {
                set ps = path_idx + len("\npath     = \"")
                set pe = strings::index(strings::substr(pkg_content ps 9999) "\"")
                if pe >= 0 { set pkg_path = strings::substr(pkg_content ps pe) }
            }
            set reg_idx = strings::index(pkg_content "\nregistry = \"")
            if reg_idx >= 0 {
                set rs = reg_idx + len("\nregistry = \"")
                set re = strings::index(strings::substr(pkg_content rs 9999) "\"")
                if re >= 0 { set pkg_registry = strings::substr(pkg_content rs re) }
            }

            if pkg_name != "" {
                if pkg_registry == "local" || pkg_registry == "" {
                    set skipped += 1
} else {
                        if pkg_path != "" && fs::exists(pkg_path) {
                            use dasu("  [OK]   " + pkg_name + " v" + pkg_ver + " already installed")
                            set skipped += 1
                        } else {
                            use dasu("  installing " + pkg_name + " v" + pkg_ver + " from " + pkg_registry + " ...")
                            use! install::package(pkg_name pkg_ver false false)
                            set installed += 1
                        }
                    }
            }

            set pos = pkg_end
        }
    }

    use dasu("")
    use dasu("  installed: " + use! util::i64_to_string(installed) + ", skipped: " + use! util::i64_to_string(skipped) + ", failed: " + use! util::i64_to_string(failed))
    return ok
}

/! Install a single package from lockfile by looking it up in registries.
   All subprocesses are argv-based (no shell); registry-index strings that
   reach the network (tarball URLs) are passed as argv, never interpolated
   into a shell command line.
!/
pub fn install_one: (pkg_name :str pkg_ver :str registry_name :str) {
    set reg_dir = use! util::owl_home_registries()
    set idx_path = reg_dir + "/" + registry_name + "/index.toml"

    if !fs::exists(idx_path) {
        use dasu("  [FAIL] " + pkg_name + ": registry '" + registry_name + "' not synced (run owl load -Ls)")
        return
    }

    set idx_content = fs::read(idx_path)
    set glines = strings::split(idx_content "\n")
    set gnl = len(glines)
    set gi = 0 :i64 mut
    set in_pkg = false :bool mut
    set tarball_line = "" :str mut
    set sha256_line = "" :str mut
    while gi < gnl {
        set gline = use! util::trim(use! util::list_get(glines gi))
        set eq = strings::index(gline "=")
        if eq > 0 {
            set after = strings::substr(gline eq + 1 9999) :str mut
            set after = use! util::trim(after)
            if use! util::startswith(after "\"") && use! util::endswith(after "\"") {
                set after = strings::substr(after 1 strings::len(after) - 2)
            } else {
                if use! util::startswith(after "\"") { set after = strings::substr(after 1 9999) }
            }
            if use! util::startswith(gline "name = ") {
                if after == pkg_name { set in_pkg = true } else { set in_pkg = false }
            }
            if in_pkg {
                if use! util::startswith(gline "tarball = ") { set tarball_line = after }
                if use! util::startswith(gline "sha256 = ") { set sha256_line = after }
            }
        }
        set gi += 1
    }

    if tarball_line == "" {
        use dasu("  [FAIL] " + pkg_name + ": not found in registry '" + registry_name + "'")
        return
    }

    set reg_url = "" :str mut
    set reg_json_path = reg_dir + "/" + registry_name + "/registry.json"
    if fs::exists(reg_json_path) {
        set reg_content = fs::read(reg_json_path)
        set reg_url = use! util::json_get_str(reg_content "url") :str mut
        if reg_url == "" { set reg_url = use! util::json_get_str(reg_content "name") }
    }

    if reg_url == "" {
        use dasu("  [FAIL] " + pkg_name + ": could not determine registry URL")
        return
    }

    set tarball_url = reg_url + "/" + tarball_line
    set tarball_file = use! util::owl_home() + "/cache/tarballs/" + pkg_name + "-" + pkg_ver + ".tar.zst"
    use! util::mkdir_p(use! util::owl_home() + "/cache/tarballs")

    use dasu("    downloading " + tarball_url + " ...")
    set curl_args = [] :vec[str] mut
    set curl_args = vec::push::str(curl_args "-sL")
    set curl_args = vec::push::str(curl_args "--fail")
    set curl_args = vec::push::str(curl_args "-o")
    set curl_args = vec::push::str(curl_args strings::copy(tarball_file))
    set curl_args = vec::push::str(curl_args strings::copy(tarball_url))
    set curl_out = rt_proc_capture_argv("curl" curl_args)

    if !fs::exists(tarball_file) {
        use dasu("  [FAIL] " + pkg_name + ": download failed")
        return
    }

    set stat_args = [] :vec[str] mut
    set stat_args = vec::push::str(stat_args "-c")
    set stat_args = vec::push::str(stat_args "%s")
    set stat_args = vec::push::str(stat_args strings::copy(tarball_file))
    set file_size = use! util::file_size(tarball_file)
    if file_size == 0 {
        use! util::rm_RF(tarball_file)
        use dasu("  [FAIL] " + pkg_name + ": download failed (empty file)")
        return
    }

    if sha256_line != "" {
        use dasu("    verifying SHA-256...")
        set actual = use! util::sha256sum_hex(tarball_file)
        if actual != "" && actual != sha256_line {
            use! util::rm_RF(tarball_file)
            use dasu("  [FAIL] " + pkg_name + ": SHA-256 mismatch")
            return
        }
        use dasu("    SHA-256 OK")
    }

    set pkg_dir = use! util::owl_home_libs() + "/" + pkg_name
    set pkg_dir2 = pkg_dir :str
    set pkg_dir3 = pkg_dir :str
    set pkg_dir4 = pkg_dir :str
    use! util::mkdir_p(pkg_dir)
    use dasu("    extracting...")
    set archive_status = owl_archive_extract(tarball_file pkg_dir2)
    if archive_status != 0 {
        use dasu("  [FAIL] " + pkg_name + ": libarchive/zstd extraction failed")
        use! util::rm_RF(tarball_file)
        return
    }

    set meta_path = pkg_dir3 + "/meta.toml"
    if !fs::exists(meta_path) {
        set meta = "[package]\n" :str mut
        set meta = meta + "name = \"" + pkg_name + "\"\n"
        set meta = meta + "version = \"" + pkg_ver + "\"\n"
        set meta = meta + "compiler = \"" + use! util::compiler_cmd() + "\"\n"
        set meta = meta + "abi = " + use! util::abi_version() + "\n"
        set meta = meta + "language = \"" + use! util::language_version() + "\"\n"
        use fs::write(meta_path meta)
    }

    use! util::fs_make_readonly(pkg_dir4)
    use! util::rm_RF(tarball_file)
    use dasu("  [OK]   installed " + pkg_name + " v" + pkg_ver)
}

/! Returns the SHA-512 of an installed package's `meta.toml`, kept in the shared
   checksum store at `~/.owl/cache/lockfile_checksums` under the key
   `<pkg>@<version>`. The digest is generated and persisted on first use; later
   calls verify the installed manifest has not changed. Returns "" when the
   package is not installed or hashing fails. !/
pub fn dependency_checksum: (pkg_name :str, installed_version :str) :str {
    set key = pkg_name + "@" + installed_version
    set store = use! util::expand_home("~/.owl/cache/lockfile_checksums")
    set meta_path = use! util::expand_home("~/.owl/libs/" + pkg_name + "/meta.toml")
    if !fs::exists(meta_path) { return "" }

    set expected = use! crypto::checksum::store_get(store key)
    set actual = use! crypto::checksum::file(meta_path)

    if expected != "" {
        if expected == actual {
            use dasu("  [OK]   " + key + ": checksum verificado")
            return expected
        }
        use dasu("  [WARN] " + key + ": checksum no coincide (esperado: " + expected + ", actual: " + actual + ")")
    } else {
        use dasu("  [INFO] " + key + ": generando checksum...")
    }

    if actual == "" { return "" }
    use! util::mkdir_p(use! util::expand_home("~/.owl/cache"))
    use! crypto::checksum::store_put(store key actual)
    use dasu("  [OK]   checksum guardado para " + key)
    return actual
}

pub fn exports_verified: (pkg_name :str) :bool {
    set ok = true :bool mut
    set lib_path = "~/.owl/libs/" + pkg_name :str mut
    if !fs::exists(lib_path) {
        use dasu("  [FAIL] " + pkg_name + ": lib path no encontrado")
        return false
    }
    set toml_path = lib_path + "/meta.toml" :str mut
    if !fs::exists(toml_path) {
        use dasu("  [FAIL] " + pkg_name + ": meta.toml no encontrado")
        return false
    }
    set content = fs::read(toml_path)
    set exports_idx = strings::index(content "exports")
    if exports_idx < 0 {
        use dasu("  [WARN] " + pkg_name + ": no hay exports en meta.toml")
        return true
    }
    set exports_content = strings::substr(content exports_idx 9999)
    set has_colon = strings::index(exports_content ":") >= 0
    if has_colon {
        use dasu("  [OK]   " + pkg_name + ": exports verificados (formato con ':')")
    } else {
        use dasu("  [WARN] " + pkg_name + ": exports sin formato de versión, verificar manualmente")
    }
    return true
}

pub fn lockfile_status: (owl_config_lock :bool cfg_update_lock :str) :str {
    set update_mode = cfg_update_lock :str mut
    if cfg_update_lock == "Build" {
        set update_mode = "always en build"
    } elif cfg_update_lock == "Changes" {
        set update_mode = "solo cuando hay cambios en owl.toml o loads"
    } else {
        set update_mode = "never (modo none)"
    }
    set lock_i = 0 :i64 mut
    if owl_config_lock { set lock_i = 1 }
    set status = "lockfile V3 status: lock=" + use! util::i64_to_string(lock_i) + " update@lock=" + update_mode :str mut
    if owl_config_lock {
        set status = status + " (active) - lockfile V3 generará checksum sha512"
    } else {
        set status = status + " (inactive) - lockfile se generará con formato por defecto"
    }
    return status
}

/! Restore owl.lock from canonical cache copy (owl checkup --fix lock).
   Returns true if restored successfully. !/
pub fn fix_lock: () :bool {
    if !use! util::has_project() { return false }
    set sha = use! util::sha256sum_hex("owl.toml")
    if sha == "" { return false }
    set res_dir = use! util::owl_home_cache_resolution(sha)
    set cached_lock = res_dir + "/lock.toml"
    if !fs::exists(cached_lock) { return false }
    /! Verify cached lock matches current owl.toml manifest !/
    set cached_content = fs::read(cached_lock)
    set cached_manifest = use! util::toml_get_from_string(cached_content "lock" "manifest-sha256")
    set current_manifest = use! util::sha256sum_hex("owl.toml")
    if cached_manifest != "" && cached_manifest == current_manifest {
        /! Read the file again to avoid ownership issues !/
        set restored_content = fs::read(cached_lock)
        use fs::write("owl.lock" restored_content)
        use dasu("  [OK]   owl.lock restored from cache")
        return true
    }
    return false
}
