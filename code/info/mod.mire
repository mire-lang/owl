module info

load mire::vec
load kioto::strings
load! /code/util
load kioto::proc
load! /code/deps

pub fn run: (args :&vec[str]) {
    set json_mode = false :bool mut
    set i = 2 :i64 mut
    set argc = vec::len(args)
    while i < argc {
        if vec::get::str(args i) == "--json" { set json_mode = true }
        set i += 1
    }

    set has_proj = use! util::has_project()

    set n_val = "?" :str mut
    set v_val = "?" :str mut
    set e_val = "?" :str mut
    set p_val = "?" :str mut
    set o_val = "?" :str mut
    set c_val = "?" :str mut
    set arch_val = "?" :str mut
    set kernel_val = "?" :str mut

    if has_proj {
        set n_val = use! util::toml_get("owl.toml" "project" "name")
        if n_val == "" { set n_val = "?" }
        set v_val = use! util::toml_get("owl.toml" "project" "version")
        if v_val == "" { set v_val = "?" }
        set e_val = use! util::toml_get("owl.toml" "project" "entry")
        if e_val == "" { set e_val = "?" }
        set p_val = use! util::toml_get("owl.toml" "build" "profile")
        if p_val == "" { set p_val = "?" }
        set o_val = use! util::toml_get("owl.toml" "paths" "output")
        if o_val == "" { set o_val = "?" }
        set c_val = use! util::toml_get("owl.toml" "paths" "cache")
        if c_val == "" { set c_val = "?" }

        set uname_m = [] :vec[str] mut
        set uname_m = vec::push::str(uname_m "-m")
        set arch_raw = proc::run::output("uname" uname_m)
        set arch_val = arch_raw
        set uname_s = [] :vec[str] mut
        set uname_s = vec::push::str(uname_s "-s")
        set kernel_raw = proc::run::output("uname" uname_s)
        set kernel_val = kernel_raw
        if kernel_val != "" { set kernel_val = strings::lower(kernel_val) }
        if arch_val == "" { set arch_val = "?" }
        if kernel_val == "" { set kernel_val = "?" }
    }

    set compiler_line = "?" :str mut
    set mire_ver = [] :vec[str] mut
    set mire_ver = vec::push::str(mire_ver "--version")
    set compiler_cmd = use! util::compiler_cmd()
    set compiler_out = proc::run::output(compiler_cmd mire_ver)
    if compiler_out != "" {
        set clines = use! util::split(compiler_out "\n")
        set compiler_line = use! util::list_get(clines 0)
    }

    set llvm_ver = [] :vec[str] mut
    set llvm_ver = vec::push::str(llvm_ver "--version")
    set llvm = "?" :str mut
    set llvm = proc::run::output("llvm-config" llvm_ver)
    if llvm == "" { set llvm = "?" }

    set deps_raw = "" :str mut
    if has_proj {
        set names = use! deps::get_dep_names()
        set nlen = len(names)
        set pos = 0 :i64 mut
        while pos < nlen {
            set nl = strings::index(strings::substr(names pos nlen - pos) "\n")
            set key = "" :str mut
            if nl < 0 {
                set key = use! util::trim_substr(names pos nlen - pos)
                set pos = nlen
            } else {
                set key = use! util::trim_substr(names pos nl)
                set pos = pos + nl + 1
            }
            if key != "" {
                set key_ver = key
                set key_path = key
                set key_display = key
                set ver_s = use! deps::get_dep_field(key_ver "version") :str mut
                if ver_s == "" { set ver_s = "-" }
                set src_s = use! deps::get_dep_field(key_path "path") :str mut
                if src_s == "" { set src_s = "?" }
                set deps_raw = deps_raw + key_display + "|" + ver_s + "|" + src_s + "\n"
            }
        }
    }

    if json_mode {
        set parts = [] :vec[str] mut
        set parts = vec::push::str(parts "{")
        if has_proj {
            set out_path = o_val + "/" + p_val
            set out_target = arch_val + "-" + kernel_val
            set q_name = use! util::json_quote(n_val)
            set q_ver = use! util::json_quote(v_val)
            set q_entry = use! util::json_quote(e_val)
            set q_profile = use! util::json_quote(p_val)
            set q_output = use! util::json_quote(out_path)
            set q_cache = use! util::json_quote(c_val)
            set q_target = use! util::json_quote(out_target)
            set parts = vec::push::str(parts "  \"project\": {")
            set parts = vec::push::str(parts "    \"name\": " + q_name + ",")
            set parts = vec::push::str(parts "    \"version\": " + q_ver)
            set parts = vec::push::str(parts "  },")
            set parts = vec::push::str(parts "  \"entry\": " + q_entry + ",")
            set parts = vec::push::str(parts "  \"profile\": " + q_profile + ",")
            set parts = vec::push::str(parts "  \"output\": " + q_output + ",")
            set parts = vec::push::str(parts "  \"cache\": " + q_cache + ",")
            set parts = vec::push::str(parts "  \"target\": " + q_target + ",")
        }
        set q_compiler = use! util::json_quote(compiler_line)
        set raw_version = use! util::owl_version()
        set q_version = use! util::json_quote(raw_version)
        set q_llvm = use! util::json_quote(llvm)
        set parts = vec::push::str(parts "  \"compiler\": " + q_compiler + ",")
        set parts = vec::push::str(parts "  \"owl\": " + q_version + ",")
        set parts = vec::push::str(parts "  \"llvm\": " + q_llvm + ",")
        set parts = vec::push::str(parts "  \"language\": \"Mire\",")
        set parts = vec::push::str(parts "  \"abi\": 1")
        if has_proj {
            set parts = vec::push::str(parts ",")
            set parts = vec::push::str(parts "  \"dependencies\": [")
            set trimmed_deps = use! util::trim(deps_raw)
            set dep_lines = use! util::split(trimmed_deps "\n")
            set dli = 0 :i64 mut
            set first = true :bool mut
            while dli < len(dep_lines) {
                set raw_line = vec::get::str(dep_lines dli)
                set row = use! util::split(raw_line "|")
                if len(row) >= 3 {
                    set dk = use! util::list_get(row 0)
                    set dv = use! util::list_get(row 1)
                    set dp = use! util::list_get(row 2)
                    set q_dk = use! util::json_quote(dk)
                    set q_dv = use! util::json_quote(dv)
                    set q_dp = use! util::json_quote(dp)
                    set entry_txt = "{ \"name\": " + q_dk + ", \"version\": " + q_dv + ", \"path\": " + q_dp + " }" :str mut
                    if first == false {
                        set entry_txt = "," + entry_txt
                    }
                    set first = false
                    set parts = vec::push::str(parts "    " + entry_txt)
                }
                set dli += 1
            }
            if deps_raw == "" {
                set parts = vec::push::str(parts "    ")
            }
            set parts = vec::push::str(parts "  ]")
        }
        set parts = vec::push::str(parts "}")
        set joined = strings::join(parts "\n")
        set final_out = use! util::trim(joined)
        use dasu(final_out)
    } else {
        if has_proj {
            use dasu("project:     " + n_val + " v" + v_val)
            use dasu("entry:       " + e_val)
            use dasu("profile:     " + p_val)
            use dasu("output:      " + o_val + "/" + p_val)
            use dasu("cache:       " + c_val)
            if arch_val != "?" && kernel_val != "?" {
                use dasu("target:      " + arch_val + "-" + kernel_val)
            } else {
                use dasu("target:      ?")
            }
            use dasu("")
        }

        use dasu("compiler:    " + compiler_line)
        use dasu("owl:         v" + use! util::owl_version())
        use dasu("LLVM:        " + llvm)
        use dasu("language:    Mire")
        use dasu("abi:         1")

        if has_proj {
            use dasu("")
            use dasu("dependencies:")
            if deps_raw != "" {
                set dep_lines = use! util::split(use! util::trim(deps_raw) "\n")
                set dli = 0 :i64 mut
                while dli < len(dep_lines) {
                    set parts = use! util::split(use! util::list_get(dep_lines dli) "|")
                    if len(parts) >= 3 {
                        set dk = use! util::list_get(parts 0)
                        set dv = use! util::list_get(parts 1)
                        set dp = use! util::list_get(parts 2)
                        use dasu("  " + dk + "  " + dv + "  (" + dp + ")")
                    }
                    set dli += 1
                }
            } else {
                use dasu("  (none)")
            }
        }
    }
}

pub fn clean: (args :&vec[str]) {
    set clean_bin = false :bool mut
    set clean_cache = false :bool mut
    set clean_all = false :bool mut
    set clean_global = false :bool mut

    set n = vec::len(args)
    set i = 2 :i64 mut
    while i < n {
        set a = vec::get::str(args i)
        if a == "--bin" { set clean_bin = true }
        if a == "--cache" { set clean_cache = true }
        if a == "--all" || a == "-A" { set clean_all = true }
        if a == "--global" { set clean_global = true }
        set i += 1
    }

    if clean_global {
        use! util::rm_RF(use! util::owl_home() + "/cache")
        use! util::rm_RF(use! util::owl_home() + "/libs")
        use dasu("cleaned global caches")
        return
    }

    if !clean_bin && !clean_cache && !clean_all {
        set clean_bin = true
        set clean_cache = true
    }

    set cleaned = false :bool mut

    if clean_all || clean_bin {
        if fs::exists("bin") {
            use! util::rm_RF("bin")
            set cleaned = true
        }
    }
    if clean_all || clean_cache {
        if fs::exists(".cache") {
            use! util::rm_RF(".cache")
            set cleaned = true
        }
    }
    if clean_all {
        if fs::exists("deps") {
            use! util::rm_RF("deps")
            set cleaned = true
        }
    }

    if fs::exists("_test_harness.mire") {
        use fs::drop("_test_harness.mire")
        set cleaned = true
    }

    if cleaned { use dasu("cleaned artifacts") } else { use dasu("nothing to clean") }
}
