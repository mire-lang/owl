module registry

load mire::vec
load kioto::strings
load kioto::fs
load kioto::proc
load! /code/util
load! /code/trust
load! /code/cache
load! /code/cfg
load! /code/crypto

/! MOR (Master Official Registry) - preconfigured, non-removable.
   Contents:
     kioto@2.5.0, kioto@3.0.0, kioto@3.1.0
     mire@1.3.0
     sdl@1.3.1
     owl@latest
!/

pub fn home: () :str {
    return use! util::owl_home_registries()
}

pub fn mor_name: () :str { return "mor" }

pub fn mor_url: () :str { return "https://github.com/mire-org/registry-mor" }

/! Helper: concat two strings !/
fn sc: (a :&str, b :&str) :str {
    return strings::concat(a b)
}

/! Helper: concat three strings (as two arguments) !/
fn sc3: (a :&str, b :&str) :str {
    return strings::concat(a b)
}

pub fn sync_all: () {
    use! registry::sync([])
}

pub fn sync: (args :&vec[str]) {
    use! util::mkdir_p(use! util::cfg::home())
    set reg_dir = use! registry::home()
    use! util::mkdir_p(reg_dir)

    /! Ensure MOR exists !/
    set mor_path = sc(strings::copy(reg_dir) "/") use! registry::mor_name()
    if !fs::exists(mor_path) {
        use dasu("  [MOR] initializing Master Official Registry...")
        use! util::mkdir_p(mor_path)
        set proto = "1"
        use fs::write(sc(mor_path "/protocol") proto)
        set url = use! registry::mor_url()
        use fs::write(sc(mor_path "/source_url") url)
        set initial_index = "[[packages]]\nname = \"kioto\"\nversion = \"2.5.0\"\n\n[[packages]]\nname = \"kioto\"\nversion = \"3.0.0\"\n\n[[packages]]\nname = \"kioto\"\nversion = \"3.1.0\"\n\n[[packages]]\nname = \"mire\"\nversion = \"1.3.0\"\n\n[[packages]]\nname = \"sdl\"\nversion = \"1.3.1\"\n\n[[packages]]\nname = \"owl\"\nversion = \"latest\"\n"
        use fs::write(sc(mor_path "/index.toml") initial_index)
        use dasu("  [MOR] initialized with base packages")
    }

    /! Sync each configured registry !/
    set entries_str = use! util::list_text(use! registry::home())
    set entries = strings::split(entries_str "\n")
    set i = 0 :i64 mut
    while i < vec::len(entries) {
        set name = use! util::trim(entries at i)
        if len(name) > 0 {
            use! registry::sync_one(name)
        }
        set i += 1
    }
}

pub fn sync_all: () {
    use! registry::sync([])
}

pub fn sync_one: (name :&str) {
    set home = use! registry::home()
    set reg_dir = sc(strings::copy(home) "/") name
    if !fs::exists(reg_dir) { return }

    set url = fs::read(sc(reg_dir "/source_url"))
    if len(url) == 0 { return }

    set tmp = use! crypto::tempdir("owl-reg") :str mut
    set proceed = true :bool mut
    set content = "" :str mut
    set used_url = "" :str mut

    set attempt = 0 :i64 mut
    while attempt < 4 {
        set try_url = "" :str mut
        if attempt == 0 { set try_url = sc(url "/registry.json") }
        if attempt == 1 { set try_url = sc(url "/raw/main/registry.json") }
        if attempt == 2 { set try_url = sc(url "/raw/master/registry.json") }
        if attempt == 3 {
            set try_url = sc(strings::replace::all(url "https://github.com/" "https://api.github.com/repos/") "/contents/registry.json")
        }

        if try_url != "" {
            set curl_args = [] :vec[str] mut
            set curl_args = vec::push::str(curl_args "-sL")
            set curl_args = vec::push::str(curl_args "--fail")
            set curl_args = vec::push::str(curl_args "-H")
            set curl_args = vec::push::str(curl_args "Accept: application/vnd.github.raw")
            set curl_args = vec::push::str(curl_args "-o")
            set curl_args = vec::push::str(curl_args sc(tmp "/registry.json"))
            set curl_args = vec::push::str(curl_args sc(try_url ""))
            use proc::run::output("curl" curl_args)
            set registry_content = fs::read(sc(tmp "/registry.json"))
            set test_content = use! util::trim_value(registry_content)
            if test_content != "" {
                set content = test_content
                set used_url = try_url
                use dasu(sc(sc("  [OK]    fetched " name) " from ") used_url)
            }
        }

        if content != "" { break }
        set attempt += 1
    }

    if content == "" {
        use dasu(sc(sc("  [WARN]  could not sync " name) " (offline?)"))
    } else {
        use fs::write(sc(reg_dir "/registry.json") content)
        use fs::write(sc(reg_dir "/index.toml") content)
        set msg1 = sc("  [OK]    " name) :str mut
        set msg2 = sc(msg1 " synced (") :str mut
        set msg3 = sc(msg2 used_url) :str mut
        set msg4 = sc(msg3 ")") :str mut
        use dasu(msg4)
    }

    set rm_args = [] :vec[str] mut
    set rm_args = vec::push::str(rm_args "-rf")
    set rm_args = vec::push::str(rm_args sc(tmp ""))
    use! util::rm_RF(tmp)
}

pub fn list: () {
    set reg_dir = use! registry::home()
    set entries_str = use! util::list_text(reg_dir)
    set entries = strings::split(entries_str "\n")
    if vec::len(entries) == 0 {
        use dasu("  no registries configured")
        return
    }
    use dasu("  configured registries:")
    set i = 0 :i64 mut
    while i < vec::len(entries) {
        set name = use! util::trim(entries at i)
        if len(name) > 0 {
            set is_mor = name == use! registry::mor_name()
            set mark = "" :str mut
            if is_mor { set mark = " (MOR, built-in)" }
            use dasu(sc("  " name) mark)
        }
        set i += 1
    }
}

pub fn add: (args :&vec[str]) {
    if vec::len(args) < 3 {
        use dasu("Usage: owl reg add <name> <url>")
        return
    }
    set name = vec::get::str(args 2)
    set url = vec::get::str(args 3)

    if name == use! registry::mor_name() {
        use dasu(sc(sc("  [FAIL]  '" use! registry::mor_name()) "' is reserved for the built-in MOR"))
        return
    }

    set home = use! registry::home()
    set reg_dir = sc(strings::copy(home) "/") name
    if fs::exists(reg_dir) {
        use dasu(sc(sc("  [FAIL]  registry '" name) "' already exists"))
        return
    }

    use! util::mkdir_p(reg_dir)
    use fs::write(sc(reg_dir "/protocol") "1")
    use fs::write(sc(reg_dir "/source_url") url)

    use! registry::sync_one(name)
    use dasu(sc(sc("  [OK]    registry '" name) "' added and synced"))
}

pub fn remove: (args :&vec[str]) {
    if vec::len(args) < 3 {
        use dasu("Usage: owl reg remove <name>")
        return
    }
    set name = vec::get::str(args 2)

    if name == use! registry::mor_name() {
        use dasu("  [FAIL]  cannot remove MOR (built-in, non-removable)")
        return
    }

    set home = use! registry::home()
    set reg_dir = sc(strings::copy(home) "/") name
    if !fs::exists(reg_dir) {
        use dasu(sc(sc("  [FAIL]  registry '" name) "' does not exist"))
        return
    }

    set rm_args = [] :vec[str] mut
    set rm_args = vec::push::str(rm_args "-rf")
    set rm_args = vec::push::str(rm_args sc(reg_dir ""))
    use! util::rm_RF(reg_dir)
    use dasu(sc(sc("  [OK]    registry '" name) "' removed"))
}

pub fn find_package: (name :&str version :&str) :str {
    set entries_str = use! util::list_text(use! registry::home())
    set entries = strings::split(entries_str "\n")
    set i = 0 :i64 mut
    while i < vec::len(entries) {
        set reg = use! util::trim(entries at i)
        if len(reg) > 0 {
            set idx = sc(sc(strings::copy(use! registry::home()) "/") reg) "/index.toml"
            if fs::exists(idx) {
                set content = fs::read(idx)
                set search = sc(sc("name = \"" name) "\"")
                if strings::contains(content search) {
                    set ver_search = sc(sc("version = \"" version) "\"")
                    if strings::contains(content ver_search) {
                        return content
                    }
                }
            }
        }
        set i += 1
    }
    return ""
}

pub fn resolve_latest: (name :&str) :str {
    set best = "" :str mut
    set entries_str = use! util::list_text(use! registry::home())
    set entries = strings::split(entries_str "\n")
    set i = 0 :i64 mut
    while i < vec::len(entries) {
        set reg = use! util::trim(entries at i)
        if len(reg) > 0 {
            set idx = sc(sc(strings::copy(use! registry::home()) "/") reg) "/index.toml"
            if fs::exists(idx) {
                set content = fs::read(idx)
                set lines = use! semver::count_lines(content)
                set in_pkg = false :bool mut
                set cur_name = "" :str mut
                set cur_ver = "" :str mut
                set j = 0 :i64 mut
                while j < lines {
                    set line = use! util::trim(use! semver::nth_line(content j))
                    if line == "[[packages]]" {
                        if in_pkg && len(cur_name) > 0 && cur_name == name {
                            if (use! semver::compare_versions(cur_ver best) > 0) { set best = cur_ver :str mut }
                        }
                        set in_pkg = true
                        set cur_name = ""
                        set cur_ver = ""
                    } else {
                        if in_pkg {
                            if use! util::startswith(line "name =") { set cur_name = use! semver::extract_str_val(line) }
                            if use! util::startswith(line "version =") { set cur_ver = use! semver::extract_str_val(line) }
                        }
                    }
                    set j += 1
                }
                if in_pkg && len(cur_name) > 0 && cur_name == name {
                    if (use! semver::compare_versions(cur_ver best) > 0) { set best = cur_ver :str mut }
                }
            }
        }
        set i += 1
    }
    return best
}
