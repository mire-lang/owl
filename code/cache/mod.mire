// cache — Owl's cache and orchestration state, inside the project.
//
// Layout, under the project's output directory:
//
//   bin/.cache/     the COMPILER's incremental cache. Owned by Avenys: blobs,
//                   cobjects, index, wal. Owl points --cache-dir at it and
//                   otherwise does not look inside.
//   bin/.owl/       Owl's own cache. Resolution results and per-package state.
//                   Owl owns it entirely.
//
// Why these are separate, and why both are in the project
// --------------------------------------------------------
// A single `bin/.cache` holding both was the old arrangement and it was wrong in
// three ways:
//
//   1. Owl wrote a `mire-config.toml` into it, so one directory held cache state
//      and a build argument list at the same time. That is not a cache.
//   2. Every project recompiled the same C runtime objects and the same shared
//      dependencies, because the cache was per-project by construction.
//   3. Because the compiler keys its incremental cache off that generated config,
//      an unrelated flag change invalidated everything.
//
// Splitting them fixes (1): bin/.owl is Owl's, bin/.cache is the compiler's, and
// neither writes into the other.
//
// On (2): keeping the cache inside the project is a deliberate trade. A cache in
// ~/.owl would be shared across projects, but it would also mean the compiler
// writes outside the project tree, and the Avenys sandbox denies every absolute
// path outside the project root on purpose. Sharing a cache across projects would
// mean weakening that, and a project should not be able to poison another's
// build by writing there. Per-project caches also make a project directory
// self-contained: copy it, or archive it, and the cache travels with the code.
//
// Portability follows from that: a project is portable because everything it needs
// to rebuild is inside it, not because a machine-wide cache happens to be warm.
//
// Nothing here is required for correctness. Every entry can be deleted at any
// time and the next build recomputes it; there is no lock a crashed build can
// leave behind.

load kioto::strings
load kioto::fs
load! /code/util

// ── Roots ────────────────────────────────────────────────────────

// Owl's own cache root, relative to the project: <output>/.owl.
pub fn root: (out_dir :str) :str {
    return out_dir + "/.owl"
}

// The compiler's cache root: <output>/.cache. Named here so there is exactly one
// place that knows the spelling, shared with owl.toml's [paths] cache.
pub fn compiler_root: (out_dir :str) :str {
    return out_dir + "/.cache"
}

// ── Resolution ───────────────────────────────────────────────────
// Keyed by the manifest content hash: the resolution depends on the manifest and
// on what is installed, so it is neither per-checkout nor content-addressed.

pub fn resolution_path: (out_dir :str, manifest_sha :str) :str {
    return use! cache::root(out_dir) + "/resolution/" + manifest_sha
}

pub fn put_resolution: (out_dir :str, manifest_sha :str, content :str) :bool {
    set dir = use! cache::root(out_dir) + "/resolution"
    use! util::mkdir_p(strings::copy(dir))
    return fs::write(use! cache::resolution_path(out_dir manifest_sha) content)
}

// A cache that can fail a build is worse than no cache, so an unreadable or
// absent entry is a miss, not an error.
pub fn get_resolution: (out_dir :str, manifest_sha :str) :str {
    set path = use! cache::resolution_path(out_dir manifest_sha)
    if !fs::exists(path) {
        return ""
    }
    return fs::read(path)
}

// ── Manifest digest ──────────────────────────────────────────────

// The manifest's SHA-256, which keys every resolution entry. Recomputed per
// build: the manifest is small and this is what makes the cache correct rather
// than merely fast.
pub fn manifest_digest: (manifest_path :str) :str {
    return use! util::sha256sum_hex(manifest_path)
}

// ── Maintenance ──────────────────────────────────────────────────

// Removes Owl's cache for this project. Deliberately does NOT touch
// bin/.cache: that is the compiler's, it is content-addressed, and deleting it
// would throw away work that is expensive to redo.
pub fn purge: (out_dir :str) :bool {
    set dir = use! cache::root(out_dir)
    if !fs::exists(dir) {
        return true
    }
    return fs::remove_all(dir)
}

// Reports what is on disk, for `owl info` and for diagnosing a stale cache.
pub fn describe: (out_dir :str) :str {
    set lines = "" :str mut
    set owl_dir = use! cache::root(out_dir)
    set c_dir = use! cache::compiler_root(out_dir)
    if fs::exists(owl_dir) {
        set lines = lines + "  owl cache     " + owl_dir + "\n"
    }
    if fs::exists(c_dir) {
        set lines = lines + "  compiler cache " + c_dir + "\n"
    }
    if lines == "" {
        set lines = "  (no cache yet)\n"
    }
    return lines
}
