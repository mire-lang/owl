// owl syntax test: control flow.
load kioto

@[test]
pub fn if_else_branches: () :bool {
    set taken = false :bool mut
    if true {
        set taken = true
    } else {
        return false
    }
    if !taken { return false }

    set x = 42 :i64
    if x > 40 {
    } else {
        return false
    }

    set val = 50 :i64
    if val > 100 {
        return false
    } else {
        if val > 20 {
        } else {
            return false
        }
    }
    return true
}

@[test]
pub fn while_counting: () :bool {
    set count = 0 :i64 mut
    while count < 5 {
        set count = count + 1
    }
    if count != 5 { return false }
    return true
}

@[test]
pub fn while_sum: () :bool {
    set sum = 0 :i64 mut
    set i = 1 :i64 mut
    while i <= 10 {
        set sum = sum + i
        set i = i + 1
    }
    if sum != 55 { return false }
    return true
}

@[test]
pub fn while_factorial: () :bool {
    set factorial = 1 :i64 mut
    set j = 5 :i64 mut
    while j > 1 {
        set factorial = factorial * j
        set j = j - 1
    }
    if factorial != 120 { return false }
    return true
}

@[test]
pub fn nested_while: () :bool {
    set nested = 0 :i64 mut
    set a = 0 :i64 mut
    while a < 3 {
        set b = 0 :i64 mut
        while b < 4 {
            set nested = nested + 1
            set b = b + 1
        }
        set a = a + 1
    }
    if nested != 12 { return false }
    return true
}
