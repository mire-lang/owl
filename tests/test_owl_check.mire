// owl tool test: owl check validates owl.toml
load kioto

@[test]
pub fn owl_check_validates_project: () :bool {
    set da = [] :vec[str] mut
    set da = vec::push::str(da "+%s")
    set ts = strings::trim(proc::run::output("date" da))
    set test_base = strings::concat(strings::concat(env::var("HOME") "/.owl/tmp/owl_check_test_") ts)
    set proj_dir = strings::concat(test_base "/testcheck")
    set owl_bin = env::var("OWL_BIN") :str mut
    if owl_bin == "" { set owl_bin = strings::concat(env::var("HOME") "/.local/bin/owl") }

    set mk = [] :vec[str] mut
    set mk = vec::push::str(mk "-p")
    set mk = vec::push::str(mk test_base)
    use proc::run::output("mkdir" mk)

    set na = [] :vec[str] mut
    set na = vec::push::str(na "new")
    set na = vec::push::str(na "testcheck")
    use proc::run::output_cwd(owl_bin na test_base true)

    set ca = [] :vec[str] mut
    set ca = vec::push::str(ca "check")
    set check_out = proc::run::output_cwd(owl_bin ca proj_dir true)
    set check_ok = strings::contains(check_out "[OK]")

    set rm = [] :vec[str] mut
    set rm = vec::push::str(rm "-rf")
    set rm = vec::push::str(rm test_base)
    use proc::run::output("rm" rm)

    return check_ok
}
