// owl tool test: owl check validates owl.toml
load kioto::strings
load kioto::fs
load mire::vec
load kioto::proc
load kioto::env
load! /code/_externs

// Use extern directly for i64_to_string
fn i64_to_string: (v :i64) :str { return rt_i64_to_string(v) }

@[test]
pub fn owl_check_validates_project: () :bool {
    set home_parts = [] :vec[str] mut
    set home_parts = vec::push::str(home_parts "-c")
    set home_parts = vec::push::str(home_parts "echo $HOME")
    set home_out = proc::run::output("sh" home_parts)
    set home = strings::trim(home_out)
    set da = [] :vec[str] mut
    set da = vec::push::str(da "+%s")
    set ts = strings::trim(proc::run::output("date" da))
    set test_base = strings::concat(strings::concat(strings::copy(home) "/.owl/tmp/owl_check_test_") ts)
    set proj_dir = strings::concat(test_base "/testcheck")
    set owl_bin = env::var("OWL_BIN") :str mut
    if owl_bin == "" { set owl_bin = strings::concat(strings::copy(home) "/.local/bin/owl") }

    set mk = [] :vec[str] mut
    set mk = vec::push::str(mk "-p")
    set mk = vec::push::str(mk strings::concat(proj_dir "/src"))
    set mk = vec::push::str(mk strings::concat(proj_dir "/bin"))
    use proc::run.output("mkdir" mk)

    set toml_path = strings::concat(proj_dir "/owl.toml")
    set toml_content = "[project]\nname = \"testcheck\"\nversion = \"0.1.0\"\ndescription = \"\"\nentry = \"src/main.mire\"\n\n[build]\ncompiler = \"mire\"\nprofile = \"debug\"\nopt-level = \"0\"\nartifact = \"bin\"\nruntime = \"minimal\"\n\n[paths]\nsources = \"src\"\ntests = \"tests\"\noutput = \"bin\"\ncache = \"bin/.cache\"\n"
    use fs::write(toml_path toml_content)

    set main_path = strings::concat(proj_dir "/src/main.mire")
    set main_content = "pub fn main: () {\n  return 0\n}\n"
    use fs::write(main_path main_content)

    set check_cmd = [] :vec[str] mut
    set check_cmd = vec::push::str(check_cmd "-c")
    set check_cmd = vec::push::str(check_cmd "cd " + proj_dir + " && " + owl_bin + " check . 2>&1")
    set check_out = proc::run::output("sh" check_cmd)
    set check_exit = proc::run.last_exit()
    set check_ok = check_exit == 0
        && strings::contains(check_out "[OK]   [paths].output: bin")
        && !strings::contains(check_out "[FAIL]")
    use dasu("CHECK_EXIT=" + use! util::i64_to_string(check_exit))
    use dasu("CHECK_OUT=" + check_out)

    set rm = [] :vec[str] mut
    set rm = vec::push::str(rm "-rf")
    set rm = vec::push::str(rm test_base)
    use proc::run.output("rm" rm)

    return check_ok
}
