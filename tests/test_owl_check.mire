// owl tool test: owl check validates owl.toml
load kioto::strings
load mire::vec
load kioto::proc

fn write_file: (path :str, content :str) :bool {
    set c1 = strings::concat("cat > ' " path)
    set c2 = strings::concat(c1 "' << 'MIRE_EOF'\n")
    set c3 = strings::concat(c2 content)
    set c4 = strings::concat(c3 "\nMIRE_EOF\n")
    set parts = [] :vec[str] mut
    set parts = vec::push::str(parts "sh")
    set parts = vec::push::str(parts "-c")
    set parts = vec::push::str(parts c4)
    use proc::run.output("sh" parts)
    return proc::run.last_exit() == 0
}

@[test]
pub fn owl_check_validates_project: () :bool {
    set home_parts = [] :vec[str] mut
    set home_parts = vec::push::str(home_parts "-c")
    set home_parts = vec::push::str(home_parts "echo $HOME")
    set home_out = proc::run::output("sh" home_parts)
    set home = strings::trim(home_out)
    set da = [] :vec[str] mut
    set da = vec::push::str(da "+%s")
    set ts = strings::trim(proc::run::output("date" da))
    set test_base = strings::concat(strings::concat(strings::copy(home) "/.owl/tmp/owl_check_test_") ts)
    set proj_dir = strings::concat(test_base "/testcheck")
    set owl_bin = "/home/Evelyn/.local/bin/owl" :str mut
    if owl_bin == "" { set owl_bin = strings::concat(strings::copy(home) "/.local/bin/owl") }

    set mk = [] :vec[str] mut
    set mk = vec::push::str(mk "-p")
    set mk = vec::push::str(mk strings::concat(proj_dir "/src"))
    set mk = vec::push::str(mk strings::concat(proj_dir "/bin"))
    use proc::run.output("mkdir" mk)

    set toml_path = strings::concat(proj_dir "/owl.toml")
    set toml_content = "[project]\nname = \"testcheck\"\nversion = \"0.1.0\"\ndescription = \"\"\nentry = \"src/main.mr\"\n\n[build]\ncompiler = \"mire\"\nprofile = \"debug\"\nopt-level = \"0\"\nartifact = \"bin\"\nruntime = \"minimal\"\n\n[paths]\nsources = \"src\"\ntests = \"tests\"\noutput = \"bin\"\ncache = \"bin/.cache\"\n"
    if !write_file(toml_path toml_content) { return false }

    set main_path = strings::concat(proj_dir "/src/main.mr")
    set main_content = "pub fn main: () :i64 {\n  return 0\n}\n"
    if !write_file(main_path main_content) { return false }

    set ca = [] :vec[str] mut
    set ca = vec::push::str(ca "check")
    set ca = vec::push::str(ca ".")
    set check_cmd = [] :vec[str] mut
    set check_cmd = vec::push::str(check_cmd "sh")
    set check_cmd = vec::push::str(check_cmd "-c")
    set cc1 = strings::concat("cd " proj_dir)
    set cc2 = strings::concat(cc1 " && ")
    set cc3 = strings::concat(cc2 owl_bin)
    set cc4 = strings::concat(cc3 " check .")
    set check_cmd = vec::push::str(check_cmd cc4)
    set check_out = use! proc::run.output("sh" check_cmd)
    set check_ok = strings::contains(check_out "[OK]")

    set rm = [] :vec[str] mut
    set rm = vec::push::str(rm "-rf")
    set rm = vec::push::str(rm test_base)
    use proc::run.output("rm" rm)

    return check_ok
}
