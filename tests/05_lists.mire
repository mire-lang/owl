// owl syntax test: list/vector operations.
load kioto

fn vec_contains: (v :&vec[i64], target :i64) :bool {
    set i = 0 :i64 mut
    while i < vec::len(v) {
        if vec::get::i64(v i) == target { return true }
        set i = i + 1
    }
    return false
}

fn vec_index_of: (v :&vec[i64], target :i64) :i64 {
    set i = 0 :i64 mut
    while i < vec::len(v) {
        if vec::get::i64(v i) == target { return i }
        set i = i + 1
    }
    return -1
}

fn reverse_list: (v :vec[i64]) :vec[i64] {
    set out = [] :vec[i64] mut
    set i = vec::len(v) - 1 :i64 mut
    while i >= 0 {
        set out = vec::push::i64(out vec::get::i64(v i))
        set i = i - 1
    }
    return out
}

@[test]
pub fn list_literal_and_len: () :bool {
    set lst = [1 2 3] :vec[i64]
    if vec::len(lst) != 3 { return false }
    if vec::get::i64(lst 0) != 1 { return false }
    if vec::get::i64(lst 1) != 2 { return false }
    if vec::get::i64(lst 2) != 3 { return false }
    set empty = [] :vec[i64]
    if vec::len(empty) != 0 { return false }
    return true
}

@[test]
pub fn vec_contains_and_index_of: () :bool {
    if !vec_contains([1 2 3] 2) { return false }
    if vec_contains([1 2 3] 5) { return false }
    if vec_index_of([10 20 30] 20) != 1 { return false }
    if vec_index_of([10 20 30] 99) != -1 { return false }
    return true
}

@[test]
pub fn vec_first_and_last: () :bool {
    set lst = [1 2 3] :vec[i64]
    if vec::get::i64(lst 0) != 1 { return false }
    if vec::get::i64(lst vec::len(lst) - 1) != 3 { return false }
    return true
}

@[test]
pub fn vec_reverse: () :bool {
    set rev = reverse_list([1 2 3])
    if vec::get::i64(rev 0) != 3 { return false }
    if vec::get::i64(rev 1) != 2 { return false }
    if vec::get::i64(rev 2) != 1 { return false }
    return true
}

@[test]
pub fn vec_is_empty: () :bool {
    if vec::len([] :vec[i64]) != 0 { return false }
    if vec::len([1] :vec[i64]) == 0 { return false }
    return true
}

@[test]
pub fn large_list: () :bool {
    set big = [] :vec[i64] mut
    set i = 0 :i64 mut
    while i < 100 {
        set val = i :i64
        set big = vec::push::i64(big val)
        set i = i + 1
    }
    if vec::len(big) != 100 { return false }
    return true
}
