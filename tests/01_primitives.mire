// owl syntax test: primitive values and operators.
load kioto

@[test]
pub fn i64_literals: () :bool {
    set a = 42 :i64
    if a != 42 { return false }
    set b = -17 :i64
    if b != -17 { return false }
    set big = 2147483647 :i64
    set big2 = big + 1
    if big2 != 2147483648 { return false }
    return true
}

@[test]
pub fn i64_arithmetic: () :bool {
    set sum = 100 + 200 :i64
    if sum != 300 { return false }
    set diff = 200 - 50 :i64
    if diff != 150 { return false }
    set product = 12 * 12 :i64
    if product != 144 { return false }
    set quot = 100 / 7 :i64
    if quot != 14 { return false }
    set rem = 100 % 7 :i64
    if rem != 2 { return false }
    return true
}

@[test]
pub fn i64_comparisons: () :bool {
    if !(42 > 0) { return false }
    if !(-1 < 0) { return false }
    if !(5 >= 5) { return false }
    if !(5 <= 5) { return false }
    if !(3 != 4) { return false }
    if !(3 == 3) { return false }
    return true
}

@[test]
pub fn boolean_logic: () :bool {
    if !(true && true) { return false }
    if false && true { return false }
    if !(true || false) { return false }
    if false || false { return false }
    if !true { return false }
    if !(!false) { return false }
    return true
}

@[test]
pub fn mutable_i64_operations: () :bool {
    set count = 10 :i64 mut
    set count = count + 1
    set count = count * 2
    if count != 22 { return false }
    return true
}
