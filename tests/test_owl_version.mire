// owl tool test: version and help flags are answered, not rejected
load kioto

@[test]
pub fn version_and_help_flags: () :bool {
    set owl_bin = env::var("OWL_BIN") :str mut
    if owl_bin == "" { set owl_bin = strings::concat(env::var("HOME") "/.local/bin/owl") }

    set va = [] :vec[str] mut
    set va = vec::push::str(va "--version")
    set va = vec::push::str(va "version")
    set v1 = proc::run::output(owl_bin va)

    set sa = [] :vec[str] mut
    set sa = vec::push::str(sa "-V")
    set sa = vec::push::str(sa "version")
    set v2 = proc::run::output(owl_bin sa)

    set ha = [] :vec[str] mut
    set ha = vec::push::str(ha "--help")
    set ha = vec::push::str(ha "help")
    set v3 = proc::run::output(owl_bin ha)

    if !strings::starts::with(strings::trim(v1) "Owl v") { return false }
    if !strings::starts::with(strings::trim(v2) "Owl v") { return false }
    if !strings::contains(v3 "Usage: owl") { return false }

    /! None of the three may be answered with the flag-validation error. !/
    if strings::contains(v1 "E0012") { return false }
    if strings::contains(v2 "E0012") { return false }
    if strings::contains(v3 "E0012") { return false }
    return true
}
