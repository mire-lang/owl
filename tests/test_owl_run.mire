// owl tool test: owl run executes and produces expected output
load kioto
load testlib

pub fn main: () {
    use dasu("--- test: owl run ---")
    testlib.assert_true(true)

    set da = [] :vec[str] mut
    set da = vec::push::str(da "+%s%N")
    set ts = strings::trim(proc::run::output("date" da))
    set test_base = strings::concat("/tmp/owl_run_test_", ts)
    set proj_dir = strings::concat(test_base, strings::copy("/testrun"))
    set owl_bin = env::var("OWL_BIN") :str mut
    if owl_bin == "" { set owl_bin = strings::concat(env::var("HOME"), strings::copy("/.local/bin/owl")) }

    set mk = [] :vec[str] mut
    set mk = vec::push::str(mk "-p")
    set mk = vec::push::str(mk strings::copy(test_base))
    use proc::run::output("mkdir" mk)

    set na = [] :vec[str] mut
    set na = vec::push::str(na "new")
    set na = vec::push::str(na "testrun")
    set new_out = proc::run::output_cwd(owl_bin na test_base true)
    use dasu(new_out)

    set ra = [] :vec[str] mut
    set ra = vec::push::str(ra "run")
    set run_out = proc::run::output_cwd(owl_bin ra proj_dir true)

    set run_exit_code = proc::run::last_exit()
    set output_ok = strings::contains(run_out "Hello from testrun")
    if output_ok {
        use dasu("  owl run output contains the generated greeting: ok")
    } else {
        use dasu("  owl run output:")
        use dasu(run_out)
    }
    testlib.assert_msg(output_ok && run_exit_code == 0, "owl run must execute the generated program successfully")

    set rm = [] :vec[str] mut
    set rm = vec::push::str(rm "-rf")
    set rm = vec::push::str(rm strings::copy(test_base))
    use proc::run::output("rm" rm)
    use dasu("test_owl_run complete")
}
