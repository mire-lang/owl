// owl tool test: owl run executes and produces expected output
load kioto

@[test]
pub fn owl_run_executes_project: () :bool {
    set da = [] :vec[str] mut
    set da = vec::push::str(da "+%s")
    set ts = strings::trim(proc::run::output("date" da))
    set test_base = strings::concat(strings::concat(env::var("HOME") "/.owl/tmp/owl_run_test_") ts)
    set proj_dir = strings::concat(test_base "/testrun")
    set owl_bin = env::var("OWL_BIN") :str mut
    if owl_bin == "" { set owl_bin = strings::concat(env::var("HOME") "/.local/bin/owl") }

    set mk = [] :vec[str] mut
    set mk = vec::push::str(mk "-p")
    set mk = vec::push::str(mk test_base)
    use proc::run::output("mkdir" mk)

    set na = [] :vec[str] mut
    set na = vec::push::str(na "new")
    set na = vec::push::str(na "testrun")
    use proc::run::output_cwd(owl_bin na test_base true)

    set ra = [] :vec[str] mut
    set ra = vec::push::str(ra "run")
    set run_out = proc::run::output_cwd(owl_bin ra proj_dir true)
    set run_exit_code = proc::run::last_exit()

    set rm = [] :vec[str] mut
    set rm = vec::push::str(rm "-rf")
    set rm = vec::push::str(rm test_base)
    use proc::run::output("rm" rm)

    if !strings::contains(run_out "Hello from testrun") { return false }
    if run_exit_code != 0 { return false }
    return true
}
