// owl tool test: owl run executes and produces expected output
load kioto::strings
load kioto::fs
load mire::vec
load kioto::proc

@[test]
pub fn owl_run_executes_project: () :bool {
    set home_parts = [] :vec[str] mut
    set home_parts = vec::push::str(home_parts "-c")
    set home_parts = vec::push::str(home_parts "echo $HOME")
    set home = strings::trim(proc::run::output("sh" home_parts))
    set da = [] :vec[str] mut
    set da = vec::push::str(da "+%s")
    set ts = strings::trim(proc::run::output("date" da))
    set test_base = strings::concat(strings::concat(strings::copy(home) "/.owl/tmp/owl_run_test_") ts)
    set proj_dir = strings::concat(test_base "/testrun")

    set mk = [] :vec[str] mut
    set mk = vec::push::str(mk "-p")
    set mk = vec::push::str(mk strings::concat(proj_dir "/src"))
    set mk = vec::push::str(mk strings::concat(proj_dir "/bin"))
    use proc::run::output("mkdir" mk)

    set toml_path = strings::concat(proj_dir "/owl.toml")
    set toml_content = "[project]\nname = \"testrun\"\nversion = \"0.1.0\"\ndescription = \"\"\nentry = \"src/main.mr\"\n\n[build]\ncompiler = \"mire\"\nprofile = \"debug\"\nopt-level = \"0\"\nartifact = \"bin\"\nruntime = \"minimal\"\n\n[paths]\nsources = \"src\"\ntests = \"tests\"\noutput = \"bin\"\ncache = \"bin/.cache\"\n"
    use fs::write(toml_path toml_content)

    set main_path = strings::concat(proj_dir "/src/main.mr")
    set main_content = "pub fn main: () :i64 {\n  use dasu(\"Hello from testrun\")\n  return 0\n}\n"
    use fs::write(main_path main_content)

    set sh = [] :vec[str] mut
    set sh = vec::push::str(sh "-c")
    set sh = vec::push::str(sh strings::concat(strings::concat(strings::concat("cd " proj_dir) " && ") "/home/Evelyn/.local/bin/owl run src/main.mr"))
    set run_out = proc::run::output("sh" sh)
    set run_exit_code = proc::run.last_exit()
    use dasu("RUN_EXIT=" + strings::from::i64(run_exit_code))
    use dasu("RUN_OUT=" + run_out)

    set rm = [] :vec[str] mut
    set rm = vec::push::str(rm "-rf")
    set rm = vec::push::str(rm test_base)
    use proc::run::output("rm" rm)

    if !strings::contains(run_out "Hello from testrun") { return false }
    if run_exit_code != 0 { return false }
    return true
}