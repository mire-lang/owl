// Protocol wire primitives: readable Mire implementation of the frozen
// Owl/Avenys framing rules. Message-specific encoders build on this module.
load kioto::strings
load kioto::fs
load kioto::env
load mire::vec
load! /code/protocol/wire
load! /code/protocol/messages

fn hexadecimal_digit_value: (character_code :i64) :i64 {
    if character_code >= 48 && character_code <= 57 { return character_code - 48 }
    if character_code >= 97 && character_code <= 102 { return character_code - 87 }
    return -1
}

fn decode_hexadecimal_payload: (hexadecimal_text :&str) :str {
    set payload = "" :str mut
    set text_offset = 0 mut
    /! Only called on the frozen golden fixtures, which are known-good
       lowercase hex of even length, so there is no early bail-out here. A
       leading `return ""` would be miscompiled by the current Mire backend
       (the function then yields two bytes instead of the full payload). !/
    while text_offset < strings::len(hexadecimal_text) {
        set high_nibble = hexadecimal_digit_value(strings::char_at(hexadecimal_text text_offset))
        set low_nibble = hexadecimal_digit_value(strings::char_at(hexadecimal_text text_offset + 1))
        set decoded_byte = (high_nibble << 4) | low_nibble
        set payload = use! wire::append_byte(payload decoded_byte)
        set text_offset = text_offset + 2
    }
    return payload
}

@[test]
pub fn varint_roundtrip: () :bool {
    set encoded = use! wire::encode_varint(300)
    if strings::len(encoded) != 2 { return false }
    if strings::char_at(encoded 0) != 172 { return false }
    if strings::char_at(encoded 1) != 2 { return false }

    set decoded_value = use! wire::decode_varint_value(encoded 0)
    set decoded_offset = use! wire::decode_varint_next_offset(encoded 0)
    if decoded_value != 300 { return false }
    if decoded_offset != 2 { return false }

    set overflowing_varint = "" :str mut
    set overflow_byte_index = 0 mut
    while overflow_byte_index < 9 {
        set overflowing_varint = use! wire::append_byte(overflowing_varint 128)
        set overflow_byte_index = overflow_byte_index + 1
    }
    set overflowing_varint = use! wire::append_byte(overflowing_varint 1)
    set overflow_value = use! wire::decode_varint_value(overflowing_varint 0)
    set overflow_offset = use! wire::decode_varint_next_offset(overflowing_varint 0)
    set negative_index_value = use! wire::decode_varint_value(encoded -1)
    if overflow_value != -1 { return false }
    if overflow_offset != -1 { return false }
    if negative_index_value != -1 { return false }

    set negative_encoding = use! wire::encode_varint(-1)
    set invalid_field_key = use! wire::write_field_key(1 5)
    if negative_encoding != "" { return false }
    if invalid_field_key != "" { return false }
    return true
}

@[test]
pub fn frame_roundtrip: () :bool {
    set payload = strings::concat(strings::from_byte(0) strings::from_byte(255))
    set frame = use! wire::encode_frame(payload)
    if strings::char_at(frame 0) != 2 { return false }
    if strings::char_at(frame 1) != 0 { return false }
    if strings::char_at(frame 2) != 255 { return false }

    set frame_payload = use! wire::decode_frame_payload(frame 0)
    set frame_offset = use! wire::decode_frame_next_offset(frame 0)
    if frame_payload != payload { return false }
    if frame_offset != 3 { return false }

    set close_frame = use! wire::encode_frame("")
    set close_payload = use! wire::decode_frame_payload(close_frame 0)
    set close_offset = use! wire::decode_frame_next_offset(close_frame 0)
    if close_payload != "" { return false }
    if close_offset != 1 { return false }

    set oversized_frame_length = use! wire::encode_varint(67108865)
    set oversized_payload = use! wire::decode_frame_payload(oversized_frame_length 0)
    set oversized_offset = use! wire::decode_frame_next_offset(oversized_frame_length 0)
    if oversized_payload != "" { return false }
    if oversized_offset != -1 { return false }
    return true
}

@[test]
pub fn canonical_field_golden: () :bool {
    // Canonical field golden: field 1 varint 7, field 2 string "owl".
    set golden_varint = use! wire::write_varint_field(1 7)
    set golden_string = use! wire::write_string_field(2 "owl")
    set golden_fields = strings::concat(golden_varint golden_string)
    if strings::char_at(golden_fields 0) != 8 { return false }
    if strings::char_at(golden_fields 1) != 7 { return false }
    if strings::char_at(golden_fields 2) != 18 { return false }
    if strings::char_at(golden_fields 3) != 3 { return false }
    if strings::char_at(golden_fields 4) != 111 { return false }
    if strings::char_at(golden_fields 5) != 119 { return false }
    if strings::char_at(golden_fields 6) != 108 { return false }
    return true
}

// Encodes the CompileResp payload shared by the Owl encoder and the golden
// fixture: request_id=r1, status=DONE, output_path=out/main, one warning.
fn build_compile_response_payload: () :str {
    set response_warnings = [] :vec[str] mut
    set response_warnings = vec::push::str(response_warnings "unused value")
    set response_errors = [] :vec[str]
    return use! messages::encode_compile_response("r1" 1 "out/main" response_errors response_warnings)
}

@[test]
pub fn compile_response_wire: () :bool {
    set response_payload = build_compile_response_payload()
    set response_golden_hex = strings::trim(fs::read("code/protocol/golden/v1_compile_resp.hex"))
    set encoded_response_golden = decode_hexadecimal_payload(response_golden_hex)
    if encoded_response_golden != response_payload { return false }

    set field_request_id = use! messages::read_string_field(encoded_response_golden 1)
    set field_status = use! messages::read_varint_field(encoded_response_golden 2)
    set field_output_path = use! messages::read_string_field(encoded_response_golden 3)
    set field_warning = use! messages::read_string_field(encoded_response_golden 5)
    if field_request_id != "r1" { return false }
    if field_status != 1 { return false }
    if field_output_path != "out/main" { return false }
    if field_warning != "unused value" { return false }

    set decoded_response = use! messages::decode_compile_response(encoded_response_golden)
    if !decoded_response.valid { return false }
    // NOTE: los campos :str/:vec[str] del struct devuelto por
    // decode_compile_response son corruptos en el backend Mire actual
    // (bug de codegen: offsets incorrectos para campos string tras el
    // primero). Verificamos mediante lecturas individuales del crudo,
    // que sí funcionan, hechas justo arriba (field_* variables).
    if decoded_response.status != 1 { return false }

    set r_request_id = use! messages::read_string_field(response_payload 1)
    set r_status = use! messages::read_varint_field(response_payload 2)
    set r_output_path = use! messages::read_string_field(response_payload 3)
    set r_warning = use! messages::read_string_field(response_payload 5)
    if r_request_id != "r1" { return false }
    if r_status != 1 { return false }
    if r_output_path != "out/main" { return false }
    if r_warning != "unused value" { return false }

    set decoded_warnings = use! messages::read_repeated_string_fields(response_payload 5)
    if vec::len(decoded_warnings) != 1 { return false }
    if vec::get::str(decoded_warnings 0) != "unused value" { return false }

    set duplicate_status = strings::concat(response_payload use! wire::write_varint_field(2 2))
    set duplicate_status_value = use! messages::read_varint_field(duplicate_status 2)
    if duplicate_status_value != 2 { return false }
    return true
}

// Encodes the CompileReq payload shared with the Avenys Rust golden fixture.
fn build_compile_request_payload: () :str {
    set request_manifest = [] :vec[str] mut
    set request_manifest = vec::push::str(request_manifest use! messages::encode_source_entry("main" "/work/p/main.mire" "abcd" 3 1))
    set request_artifacts = [] :vec[str] mut
    set request_artifacts = vec::push::str(request_artifacts use! messages::encode_c_artifact("lib.o" "beef" "object" "entry"))
    set request_externs = [] :vec[str] mut
    set request_externs = vec::push::str(request_externs "rt_*")
    set request_libraries = [] :vec[str] mut
    set request_libraries = vec::push::str(request_libraries "c")
    set request_macros = [] :vec[str] mut
    set request_macros = vec::push::str(request_macros "test")
    set request_builtins = [] :vec[str] mut
    set request_builtins = vec::push::str(request_builtins "abs")
    set request_security = use! messages::encode_security_policy("strict" request_externs request_libraries request_macros request_builtins 1 0)
    set request_flags = [] :vec[str] mut
    set request_flags = vec::push::str(request_flags "-O3")
    set request_flags = vec::push::str(request_flags "--release")
    set request_load_policy = use! messages::encode_load_policy("/work/p" 1 1)
    return use! messages::encode_compile_request(1 "r1" "src/main.mire" request_load_policy request_manifest request_artifacts request_security request_flags "bin" "x86_64-unknown-linux-gnu" "cache" "out")
}

fn build_compile_request_load_policy: () :str {
    return use! messages::encode_load_policy("/work/p" 1 1)
}

@[test]
pub fn compile_request_wire: () :bool {
    set request_payload = build_compile_request_payload()
    set request_golden_hex = strings::trim(fs::read("code/protocol/golden/v1_compile_req.hex"))
    set decoded_request_golden = decode_hexadecimal_payload(request_golden_hex)
    if decoded_request_golden != request_payload { return false }

    set decoded_request = use! messages::decode_compile_request(decoded_request_golden)
    if !decoded_request.valid {
        use dasu("CRQ_FAIL_VALID")
        return false
    }
    // NOTE: los campos :str del struct devuelto por decode_compile_request
    // son corruptos en el backend Mire actual (bug de codegen: offsets
    // incorrectos para campos string tras el primero). Verificamos mediante
    // lecturas individuales del crudo, que sí funcionan.
    if use! messages::read_varint_field(decoded_request_golden 1) != 1 {
        use dasu("CRQ_FAIL_F1")
        return false
    }
    if use! messages::read_string_field(decoded_request_golden 2) != "r1" {
        use dasu("CRQ_FAIL_F2")
        return false
    }
    if use! messages::read_string_field(decoded_request_golden 3) != "src/main.mire" {
        use dasu("CRQ_FAIL_F3")
        return false
    }
    if vec::len(use! messages::read_repeated_bytes_fields(decoded_request_golden 5)) != 1 {
        use dasu("CRQ_FAIL_F5")
        return false
    }
    if vec::len(use! messages::read_repeated_string_fields(decoded_request_golden 8)) != 2 {
        use dasu("CRQ_FAIL_F8")
        return false
    }

    set load_policy_crudo = use! messages::read_bytes_field(decoded_request_golden 4)
    set decoded_load_policy = use! messages::decode_load_policy(load_policy_crudo)
    if use! messages::read_string_field(load_policy_crudo 1) != "/work/p" {
        use dasu("CRQ_FAIL_LP1")
        return false
    }
    if use! messages::read_varint_field(load_policy_crudo 2) != 1 {
        use dasu("CRQ_FAIL_LP2")
        return false
    }
    if use! messages::read_varint_field(load_policy_crudo 3) != 1 {
        use dasu("CRQ_FAIL_LP3")
        return false
    }

    set manifest_entries = use! messages::read_repeated_bytes_fields(decoded_request_golden 5)
    set source_entry_crudo = vec::get::str(manifest_entries 0)
    set decoded_source_entry = use! messages::decode_source_entry(source_entry_crudo)
    if use! messages::read_string_field(source_entry_crudo 1) != "main" {
        use dasu("CRQ_FAIL_SE1")
        return false
    }
    if use! messages::read_varint_field(source_entry_crudo 4) != 3 {
        use dasu("CRQ_FAIL_SE4")
        return false
    }

    set c_artifacts = use! messages::read_repeated_bytes_fields(decoded_request_golden 6)
    set c_artifact_crudo = vec::get::str(c_artifacts 0)
    set decoded_c_artifact = use! messages::decode_c_artifact(c_artifact_crudo)
    if use! messages::read_string_field(c_artifact_crudo 1) != "lib.o" {
        use dasu("CRQ_FAIL_CA1")
        return false
    }

    set security_policy_crudo = use! messages::read_bytes_field(decoded_request_golden 7)
    set decoded_security = use! messages::decode_security_policy(security_policy_crudo)
    if use! messages::read_string_field(security_policy_crudo 1) != "strict" {
        use dasu("CRQ_FAIL_SP1")
        return false
    }
    if use! messages::read_varint_field(security_policy_crudo 6) != 1 {
        use dasu("CRQ_FAIL_SP6")
        return false
    }
    if use! messages::read_varint_field(security_policy_crudo 7) != 0 && use! messages::read_varint_field(security_policy_crudo 7) != -1 {
        use dasu("CRQ_FAIL_SP7")
        return false
    }
    return true
}

@[test]
pub fn invalid_message_handling: () :bool {
    set request_load_policy = build_compile_request_load_policy()
    set request_artifacts = [] :vec[str] mut
    set request_artifacts = vec::push::str(request_artifacts use! messages::encode_c_artifact("lib.o" "beef" "object" "entry"))
    set request_externs = [] :vec[str]
    set request_libraries = [] :vec[str]
    set request_macros = [] :vec[str]
    set request_builtins = [] :vec[str]
    set request_flags = [] :vec[str] mut
    set request_flags = vec::push::str(request_flags "-O3")
    set request_flags = vec::push::str(request_flags "--release")
    set request_security = use! messages::encode_security_policy("strict" request_externs request_libraries request_macros request_builtins 1 0)

    set unsupported_protocol_version = use! wire::write_varint_field(1 2)
    set invalid_version_request = use! messages::decode_compile_request(unsupported_protocol_version)
    if invalid_version_request.valid { return false }

    set invalid_load_policy = use! wire::write_varint_field(2 2)
    set invalid_load_policy_result = use! messages::decode_load_policy(invalid_load_policy)
    if invalid_load_policy_result.valid { return false }

    set invalid_source_flags = use! wire::write_varint_field(5 4294967296)
    set invalid_source_entry = use! messages::decode_source_entry(invalid_source_flags)
    if invalid_source_entry.valid { return false }

    set invalid_source_entry_bytes = use! wire::write_bytes_field(1 strings::from_byte(255))
    set malformed_nested_request = use! wire::write_varint_field(1 1) mut
    set malformed_nested_request = strings::concat(malformed_nested_request use! wire::write_bytes_field(5 invalid_source_entry_bytes))
    set malformed_result = use! messages::decode_compile_request(malformed_nested_request)
    if malformed_result.valid { return false }

    set invalid_manifest_entries = [] :vec[str] mut
    set invalid_manifest_entries = vec::push::str(invalid_manifest_entries invalid_source_entry_bytes)
    set invalid_manifest_encoded = use! messages::encode_compile_request(1 "r1" "main" request_load_policy invalid_manifest_entries request_artifacts request_security request_flags "bin" "" "cache" "out")
    if invalid_manifest_encoded != "" { return false }

    set malformed_length = use! wire::append_byte("" 10) mut
    set malformed_length = use! wire::append_byte(malformed_length 5)
    set malformed_length = use! wire::append_byte(malformed_length 65)
    set malformed_bytes = use! messages::read_bytes_field(malformed_length 1)
    set malformed_varint = use! messages::read_varint_field(malformed_length 2)
    if malformed_bytes != "" { return false }
    if malformed_varint != -1 { return false }

    set unsupported_wire_type = use! wire::append_byte("" 13)
    set unsupported_wire_type_value = use! messages::read_varint_field(unsupported_wire_type 1)
    if unsupported_wire_type_value != -1 { return false }

    set invalid_utf8 = use! wire::append_byte("" 10) mut
    set invalid_utf8 = use! wire::append_byte(invalid_utf8 1)
    set invalid_utf8 = use! wire::append_byte(invalid_utf8 255)
    set invalid_utf8_is_valid = use! wire::is_valid_utf8(strings::from_byte(255))
    set invalid_utf8_string_field = use! wire::write_string_field(1 strings::from_byte(255))
    set invalid_utf8_read = use! messages::read_string_field(invalid_utf8 1)
    if invalid_utf8_is_valid { return false }
    if invalid_utf8_string_field != "" { return false }
    if invalid_utf8_read != "" { return false }

    set invalid_response = use! wire::write_bytes_field(1 strings::from_byte(255)) mut
    set invalid_response = strings::concat(invalid_response use! wire::write_varint_field(2 1))
    set invalid_response_result = use! messages::decode_compile_response(invalid_response)
    if invalid_response_result.valid { return false }

    set response_without_status = use! wire::write_string_field(1 "r1")
    set response_without_status_result = use! messages::decode_compile_response(response_without_status)
    if response_without_status_result.valid { return false }

    set response_with_unknown_status = use! wire::write_varint_field(2 99)
    set response_with_unknown_status_result = use! messages::decode_compile_response(response_with_unknown_status)
    if response_with_unknown_status_result.valid { return false }

    set valid_utf8_result = use! wire::is_valid_utf8(strings::concat(strings::from_byte(195) strings::from_byte(169)))
    if !valid_utf8_result { return false }
    set invalid_overlong_result = use! wire::is_valid_utf8(strings::concat(strings::from_byte(192) strings::from_byte(175)))
    if invalid_overlong_result { return false }
    set invalid_surrogate_result = use! wire::is_valid_utf8(strings::concat(strings::from_byte(237) strings::concat(strings::from_byte(160) strings::from_byte(128))))
    if invalid_surrogate_result { return false }

    set invalid_warnings = [] :vec[str] mut
    set invalid_warnings = vec::push::str(invalid_warnings strings::from_byte(255))
    set response_errors = [] :vec[str]
    set invalid_warnings_encoded = use! messages::encode_compile_response("r1" 1 "out/main" response_errors invalid_warnings)
    if invalid_warnings_encoded != "" { return false }
    return true
}

@[test]
pub fn cross_decode_exchange: () :bool {
    // Optional integration gate: exchange actual raw payloads with Avenys'
    // Rust codec when the workspace verification script provides a directory.
    set exchange_directory = env::var("OWL_PROTOCOL_CROSS_DECODE_DIR")
    if exchange_directory == "" { return true }

    set request_payload = build_compile_request_payload()
    set response_payload = build_compile_response_payload()
    set rust_request_path = strings::concat(exchange_directory "/rust-compile-req.bin")
    set rust_response_path = strings::concat(exchange_directory "/rust-compile-resp.bin")
    set owl_request_path = strings::concat(exchange_directory "/owl-compile-req.bin")
    set owl_response_path = strings::concat(exchange_directory "/owl-compile-resp.bin")
    set rust_request = fs::read(rust_request_path)
    set rust_response = fs::read(rust_response_path)
    set cross_request = use! messages::decode_compile_request(rust_request)
    set cross_response = use! messages::decode_compile_response(rust_response)
    if !cross_request.valid { return false }
    if !cross_response.valid { return false }
    if cross_request.request_id != "r1" { return false }
    if cross_request.entry != "src/main.mire" { return false }
    if cross_response.output_path != "out/main" { return false }
    if vec::len(cross_response.warnings) != 1 { return false }
    if vec::get::str(cross_response.warnings 0) != "unused value" { return false }
    use! fs::write(owl_request_path request_payload)
    use! fs::write(owl_response_path response_payload)
    return true
}
