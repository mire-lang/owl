// owl syntax test: stress / performance-sensitive paths.
load kioto

fn fib: (n :i64) :i64 {
    if n <= 1 { return n }
    return fib(n - 1) + fib(n - 2)
}

@[test]
pub fn recursive_fib_stress: () :bool {
    set start = time::now::ms() :i64
    set result = fib(35)
    set elapsed = time::now::ms() - start :i64
    if result != 9227465 { return false }
    if elapsed < 0 { return false }

    set start2 = time::now::ms() :i64
    set result2 = fib(40)
    set elapsed2 = time::now::ms() - start2 :i64
    if result2 != 102334155 { return false }
    if elapsed2 < 0 { return false }
    return true
}

@[test]
pub fn large_integer_sum: () :bool {
    set sum = 0 :i64 mut
    set i = 0 :i64 mut
    while i < 100000 {
        set sum = sum + i
        set i = i + 1
    }
    if sum != 4999950000 { return false }
    return true
}

@[test]
pub fn large_string_concat: () :bool {
    set big_str = "" :str mut
    set rep = 0 :i64 mut
    while rep < 10000 {
        set big_str = big_str + "x"
        set rep = rep + 1
    }
    if strings::len(big_str) != 10000 { return false }
    return true
}

@[test]
pub fn large_list_push: () :bool {
    set lst = [] :vec[i64] mut
    set j = 0 :i64 mut
    while j < 5000 {
        set val = j :i64
        set lst = vec::push::i64(lst val)
        set j = j + 1
    }
    if vec::len(lst) != 5000 { return false }
    if vec::get::i64(lst 0) != 0 { return false }
    if vec::get::i64(lst 4999) != 4999 { return false }
    return true
}
