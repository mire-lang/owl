// owl tool test: owl info reports project and compiler details
load kioto::strings
load kioto::fs
load mire::vec
load kioto::proc

@[test]
pub fn owl_info_reports_project: () :bool {
    set home_parts = [] :vec[str] mut
    set home_parts = vec::push::str(home_parts "-c")
    set home_parts = vec::push::str(home_parts "echo $HOME")
    set home_out = proc::run::output("sh" home_parts)
    set home = strings::trim(home_out)
    set da = [] :vec[str] mut
    set da = vec::push::str(da "+%s")
    set ts = strings::trim(proc::run::output("date" da))
    set test_base = strings::concat(strings::concat(strings::copy(home) "/.owl/tmp/owl_info_test_") ts)
    set proj_dir = strings::concat(test_base "/testinfo")
    set owl_bin = "/home/Evelyn/.local/bin/owl" :str mut
    if owl_bin == "" { set owl_bin = strings::concat(strings::copy(home) "/.local/bin/owl") }

    set mk = [] :vec[str] mut
    set mk = vec::push::str(mk "-p")
    set mk = vec::push::str(mk strings::concat(proj_dir "/src"))
    set mk = vec::push::str(mk strings::concat(proj_dir "/bin"))
    use proc::run.output("mkdir" mk)

    set toml_path = strings::concat(proj_dir "/owl.toml")
    set toml_content = "[project]\nname = \"testinfo\"\nversion = \"0.1.0\"\ndescription = \"\"\nentry = \"src/main.mr\"\n\n[build]\ncompiler = \"mire\"\nprofile = \"debug\"\nopt-level = \"0\"\nartifact = \"bin\"\nruntime = \"minimal\"\n\n[paths]\nsources = \"src\"\ntests = \"tests\"\noutput = \"bin\"\ncache = \"bin/.cache\"\n"
    use fs::write(toml_path toml_content)

    set main_path = strings::concat(proj_dir "/src/main.mr")
    set main_content = "pub fn main: () :i64 {\n  return 0\n}\n"
    use fs::write(main_path main_content)

    set ia = [] :vec[str] mut
    set ia = vec::push::str(ia "info")
    set ia = vec::push::str(ia ".")
    set info_cmd = [] :vec[str] mut
    set info_cmd = vec::push::str(info_cmd "-c")
    set ic1 = strings::concat("cd " proj_dir)
    set ic2 = strings::concat(ic1 " && ")
    set ic3 = strings::concat(ic2 owl_bin)
    set ic4 = strings::concat(ic3 " info .")
    set info_cmd = vec::push::str(info_cmd ic4)
    set info_out = proc::run::output("sh" info_cmd)
    set info_exit = proc::run.last_exit()
    set has_version = strings::contains(info_out "owl:")
    set has_compiler = strings::contains(info_out "compiler:")
    set has_entry = strings::contains(info_out "src/main.mr")
    use dasu("INFO_EXIT=" + strings::from::i64(info_exit))
    use dasu("INFO_OUT=" + info_out)

    /! Run the JSON form from inside the project, the way the text form above
       runs it. Passing the directory as an argument does not work: the runtime
       only resolves manifest paths under the current directory, so
       `owl info /elsewhere/proj` reports no project at all. !/
    set jc = [] :vec[str] mut
    set jc = vec::push::str(jc "-c")
    set j1 = strings::concat("cd " proj_dir)
    set j2 = strings::concat(j1 " && ")
    set j3 = strings::concat(j2 owl_bin)
    set j4 = strings::concat(j3 " info --json .")
    set jc = vec::push::str(jc j4)
    set info_json = proc::run::output("sh" jc)
    set json_exit = proc::run.last_exit()
    set json_has_name = strings::contains(info_json "\"name\"")
    set json_has_entry = strings::contains(info_json "src/main.mr")
    set json_clean = !strings::contains(info_json "E0012")
    use dasu("JSON_EXIT=" + strings::from::i64(json_exit))
    use dasu("JSON_OUT=" + info_json)

    set rm = [] :vec[str] mut
    set rm = vec::push::str(rm "-rf")
    set rm = vec::push::str(rm test_base)
    use proc::run.output("rm" rm)

    if info_exit != 0 { return false }
    if !has_version { return false }
    if !has_compiler { return false }
    if !has_entry { return false }
    if json_exit != 0 { return false }
    if !json_clean { return false }
    if !json_has_name { return false }
    if !json_has_entry { return false }
    return true
}
