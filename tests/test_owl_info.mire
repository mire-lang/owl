// owl tool test: owl info shows project information
load kioto
load testlib

pub fn main: () {
    use dasu("--- test: owl info ---")
    testlib.assert_true(true)

    set da = [] :vec[str] mut
    set da = vec::push::str(da "+%s%N")
    set ts = strings::trim(proc::run::output("date" da))
    set test_base = strings::concat("/tmp/owl_info_test_", ts)
    set proj_dir = strings::concat(test_base, strings::copy("/testinfo"))
    set owl_bin = strings::concat(env::var("HOME"), strings::copy("/.local/bin/owl"))

    set mk = [] :vec[str] mut
    set mk = vec::push::str(mk "-p")
    set mk = vec::push::str(mk strings::copy(test_base))
    use proc::run::output("mkdir" mk)

    set na = [] :vec[str] mut
    set na = vec::push::str(na "new")
    set na = vec::push::str(na "testinfo")
    set new_out = proc::run::output_cwd(owl_bin na test_base true)
    use dasu(new_out)

    set ia = [] :vec[str] mut
    set ia = vec::push::str(ia "info")
    set info_out = proc::run::output_cwd(owl_bin ia proj_dir true)

    set has_version = strings::contains(info_out "owl:")
    set has_compiler = strings::contains(info_out "Compiler:")

    if has_version && has_compiler {
        use dasu("  owl info shows version and compiler: ok")
    } else {
        use dasu("  owl info output:")
        use dasu(info_out)
    }

    set ij = [] :vec[str] mut
    set ij = vec::push::str(ij "info")
    set ij = vec::push::str(ij "--json")
    set info_json = proc::run::output_cwd(owl_bin ij proj_dir true)

    set json_has_name = strings::contains(info_json "\"name\"")
    if json_has_name {
        use dasu("  owl info --json is valid: ok")
    } else {
        use dasu("  owl info --json:")
        use dasu(info_json)
    }

    set rm = [] :vec[str] mut
    set rm = vec::push::str(rm "-rf")
    set rm = vec::push::str(rm strings::copy(test_base))
    use proc::run::output("rm" rm)
    use dasu("test_owl_info complete")
}
