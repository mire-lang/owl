// owl tool test: owl info reports project and compiler details
load kioto

@[test]
pub fn owl_info_reports_project: () :bool {
    set da = [] :vec[str] mut
    set da = vec::push::str(da "+%s")
    set ts = strings::trim(proc::run::output("date" da))
    set test_base = strings::concat(strings::concat(env::var("HOME") "/.owl/tmp/owl_info_test_") ts)
    set proj_dir = strings::concat(test_base "/testinfo")
    set owl_bin = env::var("OWL_BIN") :str mut
    if owl_bin == "" { set owl_bin = strings::concat(env::var("HOME") "/.local/bin/owl") }

    set mk = [] :vec[str] mut
    set mk = vec::push::str(mk "-p")
    set mk = vec::push::str(mk test_base)
    use proc::run::output("mkdir" mk)

    set na = [] :vec[str] mut
    set na = vec::push::str(na "new")
    set na = vec::push::str(na "testinfo")
    use proc::run::output_cwd(owl_bin na test_base true)

    set ia = [] :vec[str] mut
    set ia = vec::push::str(ia "info")
    set info_out = proc::run::output_cwd(owl_bin ia proj_dir true)
    set has_version = strings::contains(info_out "owl:")
    set has_compiler = strings::contains(info_out "Compiler:")

    set ij = [] :vec[str] mut
    set ij = vec::push::str(ij "info")
    set ij = vec::push::str(ij "--json")
    set info_json = proc::run::output_cwd(owl_bin ij proj_dir true)
    set json_has_name = strings::contains(info_json "\"name\"")

    set rm = [] :vec[str] mut
    set rm = vec::push::str(rm "-rf")
    set rm = vec::push::str(rm test_base)
    use proc::run::output("rm" rm)

    if !has_version { return false }
    if !has_compiler { return false }
    if !json_has_name { return false }
    return true
}
