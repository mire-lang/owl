// owl tool test: owl build produces a working binary
load kioto::strings
load kioto::fs
load mire::vec
load kioto::proc

@[test]
pub fn owl_build_produces_binary: () :bool {
    set da = [] :vec[str] mut
    set da = vec::push::str(da "+%s")
    set ts = strings::trim(proc::run::output("date" da))
    set test_base = strings::concat(strings::concat(strings::copy(env::var("HOME")) "/.owl/tmp/owl_build_test_") ts)
    set proj_dir = strings::concat(test_base "/testbuild")
    set owl_bin = env::var("OWL_BIN") :str mut
    if owl_bin == "" { set owl_bin = strings::concat(strings::copy(env::var("HOME")) "/.local/bin/owl") }

    set mk = [] :vec[str] mut
    set mk = vec::push::str(mk "-p")
    set mk = vec::push::str(mk test_base)
    use proc::run::output("mkdir" mk)

    set na = [] :vec[str] mut
    set na = vec::push::str(na "new")
    set na = vec::push::str(na proj_dir)
    use proc::run.output(owl_bin na)
    set new_exit = proc::run.last_exit()
    if new_exit != 0 { return false }

    set ba = [] :vec[str] mut
    set ba = vec::push::str(ba "build")
    set ba = vec::push::str(ba proj_dir)
    set build_out = use! proc::run.output(owl_bin ba)
    set compiler_exit_code = proc::run.last_exit()
    set build_failed = strings::contains(build_out "error")

    set binary_path = strings::concat(proj_dir "/bin/debug/main")
    set test_cmd = [] :vec[str] mut
    set test_cmd = vec::push::str(test_cmd "-x")
    set test_cmd = vec::push::str(test_cmd binary_path)
    use proc::run.output("test" test_cmd)
    set binary_exists = proc::run.last_exit() == 0

    set rm = [] :vec[str] mut
    set rm = vec::push::str(rm "-rf")
    set rm = vec::push::str(rm test_base)
    use proc::run.output("rm" rm)

    if build_failed { return false }
    if compiler_exit_code != 0 { return false }
    if !binary_exists { return false }
    return true
}
