// owl tool test: owl build compiles project without errors
load kioto
load testlib

pub fn main: () {
    use dasu("--- test: owl build ---")
    testlib.assert_true(true)

    set da = [] :vec[str] mut
    set da = vec::push::str(da "+%s%N")
    set ts = strings::trim(proc::run::output("date" da))
    set test_base = strings::concat("/tmp/owl_build_test_", ts)
    set proj_dir = strings::concat(test_base, strings::copy("/testbuild"))
    set owl_bin = env::var("OWL_BIN") :str mut
    if owl_bin == "" { set owl_bin = strings::concat(env::var("HOME"), strings::copy("/.local/bin/owl")) }

    set mk = [] :vec[str] mut
    set mk = vec::push::str(mk "-p")
    set mk = vec::push::str(mk strings::copy(test_base))
    use proc::run::output("mkdir" mk)

    set na = [] :vec[str] mut
    set na = vec::push::str(na "new")
    set na = vec::push::str(na "testbuild")
    set new_out = proc::run::output_cwd(owl_bin na test_base true)
    use dasu(new_out)

    set ba = [] :vec[str] mut
    set ba = vec::push::str(ba "build")
    set build_out = proc::run::output_cwd(owl_bin ba proj_dir true)
    set compiler_exit_code = proc::run::last_exit()

    set build_failed = strings::contains(build_out "error")
    if build_failed || compiler_exit_code != 0 {
        use dasu("  owl build output contains errors:")
        use dasu(build_out)
    } else {
        use dasu("  owl build completed: ok")
    }

    set binary_args = [] :vec[str] mut
    set binary_args = vec::push::str(binary_args "-x")
    set binary_args = vec::push::str(binary_args "bin/debug/main")
    use proc::run::output_cwd("test" binary_args proj_dir true)
    set binary_exists = proc::run::last_exit() == 0 :bool mut
    if binary_exists {
        use dasu("  binary created: ok")
    } else {
        use dasu("  binary NOT created")
    }
    testlib.assert_msg(!build_failed && compiler_exit_code == 0 && binary_exists, "owl build must exit successfully and create bin/debug/main")

    set rm = [] :vec[str] mut
    set rm = vec::push::str(rm "-rf")
    set rm = vec::push::str(rm strings::copy(test_base))
    use proc::run::output("rm" rm)
    use dasu("test_owl_build complete")
}
