// Verifies the test harness runs and the kioto dependency resolves, using the
// same public toolkit the other owl tests build on.
load kioto

@[test]
pub fn toolkit_loads: () :bool {
    if strings::len("hello") != 5 { return false }
    if !strings::starts::with("hello" "he") { return false }
    if !strings::ends::with("hello" "lo") { return false }
    if strings::from::i64(42) != "42" { return false }
    return true
}
