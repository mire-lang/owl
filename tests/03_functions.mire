// owl syntax test: functions, recursion and helpers.
load kioto

fn add: (a :i64 b :i64) :i64 {
    return a + b
}

fn fib: (n :i64) :i64 {
    if n <= 1 { return n }
    return fib(n - 1) + fib(n - 2)
}

fn fact: (n :i64) :i64 {
    if n <= 1 { return 1 }
    return n * fact(n - 1)
}

fn is_even: (n :i64) :bool {
    return n % 2 == 0
}

fn gcd: (a :i64 b :i64) :i64 {
    if b == 0 { return a }
    return gcd(b a % b)
}

fn sum_range: (lo :i64 hi :i64) :i64 {
    if lo > hi { return 0 }
    set total = 0 :i64 mut
    set i = lo :i64 mut
    while i <= hi {
        set total = total + i
        set i = i + 1
    }
    return total
}

@[test]
pub fn basic_function_call: () :bool {
    if add(2 3) != 5 {
        return false
    }
    return true
}

@[test]
pub fn recursive_fibonacci: () :bool {
    if fib(10) != 55 {
        return false
    }
    return true
}

@[test]
pub fn recursive_factorial: () :bool {
    if fact(5) != 120 {
        return false
    }
    if fact(10) != 3628800 {
        return false
    }
    return true
}

@[test]
pub fn predicate_function: () :bool {
    if !is_even(42) {
        return false
    }
    if is_even(7) {
        return false
    }
    return true
}

@[test]
pub fn recursive_gcd: () :bool {
    if gcd(12 18) != 6 {
        return false
    }
    if gcd(7 13) != 1 {
        return false
    }
    if gcd(42 21) != 21 {
        return false
    }
    return true
}

@[test]
pub fn imperative_sum_range: () :bool {
    if sum_range(1 10) != 55 {
        return false
    }
    if sum_range(5 3) != 0 {
        return false
    }
    return true
}
