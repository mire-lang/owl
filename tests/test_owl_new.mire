// owl tool test: owl new creates correct project structure
load kioto
load testlib

pub fn main: () {
    use dasu("--- test: owl new ---")
    testlib.assert_true(true)

    set da = [] :vec[str] mut
    set da = vec::push::str(da "+%s%N")
    set ts = strings::trim(proc::run::output("date" da))
    set test_base = strings::concat("/tmp/owl_tool_test_", ts)
    set proj_dir = strings::concat(test_base, strings::copy("/myapp"))
    set owl_bin = strings::concat(env::var("HOME"), strings::copy("/.local/bin/owl"))

    set mk = [] :vec[str] mut
    set mk = vec::push::str(mk "-p")
    set mk = vec::push::str(mk strings::copy(test_base))
    use proc::run::output("mkdir" mk)

    set na = [] :vec[str] mut
    set na = vec::push::str(na "new")
    set na = vec::push::str(na "myapp")
    set new_out = proc::run::output_cwd(owl_bin na test_base true)
    use dasu(new_out)

    set f1 = strings::concat(proj_dir, strings::copy("/owl.toml"))
    set f2 = strings::concat(proj_dir, strings::copy("/code/main.mire"))
    set f3 = strings::concat(proj_dir, strings::copy("/tests/smoke.mire"))

    set all_exist = true :bool mut

    set c1 = "no" :str mut
    if fs::exists(f1) { set c1 = "yes" }
    if c1 != "yes" {
        set all_exist = false
        use dasu(strings::concat("  MISSING: ", f1))
    }

    set c2 = "no" :str mut
    if fs::exists(f2) { set c2 = "yes" }
    if c2 != "yes" {
        set all_exist = false
        use dasu(strings::concat("  MISSING: ", f2))
    }

    set c3 = "no" :str mut
    if fs::exists(f3) { set c3 = "yes" }
    if c3 != "yes" {
        set all_exist = false
        use dasu(strings::concat("  MISSING: ", f3))
    }

    set c4 = "no" :str mut
    if fs::exists(strings::concat(proj_dir, strings::copy("/code"))) { set c4 = "yes" }
    if c4 != "yes" {
        set all_exist = false
        use dasu(strings::concat("  MISSING dir: ", strings::concat(proj_dir, strings::copy("/code"))))
    }

    if all_exist {
        use dasu("  owl new creates correct structure: ok")
    } else {
        use dasu("  owl new structure: FAIL")
    }

    set rm = [] :vec[str] mut
    set rm = vec::push::str(rm "-rf")
    set rm = vec::push::str(rm strings::copy(test_base))
    use proc::run::output("rm" rm)
    use dasu("test_owl_new complete")
}
