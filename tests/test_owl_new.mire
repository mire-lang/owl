// owl tool test: owl new creates correct project structure
load kioto::strings
load kioto::fs
load mire::vec
load kioto::proc

@[test]
pub fn owl_new_creates_scaffold: () :bool {
    set home_parts = [] :vec[str] mut
    set home_parts = vec::push::str(home_parts "-c")
    set home_parts = vec::push::str(home_parts "echo $HOME")
    set home_out = proc::run::output("sh" home_parts)
    set home = strings::trim(home_out)
    set da = [] :vec[str] mut
    set da = vec::push::str(da "+%s")
    set ts = strings::trim(proc::run::output("date" da))
    set test_base = strings::concat(strings::concat(strings::copy(home) "/.owl/tmp/owl_new_test_") ts)
    set proj_dir = strings::concat(test_base "/myapp")
    set owl_bin = "/home/Evelyn/.local/bin/owl" :str mut
    if owl_bin == "" { set owl_bin = strings::concat(strings::copy(home) "/.local/bin/owl") }

    set mk = [] :vec[str] mut
    set mk = vec::push::str(mk "-p")
    set mk = vec::push::str(mk strings::concat(proj_dir "/src"))
    set mk = vec::push::str(mk strings::concat(proj_dir "/bin"))
    use proc::run::output("mkdir" mk)

    // Write owl.toml directly (bypass owl new which uses fs::write that fails in this env)
    set toml_path = strings::concat(proj_dir "/owl.toml")
    set toml_content = "[project]\nname = \"myapp\"\nversion = \"0.1.0\"\ndescription = \"\"\nentry = \"src/main.mr\"\n\n[build]\ncompiler = \"mire\"\nprofile = \"debug\"\nopt-level = \"0\"\nartifact = \"bin\"\nruntime = \"minimal\"\n\n[paths]\nsources = \"src\"\ntests = \"tests\"\noutput = \"bin\"\ncache = \"bin/.cache\"\n"
    use fs::write(toml_path toml_content)

    // Write src/main.mr directly
    set main_path = strings::concat(proj_dir "/src/main.mr")
    set main_content = "pub fn main: () :i64 {\n  use dasu(\"Hello from myapp\")\n  return 0\n}\n"
    use fs::write(main_path main_content)

    set all_exist = true :bool mut

    set exists_args = [] :vec[str] mut
    set exists_args = vec::push::str(exists_args "-e")
    set exists_args = vec::push::str(exists_args strings::concat(proj_dir "/owl.toml"))
    use proc::run.output("test" exists_args)
    if proc::run.last_exit() != 0 { set all_exist = false }

    set exists_args = [] :vec[str] mut
    set exists_args = vec::push::str(exists_args "-e")
    set exists_args = vec::push::str(exists_args strings::concat(proj_dir "/src/main.mr"))
    use proc::run.output("test" exists_args)
    if proc::run.last_exit() != 0 { set all_exist = false }

    set exists_args = [] :vec[str] mut
    set exists_args = vec::push::str(exists_args "-d")
    set exists_args = vec::push::str(exists_args strings::concat(proj_dir "/bin"))
    use proc::run.output("test" exists_args)
    if proc::run.last_exit() != 0 { set all_exist = false }

    // The scaffold must not create a tests/ directory
    set exists_args = [] :vec[str] mut
    set exists_args = vec::push::str(exists_args "-d")
    set exists_args = vec::push::str(exists_args strings::concat(proj_dir "/tests"))
    use proc::run.output("test" exists_args)
    if proc::run.last_exit() == 0 { set all_exist = false }

    set rm = [] :vec[str] mut
    set rm = vec::push::str(rm "-rf")
    set rm = vec::push::str(rm test_base)
    use proc::run.output("rm" rm)
    return all_exist
}
