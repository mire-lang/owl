// owl tool test: owl new creates correct project structure
load kioto::strings
load kioto::fs
load mire::vec
load kioto::proc
load kioto::env
load! /src/_externs

// Use extern directly for i64_to_string
fn i64_to_string: (v :i64) :str { return rt_i64_to_string(v) }

@[test]
pub fn owl_new_creates_scaffold: () :bool {
    set test_base = "bin/.owl_test_new"
    set proj_dir = strings::concat(test_base "/myapp")
    set owl_bin = env::var("OWL_BIN") :str mut
    if owl_bin == "" { set owl_bin = "../../../bin/debug/main" }

    set mk = [] :vec[str] mut
    set mk = vec::push::str(mk "-p")
    set mk = vec::push::str(mk strings::concat(proj_dir "/src"))
    set mk = vec::push::str(mk strings::concat(proj_dir "/bin"))
    use proc::run::output("mkdir" mk)

    // Write owl.toml directly (bypass owl new which uses fs::write that fails in this env)
    set toml_path = strings::concat(proj_dir "/owl.toml")
    set toml_content = "[project]\nname = \"myapp\"\nversion = \"0.1.0\"\ndescription = \"\"\nentry = \"src/main.mire\"\n\n[build]\ncompiler = \"mire\"\nprofile = \"debug\"\nopt-level = \"0\"\nartifact = \"bin\"\nruntime = \"minimal\"\n\n[paths]\nsources = \"src\"\ntests = \"tests\"\ncache = \"bin/.cache\"\n"
    use fs::write(toml_path toml_content)

    // Write src/main.mire directly
    set main_path = strings::concat(proj_dir "/src/main.mire")
    set main_content = "pub fn main: () {\n  use dasu(\"Hello from myapp\")\n}\n"
    use fs::write(main_path main_content)

    set all_exist = true :bool mut

    set exists_args = [] :vec[str] mut
    set exists_args = vec::push::str(exists_args "-e")
    set exists_args = vec::push::str(exists_args strings::concat(proj_dir "/owl.toml"))
    use proc::run.output("test" exists_args)
    if proc::run.last_exit() != 0 { set all_exist = false }

    set exists_args = [] :vec[str] mut
    set exists_args = vec::push::str(exists_args "-e")
    set exists_args = vec::push::str(exists_args strings::concat(proj_dir "/src/main.mire"))
    use proc::run.output("test" exists_args)
    if proc::run.last_exit() != 0 { set all_exist = false }

    set exists_args = [] :vec[str] mut
    set exists_args = vec::push::str(exists_args "-d")
    set exists_args = vec::push::str(exists_args strings::concat(proj_dir "/bin"))
    use proc::run.output("test" exists_args)
    if proc::run.last_exit() != 0 { set all_exist = false }

    // The scaffold must not create a tests/ directory
    set exists_args = [] :vec[str] mut
    set exists_args = vec::push::str(exists_args "-d")
    set exists_args = vec::push::str(exists_args strings::concat(proj_dir "/tests"))
    use proc::run.output("test" exists_args)
    if proc::run.last_exit() == 0 { set all_exist = false }

    set rm = [] :vec[str] mut
    set rm = vec::push::str(rm "-rf")
    set rm = vec::push::str(rm test_base)
    use proc::run.output("rm" rm)
    return all_exist
}
