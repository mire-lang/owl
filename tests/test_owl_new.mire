// owl tool test: owl new creates correct project structure
load kioto

@[test]
pub fn owl_new_creates_scaffold: () :bool {
    set da = [] :vec[str] mut
    set da = vec::push::str(da "+%s")
    set ts = strings::trim(proc::run::output("date" da))
    set test_base = strings::concat(strings::concat(env::var("HOME") "/.owl/tmp/owl_tool_test_") ts)
    set owl_bin = env::var("OWL_BIN") :str mut
    if owl_bin == "" { set owl_bin = strings::concat(env::var("HOME") "/.local/bin/owl") }

    set mk = [] :vec[str] mut
    set mk = vec::push::str(mk "-p")
    set mk = vec::push::str(mk test_base)
    use proc::run::output("mkdir" mk)

    set na = [] :vec[str] mut
    set na = vec::push::str(na "new")
    set na = vec::push::str(na "myapp")
    use proc::run::output_cwd(owl_bin na test_base true)

    set all_exist = true :bool mut

    set exists_args = [] :vec[str] mut
    set exists_args = vec::push::str(exists_args "-e")
    set exists_args = vec::push::str(exists_args "myapp/owl.toml")
    use proc::run::output_cwd("test" exists_args test_base true)
    if proc::run::last_exit() != 0 { set all_exist = false }

    set exists_args = [] :vec[str] mut
    set exists_args = vec::push::str(exists_args "-e")
    set exists_args = vec::push::str(exists_args "myapp/src/main.mr")
    use proc::run::output_cwd("test" exists_args test_base true)
    if proc::run::last_exit() != 0 { set all_exist = false }

    set exists_args = [] :vec[str] mut
    set exists_args = vec::push::str(exists_args "-d")
    set exists_args = vec::push::str(exists_args "myapp/bin")
    use proc::run::output_cwd("test" exists_args test_base true)
    if proc::run::last_exit() != 0 { set all_exist = false }

    /! The scaffold must not create a tests/ directory. !/
    set exists_args = [] :vec[str] mut
    set exists_args = vec::push::str(exists_args "-d")
    set exists_args = vec::push::str(exists_args "myapp/tests")
    use proc::run::output_cwd("test" exists_args test_base true)
    if proc::run::last_exit() == 0 { set all_exist = false }

    set rm = [] :vec[str] mut
    set rm = vec::push::str(rm "-rf")
    set rm = vec::push::str(rm test_base)
    use proc::run::output("rm" rm)
    return all_exist
}
