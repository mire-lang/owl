// owl syntax test: string operations from the kioto public library.
load kioto

@[test]
pub fn string_literals_and_concat: () :bool {
    set s = "hello" :str
    if s != "hello" { return false }
    set s2 = "hello" + " world" :str
    if s2 != "hello world" { return false }
    return true
}

@[test]
pub fn strings_len_and_empty: () :bool {
    if strings::len("hello") != 5 { return false }
    if strings::len("") != 0 { return false }
    if !(strings::len("") == 0) { return false }
    if strings::len("x") == 0 { return false }
    return true
}

@[test]
pub fn strings_case_and_trim: () :bool {
    if strings::upper("hello") != "HELLO" { return false }
    if strings::lower("HELLO") != "hello" { return false }
    if strings::trim("  hello  ") != "hello" { return false }
    return true
}

@[test]
pub fn strings_contains_and_affixes: () :bool {
    if !strings::contains("hello world" "world") { return false }
    if strings::contains("hello world" "xyz") { return false }
    if !strings::starts::with("hello" "he") { return false }
    if strings::starts::with("hello" "el") { return false }
    if !strings::ends::with("hello" "lo") { return false }
    return true
}

@[test]
pub fn strings_substr: () :bool {
    if strings::substr("hello" 0 2) != "he" { return false }
    if strings::substr("hello" 1 3) != "ell" { return false }
    if strings::substr("hello" 4 1) != "o" { return false }
    return true
}

@[test]
pub fn strings_split_and_join: () :bool {
    set parts = strings::split("a,b,c" ",")
    if vec::len(parts) != 3 { return false }
    if vec::get::str(parts 0) != "a" { return false }
    if vec::get::str(parts 1) != "b" { return false }
    if vec::get::str(parts 2) != "c" { return false }
    if strings::join(parts ",") != "a,b,c" { return false }
    return true
}

@[test]
pub fn strings_replace_and_repeat: () :bool {
    if strings::replace::all("hello?" "?" "!") != "hello!" { return false }
    if strings::repeat("ab" 2) != "abab" { return false }
    if strings::repeat("x" 0) != "" { return false }
    return true
}

@[test]
pub fn strings_index: () :bool {
    if strings::index("hello" "l") != 2 { return false }
    if strings::index("hello" "z") != -1 { return false }
    return true
}

@[test]
pub fn strings_from_i64: () :bool {
    if strings::from::i64(42) != "42" { return false }
    if strings::from::i64(-5) != "-5" { return false }
    if strings::from::i64(0) != "0" { return false }
    return true
}

@[test]
pub fn empty_string_handling: () :bool {
    set empty = "" :str
    if empty + "" != "" { return false }
    if "" + "a" != "a" { return false }
    return true
}

@[test]
pub fn large_string: () :bool {
    set long = strings::repeat("x" 1000)
    if strings::len(long) != 1000 { return false }
    return true
}
